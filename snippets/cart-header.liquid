{% comment %}
  VANHOUTEN LIVING — Cart Drawer Header V1.9
{% endcomment %}

<div class="drawer__header vhl-cart-header">
  <div class="vhl-cart-header__identity">
    <h2 class="drawer__heading">Winkelmand</h2>
    <span class="gb-cart-total-item" aria-label="{{ cart.item_count }} artikelen">
      {{ cart.item_count }}
    </span>
  </div>

  <nav class="vhl-cart-header__actions" aria-label="Winkelmand navigatie">
    <a
      class="vhl-cart-header__action"
      href="{{ routes.cart_url }}"
      aria-label="Bekijk winkelwagenoverzicht"
      title="Winkelwagenoverzicht"
    >
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M6.5 8h11l-.8 11H7.3L6.5 8Z"/>
        <path d="M9 8V6a3 3 0 0 1 6 0v2"/>
      </svg>
    </a>

    <a
      class="vhl-cart-header__action"
      href="/pages/favorieten"
      aria-label="Ga naar favorieten"
      title="Favorieten"
    >
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M20.8 4.8a5.3 5.3 0 0 0-7.5 0L12 6.1l-1.3-1.3a5.3 5.3 0 0 0-7.5 7.5L12 21l8.8-8.7a5.3 5.3 0 0 0 0-7.5Z"/>
      </svg>
    </a>

    <button
      class="drawer__close vhl-cart-header__action"
      type="button"
      onclick="this.closest('cart-drawer').close()"
      aria-label="Winkelmand sluiten"
      title="Sluiten"
    >
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M6 6l12 12M18 6 6 18"/>
      </svg>
    </button>
  </nav>
</div>

<style>
  .cart-drawer .vhl-cart-header {
    min-height: 68px;
    width: 100%;
    padding: 0 16px !important;
    margin: 0 !important;
    display: flex !important;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    border-bottom: 1px solid #e8e3dc;
    background: #fbfaf8 !important;
    box-sizing: border-box;
  }

  .cart-drawer .vhl-cart-header__identity {
    min-width: 0;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .cart-drawer .vhl-cart-header .drawer__heading {
    margin: 0 !important;
    padding: 0 !important;
    color: #292824 !important;
    font-family: var(--font-heading-family, inherit);
    font-size: 21px !important;
    line-height: 1 !important;
    font-weight: 600 !important;
    letter-spacing: -0.025em !important;
    text-transform: none !important;
  }

  .cart-drawer .vhl-cart-header .gb-cart-total-item {
    width: 24px;
    height: 24px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    background: #eeeae3;
    color: #595650;
    font-size: 10px !important;
    line-height: 1 !important;
    font-weight: 700 !important;
  }

  .cart-drawer .vhl-cart-header__actions {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .cart-drawer .vhl-cart-header__action,
  .cart-drawer .vhl-cart-header .drawer__close.vhl-cart-header__action {
    position: static !important;
    width: 36px !important;
    height: 36px !important;
    min-width: 36px !important;
    min-height: 36px !important;
    margin: 0 !important;
    padding: 0 !important;
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    border: 1px solid #ded9d1 !important;
    border-radius: 999px !important;
    background: #fff !important;
    color: #292824 !important;
    text-decoration: none !important;
    box-shadow: none !important;
    cursor: pointer;
  }

  .cart-drawer .vhl-cart-header__action svg {
    width: 17px !important;
    height: 17px !important;
    fill: none !important;
    stroke: currentColor !important;
    stroke-width: 1.6 !important;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .cart-drawer .vhl-cart-header__action:hover {
    background: #f2eee8 !important;
    border-color: #cfc8be !important;
  }

  .cart-drawer .vhl-cart-header__action:focus-visible {
    outline: 2px solid #292824 !important;
    outline-offset: 2px !important;
  }

  @media screen and (max-width: 390px) {
    .cart-drawer .vhl-cart-header {
      padding: 0 12px !important;
    }

    .cart-drawer .vhl-cart-header .drawer__heading {
      font-size: 19px !important;
    }

    .cart-drawer .vhl-cart-header__action,
    .cart-drawer .vhl-cart-header .drawer__close.vhl-cart-header__action {
      width: 34px !important;
      height: 34px !important;
      min-width: 34px !important;
      min-height: 34px !important;
    }
  }
</style>
