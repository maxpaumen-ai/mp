{% comment %}
  VANHOUTEN LIVING — vaste betaaliconen voor Cart Drawer V1.9
  Wero · Mastercard · Visa · Apple Pay
{% endcomment %}

<div class="vhl-payment-methods" aria-label="Beschikbare betaalmethoden">
  <div class="vhl-payment-method" aria-label="Wero">
    <span class="vhl-payment-wero">Wero</span>
  </div>

  <div class="vhl-payment-method" aria-label="Mastercard">
    <svg viewBox="0 0 44 28" role="img" aria-hidden="true">
      <circle cx="17" cy="14" r="8.5" fill="#EB001B"></circle>
      <circle cx="27" cy="14" r="8.5" fill="#F79E1B"></circle>
      <path d="M22 7.2a8.5 8.5 0 0 1 0 13.6 8.5 8.5 0 0 1 0-13.6Z" fill="#FF5F00"></path>
    </svg>
  </div>

  <div class="vhl-payment-method" aria-label="Visa">
    <span class="vhl-payment-visa">VISA</span>
  </div>

  <div class="vhl-payment-method" aria-label="Apple Pay">
    <span class="vhl-payment-apple">Pay</span>
  </div>
</div>

<style>
  .cart-drawer .vhl-payment-methods {
    width: 100%;
    margin-top: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 7px;
  }

  .cart-drawer .vhl-payment-method {
    width: 48px;
    height: 29px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid #e0dbd4;
    border-radius: 5px;
    background: #fff;
    color: #1f1f1f;
    overflow: hidden;
  }

  .cart-drawer .vhl-payment-method svg {
    width: 40px;
    height: 25px;
  }

  .cart-drawer .vhl-payment-wero {
    font-size: 13px;
    font-weight: 700;
    letter-spacing: -0.04em;
  }

  .cart-drawer .vhl-payment-visa {
    font-family: Arial, sans-serif;
    font-size: 13px;
    font-style: italic;
    font-weight: 800;
    letter-spacing: -0.07em;
  }

  .cart-drawer .vhl-payment-apple {
    font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", Arial, sans-serif;
    font-size: 14px;
    font-weight: 600;
    letter-spacing: -0.06em;
  }
</style>
