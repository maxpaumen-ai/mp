{% comment %}
  VANHOUTEN LIVING — Reserverings-inforegel V1.0
  Klein, statisch informatieblok direct onder de shipping-progress.
  Puur presentationeel: geen cart-data, geen JS, geen formulier.
{% endcomment %}

{%- if cart != empty -%}
  <div class="vhl-reservation-notice">
    <span class="vhl-reservation-notice__icon" aria-hidden="true">
      {{- 'icon-info.svg' | inline_asset_content -}}
    </span>
    <span class="vhl-reservation-notice__text">
      Artikelen in je winkelmand zijn niet gereserveerd. Reken snel af om misgrijpen te voorkomen.
    </span>
  </div>
{%- endif -%}
