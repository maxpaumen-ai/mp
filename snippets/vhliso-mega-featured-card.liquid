{% comment %}
  VANHOUTEN LIVING — mega-menu featured collectiekaart.

  Losse snippet i.p.v. inline herhaald in sections/header.liquid,
  puur omdat Liquid geen inline array-literal ondersteunt om meerdere
  kaarten in één for-loop te renderen (`{% for x in (a, b) %}` is
  geen geldige Liquid-syntax) — dit wordt in plaats daarvan meerdere
  keren gerenderd vanuit snippets/vhliso-mega-trigger.liquid.

  Accepteert:
    collection    - het Collection-object (block.settings.collection).
                    Vereist: zonder collection wordt niets gerenderd
                    (er is dan geen geldige URL om naartoe te linken).
    custom_image  - optioneel Image-object (block.settings.image) dat
                    collection.image overschrijft wanneer ingesteld.
    custom_title  - optionele tekst (block.settings.title) die
                    collection.title overschrijft wanneer ingesteld.
{% endcomment %}

{% if collection %}
  {%- liquid
    assign vhliso_card_title = custom_title | default: collection.title
  -%}
  <a href="{{ collection.url }}" class="vhliso-mega-card">
    <span class="vhliso-mega-card-image">
      {% if custom_image %}
        {{
          custom_image
          | image_url: width: 700
          | image_tag:
            loading: 'lazy',
            widths: '350,500,700',
            alt: vhliso_card_title
        }}
      {% elsif collection.image %}
        {{
          collection.image
          | image_url: width: 700
          | image_tag:
            loading: 'lazy',
            widths: '350,500,700',
            alt: vhliso_card_title
        }}
      {% endif %}
    </span>
    <span class="vhliso-mega-card-name">
      {{ vhliso_card_title | escape }}
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="5" y1="12" x2="19" y2="12"></line>
        <polyline points="12 5 19 12 12 19"></polyline>
      </svg>
    </span>
  </a>
{% endif %}
