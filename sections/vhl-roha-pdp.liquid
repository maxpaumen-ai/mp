<script>
(() => {
  const root = document.getElementById('{{ root_id }}');
  if (!root) return;
  const modal = root.querySelector('[data-vhl-payment-modal]');
  const opener = root.querySelector('[data-vhl-payment-open]');
  if (!modal || !opener) return;
  const close = () => { modal.hidden = true; root.classList.remove('vhl-payment-modal-open'); document.documentElement.style.overflow = ''; };
  opener.addEventListener('click', () => { modal.hidden = false; root.classList.add('vhl-payment-modal-open'); document.documentElement.style.overflow = 'hidden'; });
  root.querySelectorAll('[data-vhl-payment-close]').forEach(el => el.addEventListener('click', close));
  document.addEventListener('keydown', e => { if (e.key === 'Escape' && !modal.hidden) close(); });
})();
</script>


<script>
(() => {
  const root = document.getElementById('{{ root_id }}');
  if (!root) return;
  const mainAtc = root.querySelector('[data-vhl-roha-atc]');
  const sticky = root.querySelector('[data-vhl-sticky]');
  const stickyAdd = root.querySelector('[data-vhl-sticky-add]');
  if (!mainAtc || !sticky || !stickyAdd) return;

  const syncSticky = () => {
    const rect = mainAtc.getBoundingClientRect();
    const mainVisible = rect.bottom > 0 && rect.top < window.innerHeight;
    sticky.hidden = mainVisible || window.scrollY < 250;
  };

  stickyAdd.addEventListener('click', () => {
    if (!mainAtc.disabled) mainAtc.click();
  });

  syncSticky();
  window.addEventListener('scroll', syncSticky, { passive: true });
  window.addEventListener('resize', syncSticky);
})();
</script>

