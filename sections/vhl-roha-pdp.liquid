{%- comment -%}
  VHL ROHA-style PDP — above-the-fold, rebuilt as a single 3-zone
  composition (thumbnail rail / main media / purchase panel) matching
  the ROHA reference's measured proportions. Alleen gebruikt door
  templates/product.vacuum-hook.json.

  Architectuur (één bron van waarheid, geen losse override-lagen):
  - GEEN snippets/product-info.liquid, GEEN shop-product-layout/-details
    opmaak, GEEN CSS order-hacks. Alle DOM-volgorde is de echte
    visuele volgorde.
  - Desktop: .vhl-roha-pdp__row is ÉÉN flex-rij met drie directe
    kinderen (thumbs / media / panel), percentagegebaseerd zodat de
    ROHA-verhoudingen (±4.5% / 49% / 37.5%, gaps ±3% / 6%) op elke
    desktopbreedte behouden blijven — geen vaste px-breedtes voor de
    hoofdafbeelding, geen max-height-truc.
  - Varianten: ALLEEN echte Shopify option-value swatches
    (value.swatch.color / .image) worden als ronde swatches getoond,
    en alleen wanneer ALLE waarden van die optie swatch-data hebben
    (anders is de UI inconsistent — deels rond, deels niet). Zonder
    volledige swatch-dekking: een compacte, functionele <select> i.p.v.
    twaalf dominante tekstpills. Geen AliExpress-string-parser, geen
    kleur-uit-tekst-gokken.
  - Quantity: blijft volledig functioneel, maar bewust NIET tussen de
    swatches en de ATC-knop. De ATC-knop gebruikt altijd de huidige
    waarde van het aantal-veld (standaard 1); een kleine, ondergeschikte
    stepper staat direct ná de ATC-knop, buiten de primaire
    rating->titel->prijs->USP's->variant->ATC-ritmiek.
  - Hergebruikt, klein en aantoonbaar veilig (geen eigen layout):
    snippets/loading-spinner.liquid, het bestaande <product-form>
    custom element (assets/product-form.js), window.Elixir_FormatMoney
    (assets/theme-loaders.js), shop.enabled_payment_types.

  Sticky ATC blijft bewust buiten deze rebuild (zie eerdere PR's) —
  sections/vhl-vacuum-sticky-atc.liquid is niet aangeraakt en niet in
  dit template opgenomen.
{%- endcomment -%}

{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign display_image = current_variant.featured_image | default: product.featured_media
  assign active_media_id = display_image.id

  assign has_rating = false
  if product.metafields.reviews.rating.value != blank
    assign has_rating = true
    assign rating_decimal = 0
    assign rating_fraction = product.metafields.reviews.rating.value.rating | modulo: 1
    if rating_fraction >= 0.3 and rating_fraction <= 0.7
      assign rating_decimal = 0.5
    elsif rating_fraction > 0.7
      assign rating_decimal = 1
    endif
  endif

  assign has_usps = false
  if section.settings.usp_1 != blank or section.settings.usp_2 != blank or section.settings.usp_3 != blank
    assign has_usps = true
  endif

  assign has_shipping_info = false
  if shop.policies.shipping_policy.body != blank or shop.policies.refund_policy.body != blank
    assign has_shipping_info = true
  endif

  assign has_trust_block = false
  if section.settings.trust_heading != blank or section.settings.trust_body != blank or section.settings.trust_warning != blank
    assign has_trust_block = true
  endif

  assign media_count = 0
  for media in product.media
    if media.media_type == 'image'
      assign media_count = media_count | plus: 1
    endif
  endfor

  assign root_id = 'VHLRohaPdp-' | append: section.id
-%}

{{ 'component-rating.css' | asset_url | stylesheet_tag }}

<section id="{{ root_id }}" class="vhl-roha-pdp" {{ section.shopify_attributes }}>
  <div class="vhl-roha-pdp__container">
    <div class="vhl-roha-pdp__row">

      {%- if media_count > 1 -%}
        <div class="vhl-roha-pdp__thumbs" data-vhl-roha-thumbs>
          {%- for media in product.media -%}
            {%- if media.media_type == 'image' -%}
              {%- assign is_active_thumb = false -%}
              {%- if active_media_id != blank and media.id == active_media_id -%}
                {%- assign is_active_thumb = true -%}
              {%- elsif active_media_id == blank and forloop.first -%}
                {%- assign is_active_thumb = true -%}
              {%- endif -%}
              <button
                type="button"
                class="vhl-roha-pdp__thumb{% if is_active_thumb %} is-active{% endif %}"
                data-vhl-roha-thumb
                data-full-src="{{ media | image_url: width: 1600 }}"
                data-alt="{{ media.alt | default: product.title | escape }}"
                aria-label="{{ product.title | escape }} — afbeelding {{ forloop.index }}"
              >
                <img src="{{ media | image_url: width: 160 }}" alt="" loading="lazy" width="64" height="64">
              </button>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}

      <div class="vhl-roha-pdp__media">
        <img
          data-vhl-roha-main-image
          src="{{ display_image | image_url: width: 1600 }}"
          alt="{{ display_image.alt | default: product.title | escape }}"
          width="1200"
          height="1200"
          loading="eager"
        >
      </div>

      <div class="vhl-roha-pdp__panel">

        {%- if has_rating -%}
          <div
            class="vhl-roha-pdp__rating"
            role="img"
            aria-label="{{ 'accessibility.star_reviews_info' | t: rating_value: product.metafields.reviews.rating.value, rating_max: product.metafields.reviews.rating.value.scale_max }}"
          >
            <span
              aria-hidden="true"
              class="rating-star"
              style="--rating: {{ product.metafields.reviews.rating.value.rating | floor }}; --rating-max: {{ product.metafields.reviews.rating.value.scale_max }}; --rating-decimal: {{ rating_decimal }};"
            ></span>
            <span class="vhl-roha-pdp__rating-text">
              {{- product.metafields.reviews.rating.value }} / {{ product.metafields.reviews.rating.value.scale_max -}}
              {% if product.metafields.reviews.rating_count %}
                &middot; <strong>{{ product.metafields.reviews.rating_count }} beoordelingen</strong>
              {% endif %}
            </span>
          </div>
        {%- endif -%}

        <h1 class="vhl-roha-pdp__title">{{ product.title }}</h1>

        <div class="vhl-roha-pdp__price">
          {%- if current_variant.compare_at_price > current_variant.price -%}
            <span class="vhl-roha-pdp__price-compare" data-vhl-roha-price-compare>{{ current_variant.compare_at_price | money }}</span>
          {%- else -%}
            <span class="vhl-roha-pdp__price-compare" data-vhl-roha-price-compare hidden></span>
          {%- endif -%}
          <span class="vhl-roha-pdp__price-current" data-vhl-roha-price-current>{{ current_variant.price | money }}</span>
        </div>

        {%- if has_usps -%}
          <ul class="vhl-roha-pdp__usps">
            {%- if section.settings.usp_1 != blank -%}
              <li>
                <svg class="vhl-roha-pdp__usp-icon" viewBox="0 0 20 20" aria-hidden="true"><circle cx="10" cy="10" r="10" fill="#1a1a1a"></circle><path d="M6 10.3l2.6 2.6L14 7.3" fill="none" stroke="#ffffff" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path></svg>
                <span>{{ section.settings.usp_1 }}</span>
              </li>
            {%- endif -%}
            {%- if section.settings.usp_2 != blank -%}
              <li>
                <svg class="vhl-roha-pdp__usp-icon" viewBox="0 0 20 20" aria-hidden="true"><circle cx="10" cy="10" r="10" fill="#1a1a1a"></circle><path d="M6 10.3l2.6 2.6L14 7.3" fill="none" stroke="#ffffff" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path></svg>
                <span>{{ section.settings.usp_2 }}</span>
              </li>
            {%- endif -%}
            {%- if section.settings.usp_3 != blank -%}
              <li>
                <svg class="vhl-roha-pdp__usp-icon" viewBox="0 0 20 20" aria-hidden="true"><circle cx="10" cy="10" r="10" fill="#1a1a1a"></circle><path d="M6 10.3l2.6 2.6L14 7.3" fill="none" stroke="#ffffff" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path></svg>
                <span>{{ section.settings.usp_3 }}</span>
              </li>
            {%- endif -%}
          </ul>
        {%- endif -%}

        <product-form class="vhl-roha-pdp__form-wrapper">
          {%- form 'product', product, data-type: 'add-to-cart-form', class: 'vhl-roha-pdp__form' -%}

            <input
              type="hidden"
              name="id"
              value="{{ current_variant.id }}"
              data-vhl-roha-variant-id
              disabled
            >

            {%- unless product.has_only_default_variant -%}
              {%- for option in product.options_with_values -%}
                {%- liquid
                  assign current_option_value = ''
                  case option.position
                    when 1
                      assign current_option_value = current_variant.option1
                    when 2
                      assign current_option_value = current_variant.option2
                    when 3
                      assign current_option_value = current_variant.option3
                  endcase

                  assign swatch_covered = 0
                  for value in option.values
                    if value.swatch.color or value.swatch.image
                      assign swatch_covered = swatch_covered | plus: 1
                    endif
                  endfor
                  assign use_swatches = false
                  if swatch_covered > 0 and swatch_covered == option.values.size
                    assign use_swatches = true
                  endif
                -%}
                {%- comment -%}
                  Een optie met precies 1 mogelijke waarde biedt de klant
                  geen echte keuze (elke variant deelt toch dezelfde
                  waarde) — dan geen kiezer-blok tonen. Puur UI, geen
                  productdata gewijzigd of verborgen.
                {%- endcomment -%}
                {%- if option.values.size > 1 -%}
                  <div class="vhl-roha-pdp__option" data-vhl-roha-option data-option-position="{{ option.position }}">
                    <div class="vhl-roha-pdp__option-heading">
                      <span class="vhl-roha-pdp__option-name">{{ option.name }}:</span>
                      <span class="vhl-roha-pdp__option-selected" data-vhl-roha-option-selected>{{ current_option_value }}</span>
                    </div>

                    {%- if use_swatches -%}
                      <div class="vhl-roha-pdp__swatches">
                        {%- for value in option.values -%}
                          {%- assign is_selected = false -%}
                          {%- if value == current_option_value -%}{%- assign is_selected = true -%}{%- endif -%}
                          <button
                            type="button"
                            class="vhl-roha-pdp__swatch"
                            data-vhl-roha-option-value
                            data-value="{{ value | escape }}"
                            data-selected="{{ is_selected }}"
                            aria-pressed="{{ is_selected }}"
                            aria-label="{{ value | escape }}"
                            title="{{ value | escape }}"
                            {%- if value.swatch.color %}
                              style="background-color: {{ value.swatch.color }};"
                            {%- elsif value.swatch.image %}
                              style="background-image: url({{ value.swatch.image | image_url: width: 80 }});"
                            {%- endif %}
                          ></button>
                        {%- endfor -%}
                      </div>
                    {%- else -%}
                      {%- comment -%}
                        Geen (volledige) native swatch-data voor deze optie.
                        Geen tekstpills die de compositie domineren en geen
                        kleur-uit-tekst-parser: een compacte, functionele
                        select. Zodra alle waarden een echte Shopify
                        option-value swatch hebben, schakelt bovenstaande
                        voorwaarde automatisch over naar ronde swatches.
                      {%- endcomment -%}
                      <select
                        class="vhl-roha-pdp__select"
                        data-vhl-roha-option-select
                        aria-label="{{ option.name | escape }}"
                      >
                        {%- for value in option.values -%}
                          <option value="{{ value | escape }}" {% if value == current_option_value %}selected{% endif %}>{{ value }}</option>
                        {%- endfor -%}
                      </select>
                    {%- endif -%}
                  </div>
                {%- endif -%}
              {%- endfor -%}
            {%- endunless -%}

            <button
              type="submit"
              name="add"
              class="vhl-roha-pdp__atc"
              data-vhl-roha-atc
              {% unless current_variant.available %}disabled aria-disabled="true"{% endunless %}
            >
              <svg class="vhl-roha-pdp__atc-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M3 4h2l1.6 9.6a2 2 0 0 0 2 1.7h7.6a2 2 0 0 0 2-1.6L19.5 8H6.2" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
                <circle cx="9.5" cy="19.5" r="1.4" fill="currentColor"></circle>
                <circle cx="17" cy="19.5" r="1.4" fill="currentColor"></circle>
              </svg>
              <span class="button-text">
                {%- if current_variant.available -%}
                  In winkelwagen <span class="vhl-roha-pdp__atc-sep">&bull;</span> <span data-vhl-roha-atc-price>{{ current_variant.price | money }}</span>
                {%- else -%}
                  Uitverkocht
                {%- endif -%}
              </span>
              {% render 'loading-spinner' %}
            </button>

            <div class="vhl-roha-pdp__qty-inline">
              <span class="vhl-roha-pdp__qty-inline-label">Aantal</span>
              <button type="button" class="vhl-roha-pdp__qty-inline-btn" data-vhl-roha-qty-decrease aria-label="Verlaag aantal">&minus;</button>
              <input
                type="number"
                class="vhl-roha-pdp__qty-inline-input"
                name="quantity"
                value="1"
                min="1"
                inputmode="numeric"
                data-vhl-roha-qty-input
                aria-label="Aantal"
              >
              <button type="button" class="vhl-roha-pdp__qty-inline-btn" data-vhl-roha-qty-increase aria-label="Verhoog aantal">+</button>
            </div>

            <div class="product-form__error-message-wrapper" role="alert" hidden>
              <span class="product-form__error-message"></span>
            </div>

          {%- endform -%}
        </product-form>

        {%- assign payment_type_count = 0 -%}
        {%- for type in shop.enabled_payment_types -%}{%- assign payment_type_count = payment_type_count | plus: 1 -%}{%- endfor -%}
        {%- if payment_type_count > 0 -%}
          <details class="vhl-roha-pdp__payments">
            <summary class="vhl-roha-pdp__payments-summary">
              <svg class="vhl-roha-pdp__payments-lock" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                <rect x="4" y="9" width="12" height="8" rx="1.5" stroke="currentColor" stroke-width="1.4"></rect>
                <path d="M6.5 9V6.5a3.5 3.5 0 0 1 7 0V9" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"></path>
              </svg>
              <span>Betaal veilig met <span class="vhl-roha-pdp__payments-link">deze betaalmogelijkheden</span>.</span>
            </summary>
            <div class="vhl-roha-pdp__payments-icons" aria-label="Betaalmethoden">
              {%- for type in shop.enabled_payment_types -%}
                {{ type | payment_type_svg_tag }}
              {%- endfor -%}
            </div>
          </details>
        {%- endif -%}

        {%- if has_trust_block -%}
          <div class="vhl-roha-pdp__trust-card">
            {%- if section.settings.trust_badge_text != blank -%}
              <span class="vhl-roha-pdp__trust-badge">{{ section.settings.trust_badge_text }}</span>
            {%- endif -%}
            {%- if section.settings.trust_heading != blank -%}
              <p class="vhl-roha-pdp__trust-heading">{{ section.settings.trust_heading }}</p>
            {%- endif -%}
            {%- if section.settings.trust_body != blank -%}
              <p class="vhl-roha-pdp__trust-body">{{ section.settings.trust_body }}</p>
            {%- endif -%}
            {%- if section.settings.trust_warning != blank -%}
              <p class="vhl-roha-pdp__trust-warning">{{ section.settings.trust_warning }}</p>
            {%- endif -%}
          </div>
        {%- endif -%}

        <div class="vhl-roha-pdp__accordions">
          {%- if product.description != blank -%}
            <details class="vhl-roha-pdp__accordion">
              <summary>Product details</summary>
              <div class="vhl-roha-pdp__accordion-body">{{ product.description }}</div>
            </details>
          {%- endif -%}

          {%- if has_shipping_info -%}
            <details class="vhl-roha-pdp__accordion">
              <summary>Verzending &amp; retourneren</summary>
              <div class="vhl-roha-pdp__accordion-body">
                {%- if shop.policies.shipping_policy.body != blank -%}
                  <p><a href="{{ shop.policies.shipping_policy.url }}">{{ shop.policies.shipping_policy.title }}</a></p>
                {%- endif -%}
                {%- if shop.policies.refund_policy.body != blank -%}
                  <p><a href="{{ shop.policies.refund_policy.url }}">{{ shop.policies.refund_policy.title }}</a></p>
                {%- endif -%}
              </div>
            </details>
          {%- endif -%}
        </div>

      </div>
    </div>
  </div>
</section>

<script type="application/json" data-vhl-roha-variants="{{ root_id }}">
  [
  {%- for variant in product.variants -%}
    {%- liquid
      assign v_image = 'null'
      if variant.featured_image
        assign v_image_url = variant.featured_image | image_url: width: 1600
        assign v_image = v_image_url | json
      endif
      assign v_alt = variant.featured_image.alt | default: product.title
    -%}
    {
      "id": {{ variant.id | json }},
      "available": {{ variant.available | json }},
      "price": {{ variant.price | json }},
      "compare_at_price": {{ variant.compare_at_price | json }},
      "option1": {{ variant.option1 | json }},
      "option2": {{ variant.option2 | json }},
      "option3": {{ variant.option3 | json }},
      "image": {{ v_image }},
      "imageAlt": {{ v_alt | json }}
    }{%- unless forloop.last -%},{%- endunless -%}
  {%- endfor -%}
  ]
</script>

<script src="{{ 'product-form.js' | asset_url }}" defer></script>
<script>
  (function () {
    var root = document.getElementById({{ root_id | json }});
    if (!root) return;

    var dataEl = root.parentElement.querySelector('script[data-vhl-roha-variants="{{ root_id }}"]');
    var variants = [];
    try {
      variants = dataEl ? JSON.parse(dataEl.textContent) : [];
    } catch (err) {
      variants = [];
    }

    var variantIdInput = root.querySelector('[data-vhl-roha-variant-id]');
    var atcButton = root.querySelector('[data-vhl-roha-atc]');
    var atcButtonText = atcButton ? atcButton.querySelector('.button-text') : null;
    var atcPriceEl = atcButton ? atcButton.querySelector('[data-vhl-roha-atc-price]') : null;
    var priceCurrentEl = root.querySelector('[data-vhl-roha-price-current]');
    var priceCompareEl = root.querySelector('[data-vhl-roha-price-compare]');
    var mainImage = root.querySelector('[data-vhl-roha-main-image]');
    var optionGroups = Array.prototype.slice.call(root.querySelectorAll('[data-vhl-roha-option]'));
    var thumbs = Array.prototype.slice.call(root.querySelectorAll('[data-vhl-roha-thumb]'));
    var qtyInput = root.querySelector('[data-vhl-roha-qty-input]');
    var qtyDecrease = root.querySelector('[data-vhl-roha-qty-decrease]');
    var qtyIncrease = root.querySelector('[data-vhl-roha-qty-increase]');

    function formatMoney(cents) {
      if (typeof window.Elixir_FormatMoney === 'function') {
        return window.Elixir_FormatMoney(cents);
      }
      return (cents / 100).toFixed(2);
    }

    function currentSelection() {
      var selection = { 1: null, 2: null, 3: null };
      optionGroups.forEach(function (group) {
        var position = parseInt(group.getAttribute('data-option-position'), 10);
        var select = group.querySelector('[data-vhl-roha-option-select]');
        if (select) {
          selection[position] = select.value;
          return;
        }
        var active = group.querySelector('[data-vhl-roha-option-value][data-selected="true"]');
        selection[position] = active ? active.getAttribute('data-value') : null;
      });
      return selection;
    }

    function findVariant(selection) {
      for (var i = 0; i < variants.length; i++) {
        var v = variants[i];
        var matches = true;
        [1, 2, 3].forEach(function (position) {
          var expected = selection[position];
          var actual = v['option' + position];
          if (expected !== null && actual !== expected) matches = false;
        });
        if (matches) return v;
      }
      return null;
    }

    function setActiveThumbBySrc(src) {
      if (!src) return;
      thumbs.forEach(function (thumb) {
        var isMatch = thumb.getAttribute('data-full-src') === src;
        thumb.classList.toggle('is-active', isMatch);
      });
    }

    function updateVariant() {
      var selection = currentSelection();
      var variant = findVariant(selection);
      if (!variant) return;

      if (variantIdInput) variantIdInput.value = variant.id;

      if (priceCurrentEl) priceCurrentEl.textContent = formatMoney(variant.price);
      if (priceCompareEl) {
        if (variant.compare_at_price && variant.compare_at_price > variant.price) {
          priceCompareEl.textContent = formatMoney(variant.compare_at_price);
          priceCompareEl.hidden = false;
        } else {
          priceCompareEl.hidden = true;
        }
      }

      if (mainImage && variant.image) {
        mainImage.src = variant.image;
        mainImage.alt = variant.imageAlt || mainImage.alt;
        setActiveThumbBySrc(variant.image);
      }

      if (atcButton && atcButtonText) {
        if (variant.available) {
          atcButton.removeAttribute('disabled');
          atcButton.removeAttribute('aria-disabled');
          atcButtonText.textContent = '';
          var label = document.createTextNode('In winkelwagen ');
          var sep = document.createElement('span');
          sep.className = 'vhl-roha-pdp__atc-sep';
          sep.textContent = '•';
          var priceSpan = document.createElement('span');
          priceSpan.setAttribute('data-vhl-roha-atc-price', '');
          priceSpan.textContent = formatMoney(variant.price);
          atcButtonText.appendChild(label);
          atcButtonText.appendChild(sep);
          atcButtonText.appendChild(document.createTextNode(' '));
          atcButtonText.appendChild(priceSpan);
          atcPriceEl = priceSpan;
        } else {
          atcButton.setAttribute('disabled', 'disabled');
          atcButton.setAttribute('aria-disabled', 'true');
          atcButtonText.textContent = 'Uitverkocht';
          atcPriceEl = null;
        }
      }

      document.dispatchEvent(new CustomEvent('variant:change', { detail: { variant: variant } }));
    }

    optionGroups.forEach(function (group) {
      var selectedLabel = group.querySelector('[data-vhl-roha-option-selected]');
      var select = group.querySelector('[data-vhl-roha-option-select]');

      if (select) {
        select.addEventListener('change', function () {
          if (selectedLabel) selectedLabel.textContent = select.value;
          updateVariant();
        });
        return;
      }

      var buttons = Array.prototype.slice.call(group.querySelectorAll('[data-vhl-roha-option-value]'));
      buttons.forEach(function (btn) {
        btn.addEventListener('click', function () {
          buttons.forEach(function (b) {
            b.setAttribute('data-selected', 'false');
            b.setAttribute('aria-pressed', 'false');
          });
          btn.setAttribute('data-selected', 'true');
          btn.setAttribute('aria-pressed', 'true');
          if (selectedLabel) selectedLabel.textContent = btn.getAttribute('data-value');
          updateVariant();
        });
      });
    });

    thumbs.forEach(function (thumb) {
      thumb.addEventListener('click', function () {
        var fullSrc = thumb.getAttribute('data-full-src');
        if (mainImage && fullSrc) {
          mainImage.src = fullSrc;
          mainImage.alt = thumb.getAttribute('data-alt') || mainImage.alt;
        }
        thumbs.forEach(function (t) { t.classList.remove('is-active'); });
        thumb.classList.add('is-active');
      });
    });

    function clampQuantity(value) {
      var n = parseInt(value, 10);
      if (isNaN(n) || n < 1) n = 1;
      return n;
    }

    if (qtyInput) {
      qtyInput.addEventListener('change', function () {
        qtyInput.value = clampQuantity(qtyInput.value);
      });
    }
    if (qtyDecrease && qtyInput) {
      qtyDecrease.addEventListener('click', function () {
        qtyInput.value = clampQuantity(clampQuantity(qtyInput.value) - 1);
      });
    }
    if (qtyIncrease && qtyInput) {
      qtyIncrease.addEventListener('click', function () {
        qtyInput.value = clampQuantity(qtyInput.value) + 1;
      });
    }
  })();
</script>

