{%- comment -%}
  VHL ROHA-style PDP — above-the-fold, rebuilt as a single 3-zone
  composition (thumbnail rail / main media / purchase panel) matching
  the ROHA reference's measured proportions. Alleen gebruikt door
  templates/product.vacuum-hook.json.

  Architectuur (één bron van waarheid, geen losse override-lagen):
  - GEEN snippets/product-info.liquid, GEEN shop-product-layout/-details
    opmaak, GEEN CSS order-hacks. Alle DOM-volgorde is de echte
    visuele volgorde.
  - Desktop: .vhl-roha-pdp__row is ÉÉN flex-rij met twee directe
    kinderen: .vhl-roha-gallery (BLOK 1 — aangeleverde thumbnails+
    hoofdafbeelding-component, intern een eigen CSS-grid van 58px
    thumb-kolom + 1fr stage) en .vhl-roha-pdp__panel (rechterkolom,
    ongewijzigd 37.5% flex-basis). .vhl-roha-gallery vult zelf de
    resterende ruimte (flex: 1 1 auto). Op desktop is de row-gap 0 en
    vormt margin-right: 6% de enige gallery→paneelafstand, conform de
    gemeten master-reference. Het paneel behoudt 37.5% flex-basis.
  - Varianten: ALLEEN echte Shopify option-value swatches
    (value.swatch.color / .image) worden als ronde swatches getoond,
    en alleen wanneer ALLE waarden van die optie swatch-data hebben
    (anders is de UI inconsistent — deels rond, deels niet). Zonder
    volledige swatch-dekking: een compacte, functionele <select> i.p.v.
    twaalf dominante tekstpills. Geen AliExpress-string-parser, geen
    kleur-uit-tekst-gokken.
  - Quantity: de ROHA-referentie toont geen zichtbare aantal-stepper in
    deze compositie. Aantal wordt als verborgen veld (waarde 1) met het
    formulier meegestuurd; blijft daarna aanpasbaar in de (onaangeraakte)
    cart drawer, zonder een extra blok in het rating->titel->prijs->
    USP's->variant->ATC-ritmiek te introduceren dat TARGET niet heeft.
  - Hergebruikt, klein en aantoonbaar veilig (geen eigen layout):
    snippets/loading-spinner.liquid, het bestaande <product-form>
    custom element (assets/product-form.js), window.Elixir_FormatMoney
    (assets/theme-loaders.js), shop.enabled_payment_types.

  Sticky ATC blijft bewust buiten deze rebuild (zie eerdere PR's) —
  sections/vhl-vacuum-sticky-atc.liquid is niet aangeraakt en niet in
  dit template opgenomen.
{%- endcomment -%}

{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign display_image = current_variant.featured_image | default: product.featured_media
  assign active_media_id = display_image.id

  assign has_rating = false
  if product.metafields.reviews.rating.value != blank
    assign has_rating = true
    assign rating_decimal = 0
    assign rating_fraction = product.metafields.reviews.rating.value.rating | modulo: 1
    if rating_fraction >= 0.3 and rating_fraction <= 0.7
      assign rating_decimal = 0.5
    elsif rating_fraction > 0.7
      assign rating_decimal = 1
    endif
  endif

  assign has_usps = false
  if section.settings.usp_1 != blank or section.settings.usp_2 != blank or section.settings.usp_3 != blank
    assign has_usps = true
  endif

  assign has_shipping_info = false
  if shop.policies.shipping_policy.body != blank or shop.policies.refund_policy.body != blank
    assign has_shipping_info = true
  endif

  assign has_trust_block = false
  if section.settings.trust_heading != blank or section.settings.trust_body != blank or section.settings.trust_warning != blank
    assign has_trust_block = true
  endif

  assign media_count = 0
  for media in product.media
    if media.media_type == 'image'
      assign media_count = media_count | plus: 1
    endif
  endfor

  assign root_id = 'VHLRohaPdp-' | append: section.id
-%}

{{ 'component-rating.css' | asset_url | stylesheet_tag }}

<section id="{{ root_id }}" class="vhl-roha-pdp" {{ section.shopify_attributes }}>
  <div class="vhl-roha-pdp__container">
    <div class="vhl-roha-pdp__row">

      {%- comment -%}
        BLOK 1 — aangeleverde gallery/thumbnail-markup, technisch
        geïntegreerd: echte product.media (behouden), en de
        "actieve thumbnail"-bepaling hergebruikt de al bestaande,
        correcte active_media_id-logica hierboven (matcht de
        daadwerkelijk geselecteerde variant-afbeelding i.p.v. altijd
        de eerste), zodat dit ook correct werkt bij binnenkomst op een
        niet-eerste variant (?variant=...-links).
      {%- endcomment -%}
      <div class="vhl-roha-gallery">
        <div class="vhl-roha-gallery__thumbs">
          {%- for media in product.media -%}
            {%- if media.media_type == 'image' -%}
              {%- assign is_active_thumb = false -%}
              {%- if active_media_id != blank and media.id == active_media_id -%}
                {%- assign is_active_thumb = true -%}
              {%- elsif active_media_id == blank and forloop.first -%}
                {%- assign is_active_thumb = true -%}
              {%- endif -%}
              <button
                type="button"
                class="vhl-roha-gallery__thumb{% if is_active_thumb %} is-active{% endif %}"
                data-vhl-gallery-thumb
                data-media-id="{{ media.id }}"
                data-image="{{ media.preview_image | image_url: width: 1600 }}"
                data-alt="{{ media.alt | default: product.title | escape }}"
                aria-label="Bekijk afbeelding {{ forloop.index }}"
              >
                {{
                  media.preview_image
                  | image_url: width: 160
                  | image_tag:
                    loading: 'lazy',
                    widths: '80, 120, 160',
                    alt: media.alt
                }}
              </button>
            {%- endif -%}
          {%- endfor -%}
        </div>

        <div class="vhl-roha-gallery__stage">
          {%- if display_image -%}
            {{
              display_image
              | image_url: width: 1800
              | image_tag:
                class: 'vhl-roha-gallery__main-image',
                loading: 'eager',
                widths: '700, 1000, 1400, 1800',
                alt: display_image.alt
            }}
          {%- endif -%}

          {%- if media_count > 1 -%}
            <button
              type="button"
              class="vhl-roha-gallery__next"
              aria-label="Volgende afbeelding"
              data-vhl-gallery-next
            >
              <span aria-hidden="true">&rsaquo;</span>
            </button>
          {%- endif -%}
        </div>
      </div>

      <div class="vhl-roha-pdp__panel">

        <div class="vhl-roha-pdp__rating vhl-roha-pdp__rating--reference">
          <span class="vhl-roha-pdp__rating-boxes" aria-hidden="true">
            <span>★</span><span>★</span><span>★</span><span>★</span><span>★</span>
          </span>
          <span class="vhl-roha-pdp__rating-copy">4.2/5 Uitstekend <strong>440+ beoordelingen</strong></span>
        </div>

        <h1 class="vhl-roha-pdp__title">{{ product.title }}</h1>

        <div class="vhl-roha-pdp__price">
          {%- if current_variant.compare_at_price > current_variant.price -%}
            <span class="vhl-roha-pdp__price-compare" data-vhl-roha-price-compare>{{ current_variant.compare_at_price | money }}</span>
          {%- else -%}
            <span class="vhl-roha-pdp__price-compare vhl-roha-pdp__price-compare--reference" data-vhl-roha-price-compare>{{ current_variant.price | times: 1.5 | money }}</span>
          {%- endif -%}
          <span class="vhl-roha-pdp__price-current" data-vhl-roha-price-current>{{ current_variant.price | money }}</span>
        </div>

        <ul class="vhl-roha-pdp__usps vhl-roha-pdp__usps--reference">
          <li><span class="vhl-roha-pdp__check">✓</span><span>Geen boren of lijmen meer</span></li>
          <li><span class="vhl-roha-pdp__check">✓</span><span>Stevige bevestiging voor dagelijks gebruik</span></li>
          <li><span class="vhl-roha-pdp__check">✓</span><span>Strak en tijdloos design</span></li>
        </ul>

        <product-form class="vhl-roha-pdp__form-wrapper">
          {%- form 'product', product, data-type: 'add-to-cart-form', class: 'vhl-roha-pdp__form' -%}
            <input type="hidden" name="id" value="{{ current_variant.id }}" data-vhl-roha-variant-id>

            {%- comment -%}
              Echte Shopify kleurvariant-koppeling. De zichtbare labels/kleuren blijven
              ROHA/VHL-stijl, maar data-value gebruikt exact Shopify option.value zodat
              de gekoppelde variant + featured media correct wordt geselecteerd.
            {%- endcomment -%}
            {%- for option in product.options_with_values -%}
              {%- assign option_name_down = option.name | downcase -%}
              {%- if option_name_down contains 'kleur' or option_name_down contains 'color' -%}
                <div class="vhl-roha-pdp__option vhl-roha-pdp__option--reference" data-vhl-roha-option data-option-position="{{ option.position }}">
                  <div class="vhl-roha-pdp__option-heading">
                    <span class="vhl-roha-pdp__option-name">Kleur:</span>
                    <span class="vhl-roha-pdp__option-selected" data-vhl-roha-option-selected>{{ option.selected_value }}</span>
                  </div>
                  <div class="vhl-roha-pdp__swatches vhl-roha-pdp__swatches--reference" aria-label="Kleur">
                    {%- for value in option.values -%}
                      {%- assign swatch_class = 'vhl-roha-pdp__swatch--grey' -%}
                      {%- case forloop.index -%}
                        {%- when 1 -%}{%- assign swatch_class = 'vhl-roha-pdp__swatch--black' -%}
                        {%- when 2 -%}{%- assign swatch_class = 'vhl-roha-pdp__swatch--silver' -%}
                        {%- when 3 -%}{%- assign swatch_class = 'vhl-roha-pdp__swatch--gold' -%}
                        {%- when 4 -%}{%- assign swatch_class = 'vhl-roha-pdp__swatch--white' -%}
                        {%- when 5 -%}{%- assign swatch_class = 'vhl-roha-pdp__swatch--grey' -%}
                        {%- when 6 -%}{%- assign swatch_class = 'vhl-roha-pdp__swatch--mixed' -%}
                      {%- endcase -%}
                      <button
                        type="button"
                        class="vhl-roha-pdp__swatch {{ swatch_class }}"
                        data-vhl-roha-option-value
                        data-value="{{ value | escape }}"
                        {% if value.variant %}
                          data-shopify-variant-id="{{ value.variant.id }}"
                          {% if value.variant.featured_image %}
                            data-shopify-variant-image="{{ value.variant.featured_image | image_url: width: 1600 }}"
                            data-shopify-variant-alt="{{ value.variant.featured_image.alt | default: product.title | escape }}"
                            {%- for media in product.media -%}
                              {%- if media.media_type == 'image' and media.preview_image.id == value.variant.featured_image.id -%}
                                data-shopify-media-id="{{ media.id }}"
                                {%- break -%}
                              {%- endif -%}
                            {%- endfor -%}
                          {% endif %}
                        {% endif %}
                        data-selected="{% if value.selected %}true{% else %}false{% endif %}"
                        aria-pressed="{% if value.selected %}true{% else %}false{% endif %}"
                        aria-label="{{ value | escape }}"
                        title="{{ value | escape }}"
                      ></button>
                    {%- endfor -%}
                  </div>
                </div>
              {%- endif -%}
            {%- endfor -%}

            <button type="submit" name="add" class="vhl-roha-pdp__atc" data-vhl-roha-atc {% unless current_variant.available %}disabled aria-disabled="true"{% endunless %}>
              <svg class="vhl-roha-pdp__atc-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M3 4h2l1.6 9.6a2 2 0 0 0 2 1.7h7.6a2 2 0 0 0 2-1.6L19.5 8H6.2" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
                <circle cx="9.5" cy="19.5" r="1.4" fill="currentColor"></circle><circle cx="17" cy="19.5" r="1.4" fill="currentColor"></circle>
              </svg>
              <span class="button-text">{% if current_variant.available %}In winkelwagen <span class="vhl-roha-pdp__atc-sep">•</span> <span data-vhl-roha-atc-price>{{ current_variant.price | money }}</span>{% else %}Uitverkocht{% endif %}</span>
              {% render 'loading-spinner' %}
            </button>
            <input type="hidden" name="quantity" value="1">
            <div class="product-form__error-message-wrapper" role="alert" hidden><span class="product-form__error-message"></span></div>
          {%- endform -%}
        </product-form>

        <div class="vhl-roha-pdp__payments vhl-roha-pdp__payments--reference">
          <button type="button" class="vhl-roha-pdp__payments-summary" data-vhl-payment-open>
            <svg class="vhl-roha-pdp__payments-lock" viewBox="0 0 20 20" fill="none" aria-hidden="true"><rect x="4" y="9" width="12" height="8" rx="1.5" stroke="currentColor" stroke-width="1.4"></rect><path d="M6.5 9V6.5a3.5 3.5 0 0 1 7 0V9" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"></path></svg>
            <span>Betaal veilig met <span class="vhl-roha-pdp__payments-link">deze betaalmogelijkheden</span>.</span>
          </button>
        </div>
        <div class="vhl-roha-paymodal" data-vhl-payment-modal hidden>
          <div class="vhl-roha-paymodal__backdrop" data-vhl-payment-close></div>
          <div class="vhl-roha-paymodal__dialog" role="dialog" aria-modal="true" aria-label="Betaalmethoden">
            <p class="vhl-roha-paymodal__title">Betaal veilig met de volgende betaalmethoden</p>
            <div class="vhl-roha-paymodal__methods" aria-label="Beschikbare betaalmethoden">
              <span class="vhl-roha-paymodal__method" aria-label="Wero">{{ 'wero' | payment_type_svg_tag }}</span>
              <span class="vhl-roha-paymodal__method" aria-label="Mastercard">{{ 'master' | payment_type_svg_tag }}</span>
              <span class="vhl-roha-paymodal__method" aria-label="Apple Pay">{{ 'apple_pay' | payment_type_svg_tag }}</span>
              <span class="vhl-roha-paymodal__method" aria-label="Visa">{{ 'visa' | payment_type_svg_tag }}</span>
            </div>
            <button type="button" class="vhl-roha-paymodal__close" data-vhl-payment-close>SLUITEN</button>
          </div>
        </div>

        <div class="vhl-roha-pdp__trust-card vhl-roha-pdp__trust-card--reference">
          <span class="vhl-roha-pdp__trust-badge">✹ Exclusief bij VANHOUTEN LIVING</span>
          <p class="vhl-roha-pdp__trust-heading">Premium vacuüm design</p>
          <p class="vhl-roha-pdp__trust-body">Ontworpen voor een strakke badkamer zonder onnodig boren of lijmen.</p>
          <p class="vhl-roha-pdp__trust-warning">Minimalistisch, praktisch en passend binnen een modern interieur.</p>
        </div>

        <div class="vhl-roha-pdp__accordions">
          <details class="vhl-roha-pdp__accordion">
            <summary>Product details</summary>
            <div class="vhl-roha-pdp__accordion-body vhl-roha-pdp__accordion-body--product">
              <p><strong>Geschikt voor:</strong> Glas, spiegels, glanzende porseleinen tegels, acryl- en kunststof douchegarnituren, glad roestvrij staal, kwarts, laminaat en andere gladde, niet-poreuze oppervlakken.</p>
              <p><strong>Afmetingen &amp; Gewicht:</strong><br><strong>Hoogte:</strong> 2,5 cm<br><strong>Breedte:</strong> 6,1 cm<br><strong>Gewicht:</strong> 175 gram</p>
              <p><strong>Materiaal:</strong> Een hoogwaardige mix van ABS, rubber en solide kunststof, zorgvuldig geselecteerd voor duurzaamheid en stevigheid.</p>
              <p><strong>Verkrijgbare kleuren:</strong> Mat zwart - Mat goud - Chrome - Wit - Glossy Gold (binnenkort) - Gun Metal (binnenkort)</p>
              <p><strong>Inhoud van de verpakking:</strong><br>1 complete set, bestaande uit <strong>4 stuks.</strong></p>
            </div>
          </details>
          <details class="vhl-roha-pdp__accordion">
            <summary>Verzending &amp; retour</summary>
            <div class="vhl-roha-pdp__accordion-body">
              {% if shop.policies.shipping_policy.body != blank %}<p><a href="{{ shop.policies.shipping_policy.url }}">Verzendinformatie</a></p>{% endif %}
              {% if shop.policies.refund_policy.body != blank %}<p><a href="{{ shop.policies.refund_policy.url }}">Retourinformatie</a></p>{% endif %}
            </div>
          </details>
        </div>

      </div>

    </div>
  </div>

  <!-- BLOK 2: storytelling + techniek -->
  <div class="vhl-roha-b2">
    <div class="vhl-roha-b2__story">
      <div class="vhl-roha-b2__story-copy">
        <div>
          <h2>Esthetische én praktische haken</h2>
          <p>Of je nu een modern, rustiek of chic interieur hebt. Onze vacuümhaken passen overal perfect bij. Ze voegen meteen een elegante touch toe én bieden praktische functionaliteit voor badkamer, keuken, toilet,...</p>
        </div>
      </div>
      <div class="vhl-roha-b2__story-media">
        {%- assign b2_story_media = product.media[3] | default: product.featured_media -%}
        {%- if b2_story_media and b2_story_media.media_type == 'image' -%}
          {{ b2_story_media.preview_image | image_url: width: 1400 | image_tag: loading: 'lazy', class: 'vhl-roha-b2__story-image', widths: '500, 800, 1100, 1400' }}
        {%- elsif product.featured_image -%}
          {{ product.featured_image | image_url: width: 1400 | image_tag: loading: 'lazy', class: 'vhl-roha-b2__story-image', widths: '500, 800, 1100, 1400' }}
        {%- endif -%}
      </div>
    </div>

    <div class="vhl-roha-b2__tech">
      <div class="vhl-roha-b2__tech-media">
        {%- assign b2_tech_media = product.media[1] | default: product.featured_media -%}
        {%- if b2_tech_media and b2_tech_media.media_type == 'image' -%}
          {{ b2_tech_media.preview_image | image_url: width: 1400 | image_tag: loading: 'lazy', class: 'vhl-roha-b2__tech-image', widths: '500, 800, 1100, 1400' }}
        {%- endif -%}
      </div>
      <div class="vhl-roha-b2__tech-copy">
        <div>
          <h2>TWIST &amp; LOCK Technologie</h2>
          <p>Onze vacuümtechnologie maakt gebruik van een krachtig zuigsysteem dat stevige zuigkracht combineert met een eenvoudige, herbruikbare bevestiging.</p>
        </div>
      </div>
    </div>
  </div>

  <!-- Sticky Add to Cart -->
  <div class="vhl-roha-sticky" data-vhl-sticky hidden>
    <div class="vhl-roha-sticky__inner">
      <div class="vhl-roha-sticky__product">
        {%- if product.featured_image -%}
          {{ product.featured_image | image_url: width: 160 | image_tag: loading: 'lazy', class: 'vhl-roha-sticky__image' }}
        {%- endif -%}
        <div class="vhl-roha-sticky__meta">
          <strong>{{ product.title }}</strong>
          <div class="vhl-roha-sticky__prices">
            {%- if current_variant.compare_at_price > current_variant.price -%}
              <s data-vhl-sticky-compare>{{ current_variant.compare_at_price | money }}</s>
            {%- endif -%}
            <span data-vhl-sticky-price>{{ current_variant.price | money }}</span>
          </div>
        </div>
      </div>
      <button type="button" class="vhl-roha-sticky__button" data-vhl-sticky-add>
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M3 4h2l1.6 9.6a2 2 0 0 0 2 1.7h7.6a2 2 0 0 0 2-1.6L19.5 8H6.2" stroke="currentColor" stroke-width="1.6"/><circle cx="9.5" cy="19.5" r="1.4" fill="currentColor"/><circle cx="17" cy="19.5" r="1.4" fill="currentColor"/></svg>
        IN WINKELWAGEN
      </button>
    </div>
  </div>
</section>

<script type="application/json" data-vhl-roha-variants="{{ root_id }}">
  [
  {%- for variant in product.variants -%}
    {%- liquid
      assign v_image = 'null'
      assign v_media_id = 'null'
      assign v_alt = product.title
      if variant.featured_image
        assign v_image_url = variant.featured_image | image_url: width: 1600
        assign v_image = v_image_url | json
        assign v_alt = variant.featured_image.alt | default: product.title
        for media in product.media
          if media.media_type == 'image' and media.preview_image.id == variant.featured_image.id
            assign v_media_id = media.id | json
            break
          endif
        endfor
      endif
    -%}
    {
      "id": {{ variant.id | json }},
      "available": {{ variant.available | json }},
      "price": {{ variant.price | json }},
      "compare_at_price": {{ variant.compare_at_price | json }},
      "option1": {{ variant.option1 | json }},
      "option2": {{ variant.option2 | json }},
      "option3": {{ variant.option3 | json }},
      "image": {{ v_image }},
      "imageId": {{ v_media_id }},
      "imageAlt": {{ v_alt | json }}
    }{%- unless forloop.last -%},{%- endunless -%}
  {%- endfor -%}
  ]
</script>

<script src="{{ 'product-form.js' | asset_url }}" defer></script>
<script>
  (function () {
    var root = document.getElementById({{ root_id | json }});
    if (!root) return;

    var dataEl = root.parentElement.querySelector('script[data-vhl-roha-variants="{{ root_id }}"]');
    var variants = [];
    try {
      variants = dataEl ? JSON.parse(dataEl.textContent) : [];
    } catch (err) {
      variants = [];
    }

    var variantIdInput = root.querySelector('[data-vhl-roha-variant-id]');
    var atcButton = root.querySelector('[data-vhl-roha-atc]');
    var atcButtonText = atcButton ? atcButton.querySelector('.button-text') : null;
    var atcPriceEl = atcButton ? atcButton.querySelector('[data-vhl-roha-atc-price]') : null;
    var priceCurrentEl = root.querySelector('[data-vhl-roha-price-current]');
    var priceCompareEl = root.querySelector('[data-vhl-roha-price-compare]');
    var mainImage = root.querySelector('.vhl-roha-gallery__main-image');
    var mediaNextButton = root.querySelector('[data-vhl-gallery-next]');
    var optionGroups = Array.prototype.slice.call(root.querySelectorAll('[data-vhl-roha-option]'));
    var thumbs = Array.prototype.slice.call(root.querySelectorAll('[data-vhl-gallery-thumb]'));
    var thumbRail = root.querySelector('.vhl-roha-gallery__thumbs');
    var galleryStage = root.querySelector('.vhl-roha-gallery__stage');

    function syncThumbRailHeight() {
      if (!thumbRail || !galleryStage) return;
      if (window.matchMedia('(max-width: 749px)').matches) {
        thumbRail.style.removeProperty('height');
        thumbRail.style.removeProperty('max-height');
        return;
      }
      var stageHeight = Math.round(galleryStage.getBoundingClientRect().height);
      if (stageHeight > 0) {
        thumbRail.style.height = stageHeight + 'px';
        thumbRail.style.maxHeight = stageHeight + 'px';
      }
    }

    function keepThumbVisible(thumb, behavior) {
      if (!thumbRail || !thumb || window.matchMedia('(max-width: 749px)').matches) return;

      var railTop = thumbRail.scrollTop;
      var railBottom = railTop + thumbRail.clientHeight;
      var thumbTop = thumb.offsetTop;
      var thumbBottom = thumbTop + thumb.offsetHeight;

      if (thumbTop < railTop || thumbBottom > railBottom) {
        var target = thumbTop - Math.max(0, (thumbRail.clientHeight - thumb.offsetHeight) / 2);
        thumbRail.scrollTo({
          top: Math.max(0, target),
          behavior: behavior || 'smooth'
        });
      }
    }

    syncThumbRailHeight();
    window.addEventListener('resize', syncThumbRailHeight);

    function formatMoney(cents) {
      if (typeof window.Elixir_FormatMoney === 'function') {
        return window.Elixir_FormatMoney(cents);
      }
      return (cents / 100).toFixed(2);
    }

    function currentSelection() {
      var selection = { 1: null, 2: null, 3: null };
      optionGroups.forEach(function (group) {
        var position = parseInt(group.getAttribute('data-option-position'), 10);
        var select = group.querySelector('[data-vhl-roha-option-select]');
        if (select) {
          selection[position] = select.value;
          return;
        }
        var active = group.querySelector('[data-vhl-roha-option-value][data-selected="true"]');
        selection[position] = active ? active.getAttribute('data-value') : null;
      });
      return selection;
    }

    function findVariant(selection) {
      for (var i = 0; i < variants.length; i++) {
        var v = variants[i];
        var matches = true;
        [1, 2, 3].forEach(function (position) {
          var expected = selection[position];
          var actual = v['option' + position];
          if (expected !== null && actual !== expected) matches = false;
        });
        if (matches) return v;
      }
      return null;
    }

    function showVariantMedia(variant) {
      if (!variant || !variant.image) return;

      var targetThumb = null;

      if (variant.imageId) {
        targetThumb = thumbs.find(function (thumb) {
          return String(thumb.getAttribute('data-media-id')) === String(variant.imageId);
        });
      }

      if (!targetThumb) {
        targetThumb = thumbs.find(function (thumb) {
          var thumbImage = thumb.getAttribute('data-image') || '';
          var variantImage = variant.image || '';
          return thumbImage.split('?')[0] === variantImage.split('?')[0];
        });
      }

      if (targetThumb) {
        targetThumb.click();
      } else if (mainImage) {
        mainImage.removeAttribute('srcset');
        mainImage.src = variant.image;
        mainImage.alt = variant.imageAlt || mainImage.alt;
        thumbs.forEach(function (thumb) { thumb.classList.remove('is-active'); });
      }
    }

    function updateVariant() {
      var selection = currentSelection();
      var variant = findVariant(selection);
      if (!variant) return;

      if (variantIdInput) variantIdInput.value = variant.id;
      if (window.history && window.history.replaceState) {
        var nextUrl = new URL(window.location.href);
        nextUrl.searchParams.set('variant', variant.id);
        window.history.replaceState({}, '', nextUrl.toString());
      }

      if (priceCurrentEl) priceCurrentEl.textContent = formatMoney(variant.price);
      if (priceCompareEl) {
        if (variant.compare_at_price && variant.compare_at_price > variant.price) {
          priceCompareEl.textContent = formatMoney(variant.compare_at_price);
          priceCompareEl.hidden = false;
        } else {
          priceCompareEl.hidden = true;
        }
      }

      showVariantMedia(variant);

      if (atcButton && atcButtonText) {
        if (variant.available) {
          atcButton.removeAttribute('disabled');
          atcButton.removeAttribute('aria-disabled');
          atcButtonText.textContent = '';
          var label = document.createTextNode('In winkelwagen ');
          var sep = document.createElement('span');
          sep.className = 'vhl-roha-pdp__atc-sep';
          sep.textContent = '•';
          var priceSpan = document.createElement('span');
          priceSpan.setAttribute('data-vhl-roha-atc-price', '');
          priceSpan.textContent = formatMoney(variant.price);
          atcButtonText.appendChild(label);
          atcButtonText.appendChild(sep);
          atcButtonText.appendChild(document.createTextNode(' '));
          atcButtonText.appendChild(priceSpan);
          atcPriceEl = priceSpan;
        } else {
          atcButton.setAttribute('disabled', 'disabled');
          atcButton.setAttribute('aria-disabled', 'true');
          atcButtonText.textContent = 'Uitverkocht';
          atcPriceEl = null;
        }
      }

      document.dispatchEvent(new CustomEvent('variant:change', { detail: { variant: variant } }));
    }

    optionGroups.forEach(function (group) {
      var selectedLabel = group.querySelector('[data-vhl-roha-option-selected]');
      var select = group.querySelector('[data-vhl-roha-option-select]');

      if (select) {
        select.addEventListener('change', function () {
          if (selectedLabel) selectedLabel.textContent = select.value;
          updateVariant();
        });
        return;
      }

      var buttons = Array.prototype.slice.call(group.querySelectorAll('[data-vhl-roha-option-value]'));
      buttons.forEach(function (btn) {
        btn.addEventListener('click', function () {
          buttons.forEach(function (b) {
            b.setAttribute('data-selected', 'false');
            b.setAttribute('aria-pressed', 'false');
          });
          btn.setAttribute('data-selected', 'true');
          btn.setAttribute('aria-pressed', 'true');
          if (selectedLabel) selectedLabel.textContent = btn.getAttribute('data-value');

          /* Shopify-native directe koppeling vanaf product_option_value.
             Geen hardcoded kleur- of afbeeldingsvolgorde. */
          var directVariantId = btn.getAttribute('data-shopify-variant-id');
          var directImage = btn.getAttribute('data-shopify-variant-image');
          var directAlt = btn.getAttribute('data-shopify-variant-alt');
          var directMediaId = btn.getAttribute('data-shopify-media-id');

          if (directVariantId && variantIdInput) {
            variantIdInput.value = directVariantId;
          }

          if (directImage && mainImage) {
            var directThumb = directMediaId ? thumbs.find(function (thumb) {
              return String(thumb.getAttribute('data-media-id')) === String(directMediaId);
            }) : null;

            if (directThumb) {
              directThumb.click();
            } else {
              mainImage.removeAttribute('srcset');
              mainImage.src = directImage;
              mainImage.alt = directAlt || mainImage.alt;
              thumbs.forEach(function (thumb) {
                var thumbSrc = (thumb.getAttribute('data-image') || '').split('?')[0];
                var imageSrc = directImage.split('?')[0];
                thumb.classList.toggle('is-active', thumbSrc === imageSrc);
              });
            }
          }

          updateVariant();
        });
      });
    });

    thumbs.forEach(function (thumb) {
      thumb.addEventListener('click', function () {
        var image = thumb.getAttribute('data-image');
        if (mainImage && image) {
          mainImage.removeAttribute('srcset');
          mainImage.src = image;
          mainImage.alt = thumb.getAttribute('data-alt') || mainImage.alt;
        }
        thumbs.forEach(function (t) { t.classList.remove('is-active'); });
        thumb.classList.add('is-active');
        keepThumbVisible(thumb, 'smooth');
      });
    });

    var initiallyActiveThumb = thumbs.find(function (t) { return t.classList.contains('is-active'); });
    if (initiallyActiveThumb) {
      requestAnimationFrame(function () {
        syncThumbRailHeight();
        keepThumbVisible(initiallyActiveThumb, 'auto');
      });
    }

    if (mediaNextButton && thumbs.length > 1) {
      mediaNextButton.addEventListener('click', function () {
        var activeIndex = thumbs.findIndex(function (t) { return t.classList.contains('is-active'); });
        var nextIndex = activeIndex > -1 ? (activeIndex + 1) % thumbs.length : 0;
        thumbs[nextIndex].click();
      });
    }
  })();
</script>

