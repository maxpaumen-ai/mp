    },
    {
      "type": "color",
      "id": "button_border_color",
      "label": "Randkleur knop",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "button_hover_background",
      "label": "Achtergrond knop bij hover",
      "default": "#202020"
    },
    {
      "type": "color",
      "id": "button_hover_text_color",
      "label": "Tekstkleur knop bij hover",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "button_radius",
      "min": 0,
      "max": 30,
      "step": 2,
      "unit": "px",
      "label": "Afronding knop",
      "default": 6
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 140,
      "step": 5,
      "unit": "px",
