    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Tekstkleur",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "button_background",
      "label": "Achtergrond knop",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Tekstkleur knop",
