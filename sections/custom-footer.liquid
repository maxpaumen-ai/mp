{% comment %}
  VAN HOUTEN LIVING — PREMIUM FOOTER
  Joseph Joseph inspired layout
{% endcomment %}

<footer class="vhl-footer">

  <!-- USP BAR -->
  <div class="vhl-footer__usp">
    <div>2 jaar garantie op alle producten</div>
    <div>Voordelen bij elke aankoop</div>
    <div>30 dagen geld-terug-garantie</div>
    <div>Gratis retourneren op alle bestellingen</div>
  </div>


  <!-- MAIN FOOTER -->
  <div class="vhl-footer__main">

    <div class="vhl-footer__content">

      <!-- NEWSLETTER -->
      <div class="vhl-footer__newsletter">

        <h2>
          Schrijf je in & ontvang<br>
          tot 15% korting op je eerste bestelling!
        </h2>

        <p class="vhl-footer__newsletter-text">
          Schrijf je in voor onze nieuwsbrief en ontvang de nieuwste
          updates, exclusieve aanbiedingen en inspiratie voor jouw badkamer.
        </p>

        {% form 'customer', class: 'vhl-footer__form' %}

          <input
            type="hidden"
            name="contact[tags]"
            value="newsletter"
          >

          <div class="vhl-footer__input-wrap">

            <input
              type="email"
              name="contact[email]"
              placeholder="Jouw e-mailadres"
              required
              autocomplete="email"
            >

            <button type="submit">
              Inschrijven
            </button>

          </div>

          {% if form.posted_successfully? %}
            <p class="vhl-footer__success">
              Bedankt voor je inschrijving.
            </p>
          {% endif %}

        {% endform %}

        <p class="vhl-footer__small">
          Door je in te schrijven ga je akkoord met onze voorwaarden.
          Je kunt je op ieder moment uitschrijven.
        </p>

      </div>


      <!-- LINKS -->
      <div class="vhl-footer__links">

        <!-- KLANTENSERVICE -->
        <div class="vhl-footer__column">

          <h3>Klantenservice</h3>

          <a href="/pages/contact">Contact</a>
          <a href="/pages/shipping">Verzending</a>
          <a href="/pages/returns">Retourneren</a>
          <a href="/pages/faq">Veelgestelde vragen</a>
          <a href="/pages/garantie">Garantie</a>
          <a href="/account">Volg je bestelling</a>

        </div>


        <!-- ONTDEK -->
        <div class="vhl-footer__column">

          <h3>Ontdek</h3>

          <a href="/pages/over-ons">Over ons</a>
          <a href="/collections/all">Alle producten</a>
          <a href="/collections/badkamer">Badkamer</a>
          <a href="/collections/opbergen">Opbergen</a>
          <a href="/collections/accessoires">Accessoires</a>
          <a href="/pages/contact">Contact</a>

        </div>


        <!-- EXTRA -->
        <div class="vhl-footer__column">

          <h3>Extra</h3>

          <a href="/pages/installatie">Installatie</a>
          <a href="/pages/faq">Veelgestelde vragen</a>
          <a href="/pages/shipping">Verzendinformatie</a>
          <a href="/pages/returns">Retourbeleid</a>
          <a href="/pages/privacy-policy">Privacy</a>

        </div>


        <!-- COLLECTIES -->
        <div class="vhl-footer__column">

          <h3>Collecties</h3>

          {% for collection in collections %}
            {% unless collection.handle == 'all' or collection.handle == 'frontpage' %}
              <a href="{{ collection.url }}">
                {{ collection.title }}
              </a>
            {% endunless %}
          {% endfor %}

        </div>

      </div>

    </div>


    <!-- PAYMENT AREA -->
    <div class="vhl-footer__payments">

      <!-- WERO -->
      <div class="vhl-payment vhl-payment--wero">
        <span>WERO</span>
      </div>

      <!-- MASTERCARD -->
      <div class="vhl-payment vhl-payment--mastercard">
        <svg viewBox="0 0 54 34" aria-label="Mastercard">
          <circle cx="21" cy="17" r="11" fill="#EB001B"/>
          <circle cx="33" cy="17" r="11" fill="#F79E1B"/>
          <path
            d="M27 8.4a11 11 0 0 1 0 17.2 11 11 0 0 1 0-17.2z"
            fill="#FF5F00"
          />
        </svg>
      </div>

      <!-- APPLE PAY -->
      <div class="vhl-payment vhl-payment--apple">
        <svg viewBox="0 0 76 32" aria-label="Apple Pay">
          <path
            d="M16.3 8.3c1.1-1.3 1.8-3 1.6-4.7-1.6.1-3.5 1.1-4.6 2.4-1 1.1-1.9 2.9-1.6 4.5 1.7.1 3.5-.9 4.6-2.2zm1.6 2.6c-2.5-.1-4.6 1.4-5.8 1.4-1.2 0-3.1-1.3-5.1-1.3-2.6 0-5 1.5-6.3 3.9-2.7 4.7-.7 11.6 1.9 15.4 1.3 1.9 2.8 3.9 4.9 3.8 1.9-.1 2.7-1.2 5-1.2s3 1.2 5.1 1.2c2.1 0 3.4-1.9 4.7-3.8 1.5-2.2 2.1-4.3 2.1-4.4-.1 0-4.1-1.6-4.1-6.3 0-3.9 3.2-5.8 3.4-5.9-1.8-2.7-4.7-3-5.8-3z"
            fill="currentColor"
            transform="scale(.65)"
          />
          <text
            x="23"
            y="21"
            font-size="14"
            font-family="Arial, sans-serif"
            font-weight="600"
          >
            Pay
          </text>
        </svg>
      </div>

      <!-- VISA -->
      <div class="vhl-payment vhl-payment--visa">
        <span>VISA</span>
      </div>


      <!-- SHOPIFY ENABLED PAYMENT TYPES -->
      {% for type in shop.enabled_payment_types %}

        {% unless type == 'visa' or type == 'master' or type == 'apple_pay' %}

          <div class="vhl-payment vhl-payment--shopify">
            {{ type | payment_type_svg_tag }}
          </div>

        {% endunless %}

      {% endfor %}

    </div>


    <!-- BOTTOM -->
    <div class="vhl-footer__bottom">

      <div class="vhl-footer__bottom-left">
        © {{ 'now' | date: '%Y' }} Van Houten Living
      </div>

      <div class="vhl-footer__legal">

        <a href="/policies/privacy-policy">
          Privacybeleid
        </a>

        <a href="/policies/refund-policy">
          Retourbeleid
        </a>

        <a href="/policies/shipping-policy">
          Verzendbeleid
        </a>

        <a href="/policies/terms-of-service">
          Algemene voorwaarden
        </a>

      </div>

    </div>

  </div>

</footer>


<style>

/* =========================================================
   VAN HOUTEN LIVING FOOTER
   ========================================================= */

.vhl-footer {
  width: 100%;
  color: #4b4b4b;
  background: #f5f5f5;
}


/* =========================================================
   USP BAR
   ========================================================= */

.vhl-footer__usp {
  width: 100%;
  min-height: 68px;

  display: grid;
  grid-template-columns: repeat(4, 1fr);

  align-items: center;

  padding: 0 30px;

  background: #ffffff;

  border-top: 1px solid #eeeeee;
  border-bottom: 1px solid #eeeeee;

  text-align: center;

  font-size: 15px;
  line-height: 1.3;

  letter-spacing: .04em;
}


/* =========================================================
   MAIN
   ========================================================= */

.vhl-footer__main {
  padding: 90px 30px 0;
}


.vhl-footer__content {
  width: 100%;
  max-width: 1660px;

  margin: 0 auto;

  display: grid;

  grid-template-columns:
    minmax(390px, 1.25fr)
    minmax(650px, 1.75fr);

  gap: 110px;
}


/* =========================================================
   NEWSLETTER
   ========================================================= */

.vhl-footer__newsletter {
  max-width: 520px;
}


.vhl-footer__newsletter h2 {
  margin: 0 0 34px;

  color: #4a4a4a;

  font-size: clamp(30px, 2.3vw, 42px);
  line-height: 1.17;

  font-weight: 300;

  letter-spacing: -.02em;
}


.vhl-footer__newsletter-text {
  max-width: 500px;

  margin: 0 0 42px;

  color: #666666;

  font-size: 15px;
  line-height: 1.65;
}


.vhl-footer__form {
  width: 100%;
}


.vhl-footer__input-wrap {
  width: 100%;

  display: flex;

  background: #ffffff;

  border-radius: 28px;

  overflow: hidden;
}


.vhl-footer__input-wrap input {
  flex: 1;

  min-width: 0;
  height: 54px;

  padding: 0 24px;

  border: 0;
  outline: 0;

  background: #ffffff;

  color: #333333;

  font: inherit;
  font-size: 14px;
}


.vhl-footer__input-wrap input::placeholder {
  color: #777777;
}


.vhl-footer__input-wrap button {
  flex: 0 0 auto;

  min-width: 135px;
  height: 54px;

  padding: 0 28px;

  border: 0;

  background: #555555;
  color: #ffffff;

  cursor: pointer;

  font: inherit;
  font-size: 14px;

  letter-spacing: .03em;
}


.vhl-footer__input-wrap button:hover {
  background: #333333;
}


.vhl-footer__small {
  max-width: 500px;

  margin: 42px 0 0;

  color: #777777;

  font-size: 12px;
  line-height: 1.6;
}


.vhl-footer__success {
  margin: 14px 0 0;

  font-size: 13px;

  color: #333333;
}


/* =========================================================
   LINK COLUMNS
   ========================================================= */

.vhl-footer__links {
  display: grid;

  grid-template-columns: repeat(4, minmax(0, 1fr));

  gap: 55px;
}


.vhl-footer__column h3 {
  margin: 0 0 26px;

  color: #444444;

  font-size: 15px;
  line-height: 1.2;

  font-weight: 600;

  letter-spacing: .03em;
}


.vhl-footer__column a {
  display: block;

  width: fit-content;

  margin: 0 0 17px;

  color: #666666;

  text-decoration: none;

  font-size: 14px;
  line-height: 1.35;
}


.vhl-footer__column a:hover {
  color: #111111;
  text-decoration: underline;
}


/* =========================================================
   PAYMENTS
   ========================================================= */

.vhl-footer__payments {
  width: 100%;
  max-width: 1660px;

  margin: 70px auto 50px;

  display: flex;

  align-items: center;

  gap: 12px;

  flex-wrap: wrap;
}


.vhl-payment {
  width: 56px;
  height: 35px;

  display: flex;

  align-items: center;
  justify-content: center;

  background: #ffffff;

  border: 1px solid #dddddd;

  border-radius: 5px;

  overflow: hidden;
}


.vhl-payment svg {
  display: block;

  max-width: 48px;
  max-height: 29px;
}


.vhl-payment--wero {
  background: #fff49a;

  color: #111111;

  font-size: 15px;

  font-weight: 900;

  letter-spacing: -.07em;
}


.vhl-payment--mastercard {
  background: #181818;
}


.vhl-payment--mastercard svg {
  width: 48px;
  height: 30px;
}


.vhl-payment--apple {
  color: #000000;

  border: 2px solid #111111;
}


.vhl-payment--apple svg {
  width: 49px;
}


.vhl-payment--visa {
  background: #1434cb;

  border-color: #1434cb;

  color: #ffffff;

  font-size: 18px;

  font-weight: 800;

  font-style: italic;
}


.vhl-payment--shopify svg {
  width: 100%;
  height: 100%;
}


/* =========================================================
   BOTTOM
   ========================================================= */

.vhl-footer__bottom {
  width: 100%;

  min-height: 82px;

  display: flex;

  align-items: center;
  justify-content: space-between;

  gap: 40px;

  padding: 22px 30px;

  border-top: 1px solid #dddddd;

  color: #777777;

  font-size: 12px;
}


.vhl-footer__legal {
  display: flex;

  align-items: center;

  justify-content: flex-end;

  gap: 35px;

  flex-wrap: wrap;
}


.vhl-footer__legal a {
  color: #777777;

  text-decoration: none;
}


.vhl-footer__legal a:hover {
  color: #222222;
}


/* =========================================================
   TABLET
   ========================================================= */

@media screen and (max-width: 1100px) {

  .vhl-footer__main {
    padding-top: 65px;
  }


  .vhl-footer__content {
    grid-template-columns: 1fr;

    gap: 65px;
  }


  .vhl-footer__newsletter {
    max-width: 620px;
  }


  .vhl-footer__links {
    gap: 30px;
  }

}


/* =========================================================
   MOBILE
   ========================================================= */

@media screen and (max-width: 749px) {

  .vhl-footer__usp {
    min-height: 0;

    grid-template-columns: repeat(2, 1fr);

    gap: 0;

    padding: 0;
  }


  .vhl-footer__usp div {
    min-height: 65px;

    display: flex;

    align-items: center;
    justify-content: center;

    padding: 12px 14px;

    border-bottom: 1px solid #eeeeee;

    font-size: 11px;
  }


  .vhl-footer__usp div:nth-child(odd) {
    border-right: 1px solid #eeeeee;
  }


  .vhl-footer__main {
    padding: 50px 20px 0;
  }


  .vhl-footer__content {
    display: block;
  }


  .vhl-footer__newsletter h2 {
    margin-bottom: 22px;

    font-size: 30px;
  }


  .vhl-footer__newsletter-text {
    margin-bottom: 28px;

    font-size: 14px;
  }


  .vhl-footer__input-wrap input {
    height: 50px;

    padding: 0 18px;
  }


  .vhl-footer__input-wrap button {
    min-width: 105px;
    height: 50px;

    padding: 0 18px;

    font-size: 12px;
  }


  .vhl-footer__small {
    margin-top: 25px;

    font-size: 11px;
  }


  .vhl-footer__links {
    margin-top: 55px;

    grid-template-columns: repeat(2, minmax(0, 1fr));

    gap: 45px 25px;
  }


  .vhl-footer__column h3 {
    margin-bottom: 20px;

    font-size: 14px;
  }


  .vhl-footer__column a {
    margin-bottom: 14px;

    font-size: 12px;
  }


  .vhl-footer__payments {
    margin: 55px auto 35px;

    gap: 8px;
  }


  .vhl-payment {
    width: 49px;
    height: 31px;
  }


  .vhl-footer__bottom {
    min-height: 0;

    flex-direction: column;

    align-items: flex-start;

    gap: 22px;

    padding: 25px 0 35px;

    font-size: 11px;
  }


  .vhl-footer__legal {
    justify-content: flex-start;

    gap: 14px 22px;
  }

}

</style>


{% schema %}
{
  "name": "VHL Footer",
  "settings": [],
  "presets": [
    {
      "name": "VHL Footer"
    }
  ]
}
{% endschema %}