{% comment %}
  VHL FAQ
  - FAQ accordion
  - Directe link naar de VHL installatiepagina
  - Selecteer de installatiepagina in de Shopify Theme Editor
{% endcomment %}

<section id="VhlFaq-{{ section.id }}" class="vhl-faq">
  <div class="vhl-faq__inner">
    <header class="vhl-faq__header">
      <h2>{{ section.settings.heading | escape }}</h2>
      {% if section.settings.subheading != blank %}
        <p>{{ section.settings.subheading | escape }}</p>
      {% endif %}
    </header>

    <div class="vhl-faq__card">
      {% for block in section.blocks %}
        <details class="vhl-faq__item" {% if forloop.first %}open{% endif %} {{ block.shopify_attributes }}>
          <summary>
            <span>{{ block.settings.question | escape }}</span>
            <span class="vhl-faq__toggle" aria-hidden="true">
              <svg viewBox="0 0 20 20" fill="none">
                <path d="M6 8l4 4 4-4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </span>
          </summary>

          <div class="vhl-faq__answer rte">
            {{ block.settings.answer }}

            {% if block.settings.show_video_link %}
              <p class="vhl-faq__video-line">
                Bekijk de
                {% if section.settings.installation_page != blank %}
                  {% assign vhl_installation_handle = section.settings.installation_page.handle | default: section.settings.installation_page %}
                  <a
                    class="vhl-faq__video-trigger"
                    href="{{ routes.pages_url }}/{{ vhl_installation_handle }}"
                  >video</a>
                {% else %}
                  <span class="vhl-faq__video-trigger vhl-faq__video-trigger--disabled">video</span>
                {% endif %}
                voor instructies
              </p>
            {% endif %}
          </div>
        </details>
      {% endfor %}
    </div>
  </div>

</section>

<style>
  #VhlFaq-{{ section.id }} {
    --vhl-faq-bg: #f4f4f4;
    --vhl-faq-text: #171717;
    --vhl-faq-line: #d6d6d6;
    color: var(--vhl-faq-text);
    padding: 92px 24px 110px;
  }

  #VhlFaq-{{ section.id }} * {
    box-sizing: border-box;
  }

  #VhlFaq-{{ section.id }} .vhl-faq__inner {
    width: min(1320px, 100%);
    margin: 0 auto;
  }

  #VhlFaq-{{ section.id }} .vhl-faq__header {
    text-align: center;
    margin-bottom: 64px;
  }

  #VhlFaq-{{ section.id }} .vhl-faq__header h2 {
    margin: 0;
    color: #111;
    font-size: clamp(46px, 4.3vw, 72px);
    line-height: .95;
    font-weight: 800;
    letter-spacing: -2px;
  }

  #VhlFaq-{{ section.id }} .vhl-faq__header p {
    margin: 48px 0 0;
    color: #222;
    font-size: 25px;
    line-height: 1.25;
  }

  #VhlFaq-{{ section.id }} .vhl-faq__card {
    background: var(--vhl-faq-bg);
    border-radius: 22px;
    padding: 26px 72px;
  }

  #VhlFaq-{{ section.id }} .vhl-faq__item {
    border-bottom: 1px solid var(--vhl-faq-line);
  }

  #VhlFaq-{{ section.id }} .vhl-faq__item:last-child {
    border-bottom: 0;
  }

  #VhlFaq-{{ section.id }} .vhl-faq__item summary {
    list-style: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    cursor: pointer;
    padding: 27px 0;
    color: #181818;
    font-size: 20px;
    line-height: 1.3;
    font-weight: 700;
  }

  #VhlFaq-{{ section.id }} .vhl-faq__item summary::-webkit-details-marker {
    display: none;
  }

  #VhlFaq-{{ section.id }} .vhl-faq__toggle {
    flex: 0 0 38px;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    color: #fff;
    background: #181818;
  }

  #VhlFaq-{{ section.id }} .vhl-faq__toggle svg {
    width: 15px;
    height: 15px;
    transition: transform .2s ease;
  }

  #VhlFaq-{{ section.id }} details[open] .vhl-faq__toggle svg {
    transform: rotate(180deg);
  }

  #VhlFaq-{{ section.id }} .vhl-faq__answer {
    padding: 0 58px 28px 0;
    color: #242424;
    font-size: 18px;
    line-height: 1.55;
  }

  #VhlFaq-{{ section.id }} .vhl-faq__answer p {
    margin: 0 0 22px;
  }

  #VhlFaq-{{ section.id }} .vhl-faq__answer p:last-child {
    margin-bottom: 0;
  }

  #VhlFaq-{{ section.id }} .vhl-faq__video-line {
    margin-top: 30px !important;
  }

  #VhlFaq-{{ section.id }} .vhl-faq__video-trigger {
    padding: 0;
    margin: 0;
    color: inherit;
    font: inherit;
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 2px;
    cursor: pointer;
  }

  #VhlFaq-{{ section.id }} .vhl-faq__video-trigger--disabled {
    cursor: default;
  }

  @media screen and (max-width: 749px) {
    #VhlFaq-{{ section.id }} {
      padding: 58px 16px 72px;
    }

    #VhlFaq-{{ section.id }} .vhl-faq__header {
      margin-bottom: 38px;
    }

    #VhlFaq-{{ section.id }} .vhl-faq__header h2 {
      font-size: 46px;
      letter-spacing: -1.5px;
    }

    #VhlFaq-{{ section.id }} .vhl-faq__header p {
      margin-top: 25px;
      font-size: 19px;
    }

    #VhlFaq-{{ section.id }} .vhl-faq__card {
      border-radius: 16px;
      padding: 14px 22px;
    }

    #VhlFaq-{{ section.id }} .vhl-faq__item summary {
      padding: 22px 0;
      font-size: 16px;
    }

    #VhlFaq-{{ section.id }} .vhl-faq__toggle {
      flex-basis: 32px;
      width: 32px;
      height: 32px;
    }

    #VhlFaq-{{ section.id }} .vhl-faq__answer {
      padding: 0 0 24px;
      font-size: 15px;
    }
  }
</style>


{% schema %}
{
  "name": "VHL FAQ",
  "tag": "section",
  "class": "section-vhl-faq",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Titel",
      "default": "FAQ"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Ondertitel",
      "default": "Vragen? Wij hebben het antwoord."
    },
    {
      "type": "page",
      "id": "installation_page",
      "label": "Installatiepagina"
    }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "FAQ vraag",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Vraag",
          "default": "Vraag"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Antwoord",
          "default": "<p>Antwoord</p>"
        },
        {
          "type": "checkbox",
          "id": "show_video_link",
          "label": "Toon installatievideo-link",
          "default": false
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "VHL FAQ",
      "blocks": [
        {
          "type": "faq",
          "settings": {
            "question": "Waar kan ik de zuignaphaak installeren?",
            "answer": "<p>Je kan onze zuignaphaken op alle gladde oppervlaktes installeren. Denk aan: Glas, tegels, kastdeuren, ...</p>"
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "Hoeveel gewicht kan het dragen?",
            "answer": "<p>De VHL zuignaphaak kan 7kg+ dragen door zijn gepatenteerde zuignaptechniek/montagesysteem.</p>"
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "Waarin verschilt deze haak van andere zuignaphaken?",
            "answer": "<p>Onze gepatenteerde zuignappen werken op een manier waarbij de lucht draaiend gewijs weggezogen wordt.</p><p>Hierdoor ontstaat er een drukafdichting tussen de zwarte rubberen basis en het montageoppervlak.</p><p>Dit resulteert daarom ook in een opmerkelijke draagsterkte & gepaard met het elegante design een must-have product!</p>"
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "Hoe installeer ik de zuignaphaak?",
            "answer": "<p>Dankzij het innovatieve vacuümzuigsysteem is de installatie zo gebeurd. In tegenstelling tot andere muurbevestigde of zelfklevende haken, kunnen de VHL zuignaphaken gemakkelijk worden verwijderd zonder gaten, vlekken of kleverige resten achter te laten!</p><p>1) Kies het gewenste oppervlak voor jouw zuignaphaak</p><p>2) Maak het oppervlak schoon met een doekje (+alcohol)</p><p>3) Maak de 'schroef' los en bevestig de basis in een volle beweging op het oppervlak.</p><p>4) Druk de basis stevig aan tegen het oppervlak en schroef vast</p><p><strong><em>5) Eventuele stap:</em></strong> <em>Schroef geleidelijk aan voor de komende 24u zonder gewichtsdruk.</em></p>",
            "show_video_link": true
          }
        }
      ]
    }
  ]
}
{% endschema %}
