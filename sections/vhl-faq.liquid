{% comment %}
  VHL FAQ
  - Compacte ROHA-style desktop compositie
  - Directe vaste link naar /pages/installatie
{% endcomment %}

<section id="VhlFaq-{{ section.id }}" class="vhl-faq">
  <div class="vhl-faq__inner">
    <header class="vhl-faq__header">
      <h2>{{ section.settings.heading | escape }}</h2>
      {% if section.settings.subheading != blank %}
        <p>{{ section.settings.subheading | escape }}</p>
      {% endif %}
    </header>

    <div class="vhl-faq__card">
      {% for block in section.blocks %}
        <details class="vhl-faq__item" {{ block.shopify_attributes }}>
          <summary>
            <span>{{ block.settings.question | escape }}</span>
            <span class="vhl-faq__toggle" aria-hidden="true">
              <svg viewBox="0 0 20 20" fill="none">
                <path d="M6 8l4 4 4-4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </span>
          </summary>

          <div class="vhl-faq__answer rte">
            {{ block.settings.answer }}
            {% if block.settings.show_video_link %}
              <p class="vhl-faq__video-line">
                <a href="/pages/installatie" class="vhl-faq__video-trigger">Bekijk de video voor instructies</a>
              </p>
            {% endif %}
          </div>
        </details>
      {% endfor %}
    </div>
  </div>
</section>

<style>
  #VhlFaq-{{ section.id }} {
    --vhl-faq-bg: #f4f4f4;
    --vhl-faq-text: #171717;
    --vhl-faq-line: #d6d6d6;
    position: relative;
    z-index: 2;
    isolation: isolate;
    color: var(--vhl-faq-text);
    padding: 92px 24px 104px;
  }

  #VhlFaq-{{ section.id }} * { box-sizing: border-box; }

  #VhlFaq-{{ section.id }} .vhl-faq__inner {
    width: 100%;
    margin: 0 auto;
  }

  #VhlFaq-{{ section.id }} .vhl-faq__header {
    text-align: center;
    margin: 0 0 57px;
  }

  #VhlFaq-{{ section.id }} .vhl-faq__header h2 {
    margin: 0;
    color: #111;
    font-size: 50px;
    line-height: 1;
    font-weight: 800;
    letter-spacing: -1.6px;
  }

  #VhlFaq-{{ section.id }} .vhl-faq__header p {
    margin: 42px 0 0;
    color: #222;
    font-size: 20px;
    line-height: 1.25;
    font-weight: 400;
  }

  #VhlFaq-{{ section.id }} .vhl-faq__card {
    width: min(914px, 100%);
    margin: 0 auto;
    background: var(--vhl-faq-bg);
    border-radius: 15px;
    padding: 17px 55px;
  }

  #VhlFaq-{{ section.id }} .vhl-faq__item {
    border-bottom: 1px solid var(--vhl-faq-line);
  }

  #VhlFaq-{{ section.id }} .vhl-faq__item:last-child { border-bottom: 0; }

  #VhlFaq-{{ section.id }} .vhl-faq__item summary {
    list-style: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    cursor: pointer;
    padding: 17px 0;
    color: #181818;
    font-size: 15px;
    line-height: 1.3;
    font-weight: 700;
  }

  #VhlFaq-{{ section.id }} .vhl-faq__item summary::-webkit-details-marker { display: none; }

  #VhlFaq-{{ section.id }} .vhl-faq__toggle {
    flex: 0 0 18px;
    width: 18px;
    height: 18px;
    display: grid;
    place-items: center;
    color: #111;
    background: transparent;
  }

  #VhlFaq-{{ section.id }} .vhl-faq__toggle svg {
    width: 11px;
    height: 11px;
    transition: transform .2s ease;
  }

  #VhlFaq-{{ section.id }} details[open] .vhl-faq__toggle svg {
    transform: rotate(180deg);
  }

  #VhlFaq-{{ section.id }} .vhl-faq__answer {
    padding: 0 36px 18px 0;
    color: #242424;
    font-size: 14px;
    line-height: 1.55;
  }

  #VhlFaq-{{ section.id }} .vhl-faq__answer p { margin: 0 0 14px; }
  #VhlFaq-{{ section.id }} .vhl-faq__answer p:last-child { margin-bottom: 0; }

  #VhlFaq-{{ section.id }} .vhl-faq__video-line {
    margin-top: 20px !important;
  }

  #VhlFaq-{{ section.id }} .vhl-faq__video-trigger {
    color: inherit;
    font: inherit;
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 2px;
    cursor: pointer;
  }

  @media screen and (max-width: 749px) {
    #VhlFaq-{{ section.id }} { padding: 58px 16px 72px; }

    #VhlFaq-{{ section.id }} .vhl-faq__header {
      margin-bottom: 38px;
    }

    #VhlFaq-{{ section.id }} .vhl-faq__header h2 {
      font-size: 42px;
      letter-spacing: -1.3px;
    }

    #VhlFaq-{{ section.id }} .vhl-faq__header p {
      margin-top: 24px;
      font-size: 18px;
    }

    #VhlFaq-{{ section.id }} .vhl-faq__card {
      width: 100%;
      border-radius: 14px;
      padding: 12px 22px;
    }

    #VhlFaq-{{ section.id }} .vhl-faq__item summary {
      padding: 20px 0;
      font-size: 15px;
    }

    #VhlFaq-{{ section.id }} .vhl-faq__answer {
      padding: 0 0 22px;
      font-size: 14px;
    }
  }
</style>

{% schema %}
{
  "name": "VHL FAQ",
  "tag": "section",
  "class": "section-vhl-faq",
  "settings": [
    {"type":"text","id":"heading","label":"Titel","default":"FAQ"},
    {"type":"text","id":"subheading","label":"Ondertitel","default":"Vragen? Wij hebben het antwoord."}
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "FAQ vraag",
      "settings": [
        {"type":"text","id":"question","label":"Vraag","default":"Vraag"},
        {"type":"richtext","id":"answer","label":"Antwoord","default":"<p>Antwoord</p>"},
        {"type":"checkbox","id":"show_video_link","label":"Toon installatievideo-link","default":false}
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [{"name":"VHL FAQ"}]
}
{% endschema %}
