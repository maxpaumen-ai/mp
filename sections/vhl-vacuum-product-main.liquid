            { "value": "vertical", "label": "Vertical" },
            { "value": "horizontal", "label": "Horizontal" }
          ],
          "default": "vertical"
        },
        {
          "type": "color",
          "id": "icon_color",
          "label": "Icon color",
          "default": "#262625"
        },
        {
          "type": "color",
          "id": "text_color",
          "label": "Text color",
          "default": "#1a1a1a"
        },
        {
          "type": "range",
          "id": "icon_size",
