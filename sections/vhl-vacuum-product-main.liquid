{%- comment -%}
  VHL Vacuum Hook PDP — main above-the-fold section.

  Geïsoleerde, product-specifieke PDP-sectie voor "RVS vacuümzuignap haak".
  Alleen gebruikt door templates/product.vacuum-hook.json.

  Herbruikte, ONGEWIJZIGDE bestaande componenten:
  - snippets/product-gallery.liquid   (gallery + thumbnails + variant images)
  - snippets/product-info.liquid      (title / price / variant picker / quantity / add-to-cart
                                        blocks — dezelfde code die de standaard-PDP gebruikt,
                                        dus hetzelfde, geteste cart-formulier)
  - assets/shop-product-details.css   (basisstyling voor bovenstaande, alleen gelinkt, niet gewijzigd)
  - assets/product-gallery.js, product-info.js, variant-selector.js,
    product-form.js, shop-product-details.js (ongewijzigde, gedeelde scripts)

  BELANGRIJK: de root-div behoudt de klasse `vhl-vacuum-pdp` (naast de
  nieuwe, semantische `vhl-vacuum-above-fold`) omdat
  sections/vhl-vacuum-sticky-atc.liquid zijn echte-formulier-proxy hierop
  baseert (`.vhl-vacuum-pdp .shop-add-to-cart-wrapper`). Die sectie wordt
  in deze wijziging niet aangeraakt (0 diff), dus deze klasse blijft
  staan zodat de sticky-ATC-koppeling intact blijft.

  Alle eigen styling staat scoped onder .vhl-vacuum-pdp zodat niets naar
  de bestaande PDP of andere pagina's kan lekken.
{%- endcomment -%}

{{ 'shop-product-details.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign has_rating = false
  if product.metafields.reviews.rating.value != blank
    assign has_rating = true
  endif

  assign has_shipping_info = false
  if shop.policies.shipping_policy.body != blank or shop.policies.refund_policy.body != blank
    assign has_shipping_info = true
  endif

  assign has_trust_block = false
  if section.settings.trust_heading != blank or section.settings.trust_body != blank
    assign has_trust_block = true
  endif
-%}

<div class="vhl-vacuum-pdp vhl-vacuum-above-fold shop-product-section" {{ section.shopify_attributes }}>
  <div class="vhl-vacuum-above-fold__grid">

    <div class="vhl-vacuum-above-fold__gallery">
      {% render 'product-gallery',
        product: product,
        show_product_variants: true,
        current_variant: current_variant,
        enable_image_zoom: true
      %}
    </div>

    <div class="vhl-vacuum-above-fold__panel shop-product-info">

      {% if has_rating %}
        <div
          class="rating vhl-vacuum-pdp__rating"
          role="img"
          aria-label="{{ 'accessibility.star_reviews_info' | t: rating_value: product.metafields.reviews.rating.value, rating_max: product.metafields.reviews.rating.value.scale_max }}"
        >
          <span
            aria-hidden="true"
            class="rating-star"
            style="--rating: {{ product.metafields.reviews.rating.value.rating | floor }}; --rating-max: {{ product.metafields.reviews.rating.value.scale_max }};"
          ></span>
          <span class="vhl-vacuum-pdp__rating-text">
            {{- product.metafields.reviews.rating.value }} / {{ product.metafields.reviews.rating.value.scale_max -}}
            {% if product.metafields.reviews.rating_count %}
              &middot; {{ product.metafields.reviews.rating_count }} beoordelingen
            {% endif %}
          </span>
        </div>
      {% endif %}

      {% render 'product-info', product: product, section: section %}

      <div class="vhl-vacuum-pdp__trust-payments-row">
        <span class="vhl-vacuum-pdp__trust-payments" aria-label="Betaalmethoden">
          {{ 'master' | payment_type_svg_tag }}
          {{ 'visa' | payment_type_svg_tag }}
          {{ 'apple_pay' | payment_type_svg_tag }}
          {{ 'shopify_pay' | payment_type_svg_tag }}
        </span>
      </div>

      {% if has_trust_block %}
        <div class="vhl-vacuum-pdp__trust-card">
          {% if section.settings.trust_badge_text != blank %}
            <span class="vhl-vacuum-pdp__trust-badge">{{ section.settings.trust_badge_text }}</span>
          {% endif %}
          {% if section.settings.trust_heading != blank %}
            <p class="vhl-vacuum-pdp__trust-heading">{{ section.settings.trust_heading }}</p>
          {% endif %}
          {% if section.settings.trust_body != blank %}
            <p class="vhl-vacuum-pdp__trust-body">{{ section.settings.trust_body }}</p>
          {% endif %}
        </div>
      {% endif %}

      <div class="vhl-vacuum-pdp__accordions">
        {% if product.description != blank %}
          <details class="vhl-vacuum-pdp__accordion">
            <summary>Productdetails</summary>
            <div class="vhl-vacuum-pdp__accordion-body">{{ product.description }}</div>
          </details>
        {% endif %}

        {% if has_shipping_info %}
          <details class="vhl-vacuum-pdp__accordion">
            <summary>Verzending &amp; retourneren</summary>
            <div class="vhl-vacuum-pdp__accordion-body">
              {% if shop.policies.shipping_policy.body != blank %}
                <p><a href="{{ shop.policies.shipping_policy.url }}">{{ shop.policies.shipping_policy.title }}</a></p>
              {% endif %}
              {% if shop.policies.refund_policy.body != blank %}
                <p><a href="{{ shop.policies.refund_policy.url }}">{{ shop.policies.refund_policy.title }}</a></p>
              {% endif %}
            </div>
          </details>
        {% endif %}
      </div>

    </div>
  </div>
</div>

{%- comment -%}
  snippets/simple-variant-picker.liquid verwacht bij een variantwissel een
  globale `originPrice` (zelfde patroon als sections/shop-product-details.liquid),
  gebaseerd op de daadwerkelijk geselecteerde/eerste beschikbare variant.
{%- endcomment -%}
<script>
  var originPrice = '{{ current_variant.price | money }}';
</script>

<script src="{{ 'product-gallery.js' | asset_url }}" defer></script>
<script src="{{ 'product-info.js' | asset_url }}" defer></script>
<script src="{{ 'variant-selector.js' | asset_url }}" defer></script>
<script src="{{ 'product-form.js' | asset_url }}" defer></script>
<script src="{{ 'shop-product-details.js' | asset_url }}" defer></script>

{% style %}
  .vhl-vacuum-pdp {
    max-width: 1420px;
    margin: 0 auto;
    padding: 20px 16px 40px;
    background: #ffffff;
  }

  .vhl-vacuum-above-fold__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 28px;
  }

  @media screen and (min-width: 990px) {
    .vhl-vacuum-pdp {
      padding: 36px 32px 56px;
    }
    .vhl-vacuum-above-fold__grid {
      grid-template-columns: 59fr 41fr;
      gap: 64px;
      align-items: start;
    }
    .vhl-vacuum-above-fold__panel {
      position: sticky;
      top: 96px;
    }
  }

  /*
    ROOT CAUSE (nog steeds van toepassing na de hernoeming): het gedeelde,
    ongewijzigde assets/shop-product-details.css geeft .shop-carousel-container
    (gerenderd door het herbruikte snippets/product-gallery.liquid) en
    .shop-product-info (klasse op ons purchase-panel, nodig voor overige
    geërfde styling) een EIGEN, vaste max-width/flex-basis van 45-55%,
    ontworpen voor de situatie waarin ze DIRECTE flex-children zijn van
    .shop-product-layout op 100% breedte. Eén niveau dieper, ín onze eigen
    grid-kolommen, werd die 45-55% een TWEEDE keer toegepast bovenop de
    kolombreedte. Deze drie regels maken onze eigen grid-kolombreedte de
    enige breedtebron (hogere selector-specificiteit dan de gedeelde
    single-class-regels, dus geen !important nodig).
  */
  .vhl-vacuum-pdp .shop-carousel-container {
    max-width: 100%;
    flex: 1 1 auto;
  }

  .vhl-vacuum-pdp .shop-product-info {
    max-width: 100%;
    flex: 1 1 auto;
  }

  .vhl-vacuum-pdp .shop-product-carousel {
    width: 100%;
  }

  .vhl-vacuum-pdp .shop-main-image-wrapper,
  .vhl-vacuum-pdp .shop-image-container {
    border-radius: 12px !important;
    background: #f7f5f2;
  }

  .vhl-vacuum-pdp .shop-thumbnail {
    border-radius: 8px !important;
    overflow: hidden;
  }

  /*
    Verticale thumbnailkolom links van de hoofdafbeelding op desktop.
    Geactiveerd via de bestaande, ongewijzigde
    snippets/product-gallery.liquid + assets/shop-product-details.css
    (section.settings.thumbnails_left_column_desktop), hier alleen
    scoped aangevuld met de daadwerkelijke naast-elkaar-layout. Behouden
    ongewijzigd t.o.v. de vorige, werkende versie.
  */
  @media screen and (min-width: 990px) {
    .vhl-vacuum-pdp .shop-main-image-wrapper.shop-image-thumbnails-row {
      display: flex;
      flex-direction: row;
      align-items: flex-start;
      gap: 22px;
    }

    .vhl-vacuum-pdp .shop-thumbnails-outer {
      flex: 0 0 auto;
      width: 76px;
      margin: 0 !important;
    }

    .vhl-vacuum-pdp .shop-thumbnails-wrapper.left-column-layout {
      display: flex;
      flex-direction: column;
    }

    .vhl-vacuum-pdp .shop-thumbnails-wrapper.left-column-layout .shop-thumbnails {
      display: flex;
      flex-direction: column;
      flex-wrap: nowrap;
      gap: 10px;
      max-height: 560px;
      overflow-y: auto;
      overflow-x: hidden;
    }

    .vhl-vacuum-pdp .shop-thumbnails-wrapper.left-column-layout .shop-thumbnail {
      width: 64px;
      height: 64px;
    }

    .vhl-vacuum-pdp .shop-image-container {
      flex: 1 1 auto;
      min-width: 0;
    }
  }

  /*
    Purchase panel: EÉN vlakke kolom. De volgorde komt nu uitsluitend uit
    de brontekst (DOM), niet meer uit CSS `order`:
    - de reviewsamenvatting staat vóór de product-info render-call hierboven;
    - title/price/USP's/variant/aantal/ATC komen, in die volgorde, uit
      block_order in templates/product.vacuum-hook.json (title_main,
      price_main, usps_main, variant_picker_main, quantity_main,
      add_to_cart_main) — dezelfde volgorde die hier gewenst is, dus geen
      CSS-truc meer nodig om dit recht te zetten;
    - betaalregel/trust-card/accordions staan ná die render-call.
    Dit is bewust minder fragiel dan de eerdere flexbox `order`-aanpak.
  */
  .vhl-vacuum-above-fold__panel {
    display: flex;
    flex-direction: column;
  }

  .vhl-vacuum-pdp__rating {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0 0 10px;
  }

  .vhl-vacuum-pdp__rating-text {
    font-size: 13px;
    color: #6b6b68;
  }

  .vhl-vacuum-pdp .shop-product-title {
    font-size: 26px !important;
    letter-spacing: 0.2px;
    margin-bottom: 6px !important;
  }

  @media screen and (min-width: 990px) {
    .vhl-vacuum-pdp .shop-product-title {
      font-size: 30px !important;
    }
  }

  .vhl-vacuum-pdp .shop-product-price-container {
    margin-bottom: 4px !important;
  }

  .vhl-vacuum-pdp .product-bullet-list {
    margin-top: 14px !important;
    margin-bottom: 4px !important;
    padding-top: 14px;
    padding-bottom: 2px;
    border-top: 1px solid #eceae5;
  }

  .vhl-vacuum-pdp .simple-variant-picker {
    margin-top: 18px;
    max-width: 100%;
  }

  /*
    Bescherming tegen lange, geïmporteerde variantnamen: laat opties
    wrappen i.p.v. de rechterkolom horizontaal te forceren, en houd de
    opties compact (kleine pills/swatches i.p.v. grote losse knoppen).
  */
  .vhl-vacuum-pdp .simple-variant-picker__values {
    flex-wrap: wrap !important;
    max-width: 100%;
  }

  .vhl-vacuum-pdp .simple-variant-picker__value-container,
  .vhl-vacuum-pdp .simple-variant-picker label {
    max-width: 100%;
    white-space: normal !important;
    word-break: break-word;
  }

  /*
    Aantal: bewust compact en smal, direct boven de ATC — geen los, groot
    blok bovenaan de kolom. De brontekst-volgorde (block_order) plaatst
    dit element al na de variantkeuze en vóór de ATC-knop.
  */
  .vhl-vacuum-pdp .modern-quantity-selector {
    margin-top: 14px;
    margin-bottom: 0;
    max-width: 130px;
  }

  .vhl-vacuum-pdp .shop-add-to-cart-wrapper {
    margin-top: 12px;
  }

  .vhl-vacuum-pdp .shop-add-to-cart-button {
    width: 100%;
    min-height: 56px;
    border-radius: 999px !important;
    box-shadow: none !important;
    text-transform: none !important;
    letter-spacing: 0.3px !important;
  }

  .vhl-vacuum-pdp__trust-payments-row {
    margin-top: 18px;
    padding-top: 16px;
    border-top: 1px solid #eceae5;
  }

  .vhl-vacuum-pdp__trust-payments {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
  }

  .vhl-vacuum-pdp__trust-payments svg {
    height: 24px;
    width: auto;
  }

  .vhl-vacuum-pdp__trust-card {
    margin-top: 18px;
    padding: 20px;
    border: 1px solid #e5e0d8;
    border-radius: 12px;
    background: #faf8f5;
    text-align: center;
  }

  .vhl-vacuum-pdp__trust-badge {
    display: inline-flex;
    align-items: center;
    padding: 5px 12px;
    border-radius: 999px;
    background: #ffffff;
    border: 1px solid #e5e0d8;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #6b6b68;
    margin-bottom: 10px;
  }

  .vhl-vacuum-pdp__trust-heading {
    margin: 0 0 6px;
    font-size: 17px;
    font-weight: 600;
    color: #1a1a1a;
  }

  .vhl-vacuum-pdp__trust-body {
    margin: 0;
    font-size: 13px;
    line-height: 1.6;
    color: #6b6b68;
  }

  /*
    Accordions staan nu IN de rechterkolom, direct onder de trust-zone —
    niet meer als los, open, volle-breedte blok onder de gallery.
    Standaard dichtgeklapt (geen `open`-attribuut meer).
  */
  .vhl-vacuum-pdp__accordions {
    margin-top: 22px;
  }

  .vhl-vacuum-pdp__accordion {
    border-top: 1px solid #eceae5;
  }

  .vhl-vacuum-pdp__accordion:last-child {
    border-bottom: 1px solid #eceae5;
  }

  .vhl-vacuum-pdp__accordion summary {
    cursor: pointer;
    list-style: none;
    padding: 14px 2px;
    font-size: 14px;
    font-weight: 600;
    color: #1a1a1a;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .vhl-vacuum-pdp__accordion summary::-webkit-details-marker {
    display: none;
  }

  .vhl-vacuum-pdp__accordion summary::after {
    content: '+';
    font-weight: 400;
    font-size: 18px;
    color: #6b6b68;
  }

  .vhl-vacuum-pdp__accordion[open] summary::after {
    content: '\2212';
  }

  .vhl-vacuum-pdp__accordion-body {
    padding: 0 2px 16px;
    font-size: 13px;
    line-height: 1.7;
    color: #4a4a47;
  }

  .vhl-vacuum-pdp__accordion-body a {
    color: #1a1a1a;
    text-decoration: underline;
  }
{% endstyle %}

{% schema %}
{
  "name": "VHL Vacuumhaak PDP",
  "tag": "section",
  "class": "vhl-vacuum-pdp-section",
  "settings": [
    {
      "type": "header",
      "content": "Gallery"
    },
    {
      "type": "checkbox",
      "id": "thumbnails_left_column_desktop",
      "label": "Thumbnails verticaal links (desktop)",
      "default": true
    },
    {
      "type": "header",
      "content": "Trust / value card (optioneel)"
    },
    {
      "type": "text",
      "id": "trust_badge_text",
      "label": "Badge tekst (optioneel)"
    },
    {
      "type": "text",
      "id": "trust_heading",
      "label": "Titel (optioneel, leeg = kaart verborgen)"
    },
    {
      "type": "textarea",
      "id": "trust_body",
      "label": "Tekst (optioneel)"
    }
  ],
  "blocks": [
    {
      "type": "title",
      "name": "Titel",
      "limit": 1,
      "settings": [
        {
          "type": "range",
          "id": "font_size",
          "min": 16,
          "max": 48,
          "step": 1,
          "default": 28,
          "label": "Font size (px)"
        },
        {
          "type": "range",
          "id": "margin_top",
          "min": -20,
          "max": 20,
          "step": 1,
          "default": 0,
          "label": "Top margin (px)"
        },
        {
          "type": "range",
          "id": "margin_bottom",
          "min": -20,
          "max": 20,
          "step": 1,
          "default": 8,
          "label": "Bottom margin (px)"
        },
        {
          "type": "color",
          "id": "title_color",
          "label": "Title color",
          "default": "#1a1a1a"
        },
        {
          "type": "range",
          "id": "line_height",
          "min": 0.8,
          "max": 2,
          "step": 0.1,
          "default": 1.2,
          "label": "Line height"
        }
      ]
    },
    {
      "type": "price",
      "name": "Prijs",
      "limit": 1,
      "settings": [
        {
          "type": "checkbox",
          "id": "multiply_price_by_quantity",
          "label": "Multiply price by quantity",
          "default": true
        },
        {
          "type": "checkbox",
          "id": "apply_selected_subscription_discount",
          "label": "Apply selected subscription discount",
          "default": true
        },
        {
          "type": "color",
          "id": "price_color",
          "label": "Price color",
          "default": "#1a1a1a"
        },
        {
          "type": "color",
          "id": "compare_price_color",
          "label": "Compare price color",
          "default": "#9c9c9c"
        },
        {
          "type": "color",
          "id": "sale_badge_bg_color",
          "label": "Sale badge background",
          "default": "#262625"
        },
        {
          "type": "color",
          "id": "sale_badge_text_color",
          "label": "Sale badge text",
          "default": "#ffffff"
        },
        {
          "type": "checkbox",
          "id": "show_save_badge",
          "label": "Show Save Badge",
          "default": true
        },
        {
          "type": "range",
          "id": "price_font_size",
          "min": 14,
          "max": 36,
          "step": 1,
          "default": 26,
          "label": "Price font size (px)"
        },
        {
          "type": "range",
          "id": "compare_price_font_size",
          "min": 12,
          "max": 24,
          "step": 1,
          "default": 16,
          "label": "Compare price font size (px)"
        },
        {
