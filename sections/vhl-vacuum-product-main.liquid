{%- comment -%}
  VHL Vacuum Hook PDP — main section.

  Geïsoleerde, product-specifieke PDP-sectie voor "RVS vacuümzuignap haak".
  Alleen gebruikt door templates/product.vacuum-hook.json.

  Herbruikte, ONGEWIJZIGDE bestaande componenten:
  - snippets/product-gallery.liquid   (gallery + thumbnails + variant images)
  - snippets/product-info.liquid      (title / price / variant picker / quantity / add-to-cart
                                        blocks — dezelfde code die de standaard-PDP gebruikt,
                                        dus hetzelfde, geteste cart-formulier)
  - assets/shop-product-details.css   (basisstyling voor bovenstaande, alleen gelinkt, niet gewijzigd)
  - assets/product-gallery.js, product-info.js, variant-selector.js,
    product-form.js, shop-product-details.js (ongewijzigde, gedeelde scripts)

  Alle eigen, nieuwe styling staat scoped onder .vhl-vacuum-pdp zodat niets
  naar de bestaande PDP of andere pagina's kan lekken.
{%- endcomment -%}

{{ 'shop-product-details.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign has_rating = false
  if product.metafields.reviews.rating.value != blank
    assign has_rating = true
  endif

  assign short_intro = product.description | strip_html | truncatewords: 28

  assign has_specs = false
  if product.type != blank or product.tags.size > 0
    assign has_specs = true
  endif

  assign has_shipping_info = false
  if shop.policies.shipping_policy.body != blank or shop.policies.refund_policy.body != blank
    assign has_shipping_info = true
  endif
-%}

<div class="vhl-vacuum-pdp shop-product-section" {{ section.shopify_attributes }}>
  <div class="vhl-vacuum-pdp__grid">

    <div class="vhl-vacuum-pdp__gallery">
      {% render 'product-gallery',
        product: product,
        show_product_variants: true,
        current_variant: current_variant,
        enable_image_zoom: true
      %}
    </div>

    <div class="vhl-vacuum-pdp__buybox shop-product-info">

      {% render 'product-info', product: product, section: section %}

      {% if has_rating %}
        <div
          class="rating vhl-vacuum-pdp__rating"
          role="img"
          aria-label="{{ 'accessibility.star_reviews_info' | t: rating_value: product.metafields.reviews.rating.value, rating_max: product.metafields.reviews.rating.value.scale_max }}"
        >
          <span
            aria-hidden="true"
            class="rating-star"
            style="--rating: {{ product.metafields.reviews.rating.value.rating | floor }}; --rating-max: {{ product.metafields.reviews.rating.value.scale_max }};"
          ></span>
          <span class="vhl-vacuum-pdp__rating-text">
            {{- product.metafields.reviews.rating.value }} / {{ product.metafields.reviews.rating.value.scale_max -}}
            {% if product.metafields.reviews.rating_count %}
              ({{ product.metafields.reviews.rating_count }})
            {% endif %}
          </span>
        </div>
      {% endif %}

      {% if short_intro != blank %}
        <p class="vhl-vacuum-pdp__intro">{{ short_intro }}</p>
      {% endif %}

      <div class="vhl-vacuum-pdp__trust">
        <span class="vhl-vacuum-pdp__trust-payments" aria-label="Betaalmethoden">
          {{ 'master' | payment_type_svg_tag }}
          {{ 'visa' | payment_type_svg_tag }}
          {{ 'apple_pay' | payment_type_svg_tag }}
          {{ 'shopify_pay' | payment_type_svg_tag }}
        </span>
      </div>

    </div>
  </div>

  <div class="vhl-vacuum-pdp__accordions">
    {% if product.description != blank %}
      <details class="vhl-vacuum-pdp__accordion" open>
        <summary>Details</summary>
        <div class="vhl-vacuum-pdp__accordion-body">{{ product.description }}</div>
      </details>
    {% endif %}

    {% if has_specs %}
      <details class="vhl-vacuum-pdp__accordion">
        <summary>Specificaties</summary>
        <div class="vhl-vacuum-pdp__accordion-body">
          <ul class="vhl-vacuum-pdp__spec-list">
            {% if product.type != blank %}
              <li><span>Type</span><span>{{ product.type }}</span></li>
            {% endif %}
            {% for tag in product.tags %}
              <li><span>Kenmerk</span><span>{{ tag }}</span></li>
            {% endfor %}
          </ul>
        </div>
      </details>
    {% endif %}

    {% if has_shipping_info %}
      <details class="vhl-vacuum-pdp__accordion">
        <summary>Verzending &amp; retourneren</summary>
        <div class="vhl-vacuum-pdp__accordion-body">
          {% if shop.policies.shipping_policy.body != blank %}
            <p><a href="{{ shop.policies.shipping_policy.url }}">{{ shop.policies.shipping_policy.title }}</a></p>
          {% endif %}
          {% if shop.policies.refund_policy.body != blank %}
            <p><a href="{{ shop.policies.refund_policy.url }}">{{ shop.policies.refund_policy.title }}</a></p>
          {% endif %}
        </div>
      </details>
    {% endif %}
  </div>
</div>

<script src="{{ 'product-gallery.js' | asset_url }}" defer></script>
<script src="{{ 'product-info.js' | asset_url }}" defer></script>
<script src="{{ 'variant-selector.js' | asset_url }}" defer></script>
<script src="{{ 'product-form.js' | asset_url }}" defer></script>
<script src="{{ 'shop-product-details.js' | asset_url }}" defer></script>

{% style %}
  .vhl-vacuum-pdp {
    max-width: 1400px;
    margin: 0 auto;
    padding: 32px 24px 0;
    background: #ffffff;
  }

  .vhl-vacuum-pdp__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 32px;
  }

  @media screen and (min-width: 990px) {
    .vhl-vacuum-pdp {
      padding: 48px 40px 0;
    }
    .vhl-vacuum-pdp__grid {
      grid-template-columns: 58fr 42fr;
      gap: 64px;
      align-items: start;
    }
    .vhl-vacuum-pdp__buybox {
      position: sticky;
      top: 100px;
    }
  }

  .vhl-vacuum-pdp .shop-main-image-wrapper,
  .vhl-vacuum-pdp .shop-image-container {
    border-radius: 10px !important;
  }

  .vhl-vacuum-pdp .shop-thumbnail {
    border-radius: 8px !important;
    overflow: hidden;
  }

  .vhl-vacuum-pdp__buybox {
    display: flex;
    flex-direction: column;
  }

  .vhl-vacuum-pdp .shop-product-title {
    font-size: 28px !important;
    letter-spacing: 0.2px;
  }

  @media screen and (min-width: 990px) {
    .vhl-vacuum-pdp .shop-product-title {
      font-size: 32px !important;
    }
  }

  .vhl-vacuum-pdp__rating {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 4px 0 0;
  }

  .vhl-vacuum-pdp__rating-text {
    font-size: 13px;
    color: #6b6b68;
  }

  .vhl-vacuum-pdp__intro {
    margin: 12px 0 0;
    font-size: 15px;
    line-height: 1.6;
    color: #4a4a47;
    max-width: 46ch;
  }

  /*
    Vaste, expliciete volgorde in de buy-box (title -> price -> rating ->
    intro -> USP's -> variant -> aantal -> ATC -> trust), onafhankelijk van
    de render-volgorde van de herbruikte product-info blocks.
  */
  .vhl-vacuum-pdp .shop-product-title { order: 1; }
  .vhl-vacuum-pdp .shop-product-price-container { order: 2; }
  .vhl-vacuum-pdp__rating { order: 3; }
  .vhl-vacuum-pdp__intro { order: 4; }
  .vhl-vacuum-pdp .product-bullet-list { order: 5; }
  .vhl-vacuum-pdp .simple-variant-picker { order: 6; margin-top: 16px; }
  .vhl-vacuum-pdp .modern-quantity-selector { order: 7; margin-top: 4px; }
  .vhl-vacuum-pdp .shop-add-to-cart-wrapper { order: 8; margin-top: 20px; }
  .vhl-vacuum-pdp__trust { order: 9; }

  .vhl-vacuum-pdp .shop-add-to-cart-button {
    width: 100%;
    min-height: 50px;
    box-shadow: none !important;
    text-transform: none !important;
    letter-spacing: 0.3px !important;
  }

  .vhl-vacuum-pdp__trust {
    margin-top: 22px;
    padding-top: 18px;
    border-top: 1px solid #eceae5;
  }

  .vhl-vacuum-pdp__trust-payments {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .vhl-vacuum-pdp__trust-payments svg {
    height: 24px;
    width: auto;
  }

  .vhl-vacuum-pdp__accordions {
    max-width: 900px;
    margin: 48px auto 0;
    padding: 0 24px 56px;
    border-top: 1px solid #eceae5;
  }

  @media screen and (min-width: 990px) {
    .vhl-vacuum-pdp__accordions {
      padding: 0 40px 72px;
    }
  }

  .vhl-vacuum-pdp__accordion {
    border-bottom: 1px solid #eceae5;
  }

  .vhl-vacuum-pdp__accordion summary {
    cursor: pointer;
    list-style: none;
    padding: 18px 4px;
    font-size: 15px;
    font-weight: 600;
    color: #1a1a1a;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .vhl-vacuum-pdp__accordion summary::-webkit-details-marker {
    display: none;
  }

  .vhl-vacuum-pdp__accordion summary::after {
    content: '+';
    font-weight: 400;
    font-size: 20px;
    color: #6b6b68;
  }

  .vhl-vacuum-pdp__accordion[open] summary::after {
    content: '\2212';
  }

  .vhl-vacuum-pdp__accordion-body {
    padding: 0 4px 20px;
    font-size: 14px;
    line-height: 1.7;
    color: #4a4a47;
  }

  .vhl-vacuum-pdp__accordion-body a {
    color: #1a1a1a;
    text-decoration: underline;
  }

  .vhl-vacuum-pdp__spec-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .vhl-vacuum-pdp__spec-list li {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    border-bottom: 1px dashed #eceae5;
    padding-bottom: 6px;
  }

  .vhl-vacuum-pdp__spec-list li span:first-child {
    color: #8a8a86;
  }
{% endstyle %}

