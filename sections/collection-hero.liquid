{% comment %}
  VANHOUTEN LIVING — Collection-aware hero voor collectiepagina's.

  Generiek voor alle collecties (geen per-collectie hardcoded copy).
  Hergebruikt bewust de bestaande, al per collectie ingevulde PDP-
  storytelling-metafields (dezelfde namespace als custom_liquid_k47nDM
  op de PDP) — geen nieuwe collection_hero_*-metafields nodig:

    eyebrow -> custom.pdp_functional_eyebrow   (optioneel, geen fallback-tekst)
    heading -> custom.pdp_functional_headline, anders collection.title
    tekst   -> custom.pdp_functional_body_1 + custom.pdp_functional_body_2,
               anders (als beide leeg zijn) collection.description
    image   -> collection.image (GEEN metafield-fallback: custom.pdp_functional_image
               is bedoeld voor PDP-storytelling, niet per se geschikt als
               collectiehero)

  custom.pdp_functional_cta_text wordt hier bewust NIET gebruikt: er is
  op deze sectie geen CTA-knop. De bezoeker bevindt zich al op de
  collectiepagina.

  Ontbreekt collection.image, dan toont deze sectie een nette, lichte
  text-only hero — nooit een lege of kapotte afbeeldingsbox.
{% endcomment %}

{%- liquid
  assign vhl_hero_eyebrow = collection.metafields.custom.pdp_functional_eyebrow.value

  assign vhl_hero_heading = collection.metafields.custom.pdp_functional_headline.value | default: collection.title

  assign vhl_hero_text_1 = collection.metafields.custom.pdp_functional_body_1.value
  assign vhl_hero_text_2 = collection.metafields.custom.pdp_functional_body_2.value

  assign vhl_hero_has_body_text = false
  if vhl_hero_text_1 != blank or vhl_hero_text_2 != blank
    assign vhl_hero_has_body_text = true
  endif

  assign vhl_hero_description_fallback = collection.description
  if vhl_hero_has_body_text
    assign vhl_hero_description_fallback = blank
  endif

  assign vhl_hero_has_image = false
  if collection.image
    assign vhl_hero_image = collection.image
    assign vhl_hero_has_image = true
  endif

  assign vhl_hero_image_alt = vhl_hero_image.alt | default: vhl_hero_heading | escape
-%}

<section
  id="VHLCollectionHero-{{ section.id }}"
  class="vhl-collection-hero{% if vhl_hero_has_image %} vhl-collection-hero--with-image{% else %} vhl-collection-hero--text-only{% endif %}"
>
  <div class="vhl-collection-hero__inner">

    <div class="vhl-collection-hero__content">
      <div class="vhl-collection-hero__content-inner">

        {%- if vhl_hero_eyebrow != blank -%}
          <p class="vhl-collection-hero__eyebrow">{{ vhl_hero_eyebrow | escape }}</p>
        {%- endif -%}

        <h1 class="vhl-collection-hero__heading">{{ vhl_hero_heading | escape }}</h1>

        {%- if vhl_hero_has_body_text -%}
          <div class="vhl-collection-hero__text">
            {%- if vhl_hero_text_1 != blank -%}<p>{{ vhl_hero_text_1 }}</p>{%- endif -%}
            {%- if vhl_hero_text_2 != blank -%}<p>{{ vhl_hero_text_2 }}</p>{%- endif -%}
          </div>
        {%- elsif vhl_hero_description_fallback != blank -%}
          <div class="vhl-collection-hero__text rte">{{ vhl_hero_description_fallback }}</div>
        {%- endif -%}

      </div>
    </div>

    {%- if vhl_hero_has_image -%}
      <div class="vhl-collection-hero__media">
        {{
          vhl_hero_image
          | image_url: width: 1800
          | image_tag:
            loading: 'eager',
            widths: '600, 900, 1200, 1500, 1800',
            sizes: '(min-width: 990px) 50vw, 100vw',
            class: 'vhl-collection-hero__image',
            alt: vhl_hero_image_alt
        }}
      </div>
    {%- endif -%}

  </div>
</section>

{% style %}

/* =========================================================
   BASIS
========================================================= */

#VHLCollectionHero-{{ section.id }} {
  width: 100%;
  margin: 0;
  overflow: hidden;
  background: #f5f5f3;
}


/* =========================================================
   LAYOUT
   Met afbeelding: split (tekst links / afbeelding rechts op
   desktop). Zonder afbeelding: enkel tekstblok, geen leeg vlak.
========================================================= */

#VHLCollectionHero-{{ section.id }}.vhl-collection-hero--with-image .vhl-collection-hero__inner {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  min-height: {{ section.settings.desktop_height }}px;
}

#VHLCollectionHero-{{ section.id }}.vhl-collection-hero--text-only .vhl-collection-hero__inner {
  display: block;
}


/* =========================================================
   CONTENT
========================================================= */

#VHLCollectionHero-{{ section.id }} .vhl-collection-hero__content {
  display: flex;
  align-items: center;
  justify-content: center;

  padding: 64px clamp(24px, 5.5vw, 80px);
}

#VHLCollectionHero-{{ section.id }} .vhl-collection-hero__content-inner {
  width: 100%;
  max-width: 480px;
}

#VHLCollectionHero-{{ section.id }}.vhl-collection-hero--text-only .vhl-collection-hero__content {
  justify-content: flex-start;
}

#VHLCollectionHero-{{ section.id }}.vhl-collection-hero--text-only .vhl-collection-hero__content-inner {
  max-width: 640px;
}


/* =========================================================
   EYEBROW
========================================================= */

#VHLCollectionHero-{{ section.id }} .vhl-collection-hero__eyebrow {
  margin: 0 0 15px;

  color: #66635f;

  font-size: 11px;
  line-height: 1.4;
  font-weight: 500;

  letter-spacing: .14em;
  text-transform: uppercase;
}


/* =========================================================
   HEADING
   Bewust GEEN white-space:nowrap / width:max-content: de
   heading komt uit collectiedata (metafield of collection.title)
   en kan per collectie in lengte variëren.
========================================================= */

#VHLCollectionHero-{{ section.id }} .vhl-collection-hero__heading {
  margin: 0 0 20px;

  color: #333333;

  font-size: clamp(28px, 3vw, 42px);
  line-height: 1.08;
  font-weight: 600;

  letter-spacing: -.03em;

  overflow-wrap: break-word;
}


/* =========================================================
   TEKST
========================================================= */

#VHLCollectionHero-{{ section.id }} .vhl-collection-hero__text {
  color: #55524e;

  font-size: 15px;
  line-height: 1.7;

  max-width: 46ch;
}

#VHLCollectionHero-{{ section.id }} .vhl-collection-hero__text p {
  margin: 0 0 14px;
}

#VHLCollectionHero-{{ section.id }} .vhl-collection-hero__text p:last-child {
  margin-bottom: 0;
}


/* =========================================================
   AFBEELDING
========================================================= */

#VHLCollectionHero-{{ section.id }} .vhl-collection-hero__media {
  position: relative;
  width: 100%;
  min-height: 320px;
  overflow: hidden;
  background: #ecebe7;
}

#VHLCollectionHero-{{ section.id }} .vhl-collection-hero__image {
  position: absolute;
  inset: 0;

  display: block;

  width: 100%;
  height: 100%;

  object-fit: cover;
  object-position: center;

  border: 0;
}


/* =========================================================
   MOBIEL
   Tekst + afbeelding logisch gestapeld: tekst boven,
   afbeelding onder (DOM-volgorde bepaalt de stacking).
========================================================= */

@media screen and (max-width: 749px) {

  #VHLCollectionHero-{{ section.id }}.vhl-collection-hero--with-image .vhl-collection-hero__inner {
    display: block;
    min-height: 0;
  }

  #VHLCollectionHero-{{ section.id }} .vhl-collection-hero__content {
    padding: 44px 24px 32px;
  }

  #VHLCollectionHero-{{ section.id }}.vhl-collection-hero--text-only .vhl-collection-hero__content {
    padding: 40px 24px;
  }

  #VHLCollectionHero-{{ section.id }} .vhl-collection-hero__content-inner {
    max-width: 100%;
  }

  #VHLCollectionHero-{{ section.id }} .vhl-collection-hero__eyebrow {
    margin-bottom: 9px;
    font-size: 10px;
  }

  #VHLCollectionHero-{{ section.id }} .vhl-collection-hero__heading {
    margin-bottom: 14px;
    font-size: 24px;
    line-height: 1.12;
  }

  #VHLCollectionHero-{{ section.id }} .vhl-collection-hero__text {
    font-size: 13.5px;
    max-width: 100%;
  }

  #VHLCollectionHero-{{ section.id }} .vhl-collection-hero__media {
    min-height: 0;
    aspect-ratio: 1 / 1;
  }

}

{% endstyle %}

{% schema %}
{
  "name": "Collection Hero",
  "class": "section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Collection-aware hero. Hergebruikt de bestaande PDP-storytelling-metafields (custom.pdp_functional_eyebrow / _headline / _body_1 / _body_2) van de huidige collectie, met fallback naar collection.title / collection.description. Afbeelding = collection.image. Geen CTA-knop."
    },
    {
      "type": "number",
      "id": "desktop_height",
      "label": "Min. hoogte desktop (bij afbeelding)",
      "default": 420
    }
  ],
  "presets": [
    {
      "name": "Collection Hero"
    }
  ]
}
{% endschema %}
