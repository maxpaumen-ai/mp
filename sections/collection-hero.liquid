{% comment %}
  VANHOUTEN LIVING — Collection-aware hero voor collectiepagina's.

  Generiek voor alle collecties (geen per-collectie hardcoded copy).
  Leest, in volgorde:
    eyebrow -> custom.collection_hero_eyebrow (optioneel, geen fallback-tekst)
    heading -> custom.collection_hero_heading, anders collection.title
    text    -> custom.collection_hero_text, anders collection.description
    image   -> custom.collection_hero_image, anders collection.image

  Geen CTA-knop: de bezoeker bevindt zich al op de collectiepagina.

  Ontbreekt zowel de metafield-afbeelding als collection.image, dan
  toont deze sectie een nette, lichte text-only hero — nooit een lege
  of kapotte afbeeldingsbox.
{% endcomment %}

{%- liquid
  assign vhl_hero_eyebrow = collection.metafields.custom.collection_hero_eyebrow.value

  assign vhl_hero_heading = collection.metafields.custom.collection_hero_heading.value | default: collection.title

  assign vhl_hero_text = collection.metafields.custom.collection_hero_text.value | default: collection.description

  assign vhl_hero_image_file = collection.metafields.custom.collection_hero_image.value
  assign vhl_hero_has_image = false
  if vhl_hero_image_file and vhl_hero_image_file.preview_image
    assign vhl_hero_image = vhl_hero_image_file.preview_image
    assign vhl_hero_has_image = true
  elsif collection.image
    assign vhl_hero_image = collection.image
    assign vhl_hero_has_image = true
  endif

  assign vhl_hero_image_alt = vhl_hero_image.alt | default: vhl_hero_heading | escape
-%}

<section
  id="VHLCollectionHero-{{ section.id }}"
  class="vhl-collection-hero{% if vhl_hero_has_image %} vhl-collection-hero--with-image{% else %} vhl-collection-hero--text-only{% endif %}"
>

  {%- if vhl_hero_has_image -%}
    <div class="vhl-collection-hero__media">
      {{
        vhl_hero_image
        | image_url: width: 2400
        | image_tag:
          loading: 'eager',
          widths: '750, 1100, 1500, 2000, 2400',
          sizes: '100vw',
          class: 'vhl-collection-hero__image',
          alt: vhl_hero_image_alt
      }}
    </div>
    <div class="vhl-collection-hero__overlay"></div>
  {%- endif -%}

  <div class="vhl-collection-hero__inner">
    <div class="vhl-collection-hero__content">

      {%- if vhl_hero_eyebrow != blank -%}
        <p class="vhl-collection-hero__eyebrow">{{ vhl_hero_eyebrow | escape }}</p>
      {%- endif -%}

      <h1 class="vhl-collection-hero__heading">{{ vhl_hero_heading | escape }}</h1>

      {%- if vhl_hero_text != blank -%}
        <div class="vhl-collection-hero__text rte">{{ vhl_hero_text }}</div>
      {%- endif -%}

    </div>
  </div>

</section>

{% style %}

/* =========================================================
   BASIS
========================================================= */

#VHLCollectionHero-{{ section.id }} {
  position: relative;
  width: 100%;
  overflow: hidden;
  isolation: isolate;
}

#VHLCollectionHero-{{ section.id }}.vhl-collection-hero--with-image {
  min-height: {{ section.settings.desktop_height }}px;
  color: #fff;
  background: #171614;
}

#VHLCollectionHero-{{ section.id }}.vhl-collection-hero--text-only {
  background: #f5f5f3;
  color: #2a2927;
  padding: 64px 0;
}


/* =========================================================
   AFBEELDING
========================================================= */

#VHLCollectionHero-{{ section.id }} .vhl-collection-hero__media {
  position: absolute;
  inset: 0;
  z-index: -2;
}

#VHLCollectionHero-{{ section.id }} .vhl-collection-hero__image {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center center;
}

#VHLCollectionHero-{{ section.id }} .vhl-collection-hero__overlay {
  position: absolute;
  inset: 0;
  z-index: -1;
  pointer-events: none;

  background:
    linear-gradient(
      90deg,
      rgba(7, 7, 7, {{ section.settings.overlay_opacity | times: 0.01 | plus: 0.25 }}) 0%,
      rgba(7, 7, 7, {{ section.settings.overlay_opacity | times: 0.01 }}) 45%,
      rgba(7, 7, 7, {{ section.settings.overlay_opacity | times: 0.01 | times: 0.4 }}) 100%
    );
}


/* =========================================================
   CONTENT
========================================================= */

#VHLCollectionHero-{{ section.id }} .vhl-collection-hero__inner {
  position: relative;
  width: min(100%, 1600px);
  margin: 0 auto;
  padding: 0 clamp(24px, 5.5vw, 105px);
}

#VHLCollectionHero-{{ section.id }}.vhl-collection-hero--with-image .vhl-collection-hero__inner {
  min-height: {{ section.settings.desktop_height }}px;
  display: flex;
  align-items: center;
}

#VHLCollectionHero-{{ section.id }} .vhl-collection-hero__content {
  max-width: 640px;
}


/* =========================================================
   EYEBROW
========================================================= */

#VHLCollectionHero-{{ section.id }} .vhl-collection-hero__eyebrow {
  margin: 0 0 15px;

  color: currentColor;
  opacity: 0.82;

  font-size: 11px;
  line-height: 1;
  font-weight: 600;

  letter-spacing: .19em;
  text-transform: uppercase;
}


/* =========================================================
   HEADING
   Bewust GEEN white-space:nowrap / width:max-content: de
   heading komt uit collectiedata (metafield of collection.title)
   en kan per collectie in lengte variëren.
========================================================= */

#VHLCollectionHero-{{ section.id }} .vhl-collection-hero__heading {
  margin: 0;

  color: currentColor;

  font-family: var(--font-heading-family, sans-serif);

  font-size: clamp(30px, 3.4vw, 48px);
  line-height: 1.08;
  font-weight: 600;

  letter-spacing: -.03em;

  overflow-wrap: break-word;
}


/* =========================================================
   TEKST
========================================================= */

#VHLCollectionHero-{{ section.id }} .vhl-collection-hero__text {
  margin: 16px 0 0;

  color: currentColor;
  opacity: 0.92;

  font-size: 15px;
  line-height: 1.6;

  max-width: 52ch;
}

#VHLCollectionHero-{{ section.id }} .vhl-collection-hero__text p {
  margin: 0 0 10px;
}

#VHLCollectionHero-{{ section.id }} .vhl-collection-hero__text p:last-child {
  margin-bottom: 0;
}


/* =========================================================
   MOBIEL
========================================================= */

@media screen and (max-width: 749px) {

  #VHLCollectionHero-{{ section.id }}.vhl-collection-hero--with-image {
    min-height: {{ section.settings.mobile_height }}px;
  }

  #VHLCollectionHero-{{ section.id }}.vhl-collection-hero--with-image .vhl-collection-hero__inner {
    min-height: {{ section.settings.mobile_height }}px;
    align-items: flex-end;
    padding-top: 96px;
    padding-bottom: 32px;
  }

  #VHLCollectionHero-{{ section.id }}.vhl-collection-hero--text-only {
    padding: 40px 0;
  }

  #VHLCollectionHero-{{ section.id }} .vhl-collection-hero__inner {
    padding-left: 20px;
    padding-right: 20px;
  }

  #VHLCollectionHero-{{ section.id }} .vhl-collection-hero__content {
    max-width: 100%;
  }

  #VHLCollectionHero-{{ section.id }} .vhl-collection-hero__eyebrow {
    margin-bottom: 9px;
    font-size: 10px;
  }

  #VHLCollectionHero-{{ section.id }} .vhl-collection-hero__heading {
    font-size: 24px;
    line-height: 1.12;
  }

  #VHLCollectionHero-{{ section.id }} .vhl-collection-hero__text {
    margin-top: 10px;
    font-size: 13.5px;
    max-width: 100%;
  }

}

{% endstyle %}

{% schema %}
{
  "name": "Collection Hero",
  "class": "section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Collection-aware hero. Leest custom.collection_hero_eyebrow / _heading / _text / _image van de huidige collectie, met fallback naar collection.title / collection.description / collection.image. Geen CTA-knop."
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay-opaciteit (bij afbeelding)",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "default": 45
    },
    {
      "type": "number",
      "id": "desktop_height",
      "label": "Hoogte desktop (bij afbeelding)",
      "default": 420
    },
    {
      "type": "number",
      "id": "mobile_height",
      "label": "Hoogte mobiel (bij afbeelding)",
      "default": 320
    }
  ],
  "presets": [
    {
      "name": "Collection Hero"
    }
  ]
}
{% endschema %}
