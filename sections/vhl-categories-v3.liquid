<section id="VHLProductSlider-{{ section.id }}" class="vhl-product-slider" style="--vhl-ps-bg:{{ section.settings.background }};--vhl-ps-gap:{{ section.settings.gap }}px;--vhl-ps-height:{{ section.settings.desktop_height }}px;--vhl-ps-mobile-height:{{ section.settings.mobile_height }}px;">
  <div class="vhl-product-slider__top">
    {% if section.settings.heading != blank %}<h2>{{ section.settings.heading | escape }}</h2>{% endif %}
    <div class="vhl-product-slider__arrows">
      <button type="button" class="vhl-product-slider__prev" aria-label="Vorige producten" aria-controls="VHLProductSliderTrack-{{ section.id }}" disabled><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m15 5-7 7 7 7"/></svg></button>
      <button type="button" class="vhl-product-slider__next" aria-label="Volgende producten" aria-controls="VHLProductSliderTrack-{{ section.id }}"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 5 7 7-7 7"/></svg></button>
    </div>
  </div>
  <div id="VHLProductSliderTrack-{{ section.id }}" class="vhl-product-slider__track" tabindex="0" aria-label="Producten">
    {% for block in section.blocks %}
      {% liquid
        assign product = block.settings.product
        assign photo = block.settings.image | default: product.featured_image
        assign title = block.settings.title | default: product.title
      %}
      <div class="vhl-product-slider__item" {{ block.shopify_attributes }}>
        {% if product != blank %}<a class="vhl-product-slider__card" href="{{ product.url }}" aria-label="Bekijk {{ title | escape }}">{% else %}<div class="vhl-product-slider__card vhl-product-slider__card--empty">{% endif %}
          {% if photo != blank %}
            {{ photo | image_url: width: 1100 | image_tag: class: 'vhl-product-slider__image', loading: 'lazy', widths: '360, 540, 750, 900, 1100', sizes: '(min-width: 990px) 24vw, (min-width: 750px) 42vw, 76vw' }}
          {% else %}
            {{ 'product-1' | placeholder_svg_tag: 'vhl-product-slider__image vhl-product-slider__placeholder' }}
          {% endif %}
          <span class="vhl-product-slider__shade" aria-hidden="true"></span>
          {% if title != blank %}<span class="vhl-product-slider__name">{{ title | escape }}</span>{% endif %}
        {% if product != blank %}</a>{% else %}</div>{% endif %}
      </div>
    {% else %}
      {% for i in (1..5) %}
        <div class="vhl-product-slider__item"><div class="vhl-product-slider__card vhl-product-slider__card--empty">{{ 'product-1' | placeholder_svg_tag: 'vhl-product-slider__image vhl-product-slider__placeholder' }}<span class="vhl-product-slider__name">Selecteer een product</span></div></div>
      {% endfor %}
    {% endfor %}
  </div>
</section>
<style>
#VHLProductSlider-{{ section.id }}{background:var(--vhl-ps-bg);padding:{{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;overflow:hidden}
#VHLProductSlider-{{ section.id }} *{box-sizing:border-box}
#VHLProductSlider-{{ section.id }} .vhl-product-slider__top{display:flex;justify-content:space-between;align-items:center;gap:24px;padding:0 clamp(18px,1.35vw,32px);margin-bottom:26px;min-height:24px}
#VHLProductSlider-{{ section.id }} .vhl-product-slider__top h2{font-size:clamp(19px,2vw,28px);font-weight:400;margin:0;color:#282522}
#VHLProductSlider-{{ section.id }} .vhl-product-slider__arrows{display:flex;gap:10px;margin-left:auto}
#VHLProductSlider-{{ section.id }} .vhl-product-slider__arrows button{display:grid;place-items:center;width:30px;height:30px;border:0;background:transparent;color:#262321;cursor:pointer;padding:0}
#VHLProductSlider-{{ section.id }} .vhl-product-slider__arrows button:disabled{opacity:.25;cursor:default}
#VHLProductSlider-{{ section.id }} .vhl-product-slider__arrows svg{width:18px;height:18px;fill:none;stroke:currentColor;stroke-width:1.5;stroke-linecap:round;stroke-linejoin:round}
#VHLProductSlider-{{ section.id }} .vhl-product-slider__track{display:flex;gap:var(--vhl-ps-gap);overflow-x:auto;overscroll-behavior-x:contain;scroll-snap-type:x mandatory;scroll-padding-inline:clamp(18px,1.35vw,32px);scrollbar-width:none;padding:0 clamp(18px,1.35vw,32px);-webkit-overflow-scrolling:touch}
#VHLProductSlider-{{ section.id }} .vhl-product-slider__track::-webkit-scrollbar{display:none}
#VHLProductSlider-{{ section.id }} .vhl-product-slider__item{flex:0 0 calc((100% - 3 * var(--vhl-ps-gap)) / 4.35);min-width:0;scroll-snap-align:start}
#VHLProductSlider-{{ section.id }} .vhl-product-slider__card{position:relative;display:block;width:100%;height:var(--vhl-ps-height);overflow:hidden;background:#a99c8c;text-decoration:none;color:white}
#VHLProductSlider-{{ section.id }} .vhl-product-slider__image{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;transition:transform .6s ease}
#VHLProductSlider-{{ section.id }} .vhl-product-slider__card:hover .vhl-product-slider__image{transform:scale(1.035)}
#VHLProductSlider-{{ section.id }} .vhl-product-slider__shade{position:absolute;inset:45% 0 0;background:linear-gradient(transparent,rgba(0,0,0,.34));pointer-events:none}
#VHLProductSlider-{{ section.id }} .vhl-product-slider__name{position:absolute;bottom:20px;left:18px;right:12px;font-family:Georgia,'Times New Roman',serif;font-size:clamp(22px,2vw,37px);font-weight:400;line-height:1.08;color:#fff;overflow-wrap:anywhere}
#VHLProductSlider-{{ section.id }} .vhl-product-slider__placeholder{background:#d5cec3}
@media(max-width:989px){#VHLProductSlider-{{ section.id }} .vhl-product-slider__item{flex-basis:calc((100% - var(--vhl-ps-gap)) / 2.3)}}
@media(max-width:749px){#VHLProductSlider-{{ section.id }}{padding:{{ section.settings.padding_top_mobile }}px 0 {{ section.settings.padding_bottom_mobile }}px}#VHLProductSlider-{{ section.id }} .vhl-product-slider__top{margin-bottom:16px;padding-inline:16px}#VHLProductSlider-{{ section.id }} .vhl-product-slider__track{padding-inline:16px;scroll-padding-inline:16px;gap:12px}#VHLProductSlider-{{ section.id }} .vhl-product-slider__item{flex-basis:76%}#VHLProductSlider-{{ section.id }} .vhl-product-slider__card{height:var(--vhl-ps-mobile-height)}#VHLProductSlider-{{ section.id }} .vhl-product-slider__name{font-size:28px;bottom:17px;left:16px}}
@media(prefers-reduced-motion:reduce){#VHLProductSlider-{{ section.id }} .vhl-product-slider__image{transition:none}#VHLProductSlider-{{ section.id }} .vhl-product-slider__track{scroll-behavior:auto}}
</style>
<script>
(function(){
  function init(){
    var root=document.getElementById('VHLProductSlider-{{ section.id }}');
    if(!root||root.dataset.sliderReady==='true')return;
    root.dataset.sliderReady='true';
    var track=root.querySelector('.vhl-product-slider__track');
    var prev=root.querySelector('.vhl-product-slider__prev');
    var next=root.querySelector('.vhl-product-slider__next');
    function update(){var max=track.scrollWidth-track.clientWidth;prev.disabled=track.scrollLeft<=2;next.disabled=track.scrollLeft>=max-2;}
    function move(dir){var card=track.querySelector('.vhl-product-slider__item');if(!card)return;var gap=parseFloat(getComputedStyle(track).gap)||0;track.scrollBy({left:dir*(card.getBoundingClientRect().width+gap),behavior:'smooth'});}
    prev.addEventListener('click',function(){move(-1)});
    next.addEventListener('click',function(){move(1)});
    track.addEventListener('scroll',update,{passive:true});window.addEventListener('resize',update);update();
  }
  if(document.readyState==='loading'){document.addEventListener('DOMContentLoaded',init)}else{init()}
  document.addEventListener('shopify:section:load',init);
})();
</script>
{% schema %}
{
  "name": "VHL Product Slider",
  "tag": "section",
  "class": "section-vhl-product-slider",
  "max_blocks": 20,
  "settings": [
    {"type":"text","id":"heading","label":"Titel boven slider (optioneel)"},
    {"type":"color","id":"background","label":"Achtergrondkleur","default":"#FFFFFF"},
    {"type":"range","id":"gap","label":"Ruimte tussen foto's","min":8,"max":40,"step":2,"unit":"px","default":26},
    {"type":"range","id":"desktop_height","label":"Hoogte desktop","min":380,"max":760,"step":10,"unit":"px","default":650},
    {"type":"range","id":"mobile_height","label":"Hoogte mobiel","min":300,"max":650,"step":10,"unit":"px","default":460},
    {"type":"range","id":"padding_top","label":"Bovenruimte desktop","min":0,"max":140,"step":5,"unit":"px","default":65},
    {"type":"range","id":"padding_bottom","label":"Onderruimte desktop","min":0,"max":140,"step":5,"unit":"px","default":65},
    {"type":"range","id":"padding_top_mobile","label":"Bovenruimte mobiel","min":0,"max":100,"step":5,"unit":"px","default":35},
    {"type":"range","id":"padding_bottom_mobile","label":"Onderruimte mobiel","min":0,"max":100,"step":5,"unit":"px","default":35}
  ],
  "blocks": [
    {"type":"product_card","name":"Productkaart","settings":[
      {"type":"product","id":"product","label":"Product"},
      {"type":"image_picker","id":"image","label":"Eigen foto (optioneel)"},
      {"type":"text","id":"title","label":"Eigen titel (optioneel)"}
    ]}
  ],
  "presets":[{"name":"VHL Product Slider","blocks":[{"type":"product_card"},{"type":"product_card"},{"type":"product_card"},{"type":"product_card"},{"type":"product_card"}]}]
}
{% endschema %}
