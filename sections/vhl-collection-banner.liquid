{% liquid
  assign banner_url = section.settings.link | default: section.settings.collection.url | default: routes.all_products_collection_url
  assign banner_image = section.settings.image | default: section.settings.collection.featured_image
  assign banner_alt = banner_image.alt | default: section.settings.heading
%}
<section id="VHLCollectionBanner-{{ section.id }}" class="vhl-collection-banner">
  <div class="vhl-collection-banner__frame" style="--vhl-overlay: {{ section.settings.overlay | divided_by: 100.0 }}; --vhl-position: {{ section.settings.image_position }};">
    {% if banner_image != blank %}
      {{ banner_image | image_url: width: 2400 | image_tag: class: 'vhl-collection-banner__image', loading: 'lazy', widths: '600, 900, 1200, 1600, 2000, 2400', sizes: '100vw', alt: banner_alt }}
    {% else %}
      {{ 'lifestyle-2' | placeholder_svg_tag: 'vhl-collection-banner__image vhl-collection-banner__placeholder' }}
    {% endif %}
    <span class="vhl-collection-banner__shade" aria-hidden="true"></span>
    <div class="vhl-collection-banner__content vhl-collection-banner__content--{{ section.settings.alignment }}">
      {% if section.settings.eyebrow != blank %}<p class="vhl-collection-banner__eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}
      {% if section.settings.heading != blank %}<h2 class="vhl-collection-banner__heading">{{ section.settings.heading | escape }}</h2>{% endif %}
      {% if section.settings.text != blank %}<div class="vhl-collection-banner__text rte">{{ section.settings.text }}</div>{% endif %}
      {% if section.settings.button_text != blank %}<a class="vhl-collection-banner__button" href="{{ banner_url }}">{{ section.settings.button_text | escape }} <span aria-hidden="true">→</span></a>{% endif %}
    </div>
  </div>
</section>
{% style %}
  #VHLCollectionBanner-{{ section.id }} { overflow:hidden; padding:{{ section.settings.padding_top }}px clamp(18px,4vw,58px) {{ section.settings.padding_bottom }}px; background:{{ section.settings.background }}; }
  #VHLCollectionBanner-{{ section.id }} *{box-sizing:border-box} #VHLCollectionBanner-{{ section.id }} .vhl-collection-banner__frame{position:relative;width:min(100%,1384px);min-height:{{ section.settings.height }}px;margin:0 auto;overflow:hidden;border-radius:{{ section.settings.radius }}px;background:#80776d;color:#fff;isolation:isolate;display:flex;align-items:flex-end}
  #VHLCollectionBanner-{{ section.id }} .vhl-collection-banner__image{position:absolute;inset:0;z-index:-2;width:100%;height:100%;object-fit:cover;object-position:var(--vhl-position);transition:transform 900ms cubic-bezier(.2,.7,.3,1)}
  #VHLCollectionBanner-{{ section.id }} .vhl-collection-banner__placeholder{background:#d8d1c7} #VHLCollectionBanner-{{ section.id }} .vhl-collection-banner__shade{position:absolute;inset:0;z-index:-1;background:linear-gradient(90deg,rgba(18,17,15,var(--vhl-overlay)),rgba(18,17,15,.32) 55%,rgba(18,17,15,.12))}
  #VHLCollectionBanner-{{ section.id }} .vhl-collection-banner__content{width:min(100%,680px);padding:clamp(36px,7vw,96px)} #VHLCollectionBanner-{{ section.id }} .vhl-collection-banner__content--center{margin:auto;text-align:center} #VHLCollectionBanner-{{ section.id }} .vhl-collection-banner__content--right{margin-left:auto;text-align:right}
  #VHLCollectionBanner-{{ section.id }} .vhl-collection-banner__eyebrow{margin:0 0 13px;color:#fff;font-size:11px;font-weight:700;letter-spacing:.22em;text-transform:uppercase} #VHLCollectionBanner-{{ section.id }} .vhl-collection-banner__heading{margin:0;color:#fff!important;font-family:var(--font-heading-family);font-size:clamp(38px,5vw,72px);font-weight:var(--font-heading-weight);line-height:.98;letter-spacing:-.045em;text-shadow:0 3px 18px rgba(0,0,0,.32)}
  #VHLCollectionBanner-{{ section.id }} .vhl-collection-banner__text{max-width:54ch;margin:18px 0 0;color:#fff;font-size:16px;line-height:1.65;text-shadow:0 2px 12px rgba(0,0,0,.36)} #VHLCollectionBanner-{{ section.id }} .vhl-collection-banner__content--center .vhl-collection-banner__text{margin-inline:auto}
  #VHLCollectionBanner-{{ section.id }} .vhl-collection-banner__button{display:inline-flex;align-items:center;gap:12px;margin-top:26px;padding:12px 0 7px;border-bottom:1px solid rgba(255,255,255,.75);color:#fff;text-decoration:none;font-size:12px;font-weight:700;letter-spacing:.12em;text-transform:uppercase} #VHLCollectionBanner-{{ section.id }} .vhl-collection-banner__button span{transition:transform 220ms ease}
  @media (hover:hover) and (pointer:fine){#VHLCollectionBanner-{{ section.id }} .vhl-collection-banner__frame:hover .vhl-collection-banner__image{transform:scale(1.035)}#VHLCollectionBanner-{{ section.id }} .vhl-collection-banner__button:hover span{transform:translateX(4px)}}
  @media(max-width:749px){#VHLCollectionBanner-{{ section.id }}{padding:{{ section.settings.padding_top_mobile }}px 16px {{ section.settings.padding_bottom_mobile }}px}#VHLCollectionBanner-{{ section.id }} .vhl-collection-banner__frame{min-height:{{ section.settings.height_mobile }}px;border-radius:min({{ section.settings.radius }}px,22px)}#VHLCollectionBanner-{{ section.id }} .vhl-collection-banner__shade{background:linear-gradient(180deg,rgba(18,17,15,.08),rgba(18,17,15,var(--vhl-overlay)))}#VHLCollectionBanner-{{ section.id }} .vhl-collection-banner__content,#VHLCollectionBanner-{{ section.id }} .vhl-collection-banner__content--right{padding:30px 24px;text-align:left}#VHLCollectionBanner-{{ section.id }} .vhl-collection-banner__heading{font-size:clamp(34px,11vw,48px)}#VHLCollectionBanner-{{ section.id }} .vhl-collection-banner__text{font-size:14px}}
  @media(prefers-reduced-motion:reduce){#VHLCollectionBanner-{{ section.id }} .vhl-collection-banner__image,#VHLCollectionBanner-{{ section.id }} .vhl-collection-banner__button span{transition:none}}
{% endstyle %}
{% schema %}
{"name":"VHL Collection Banner","tag":"section","class":"section-vhl-collection-banner","settings":[
{"type":"collection","id":"collection","label":"Collectie"},{"type":"image_picker","id":"image","label":"Eigen lifestylebeeld"},{"type":"select","id":"image_position","label":"Afbeeldingspositie","default":"center center","options":[{"value":"left center","label":"Links"},{"value":"center center","label":"Midden"},{"value":"right center","label":"Rechts"}]},
{"type":"text","id":"eyebrow","label":"Boventitel","default":"VANHOUTEN LIVING"},{"type":"text","id":"heading","label":"Titel","default":"Een collectie voor rust en verfijning"},{"type":"richtext","id":"text","label":"Tekst","default":"<p>Ontdek tijdloze materialen en zorgvuldig gekozen details voor jouw badkamer.</p>"},{"type":"text","id":"button_text","label":"Knoptekst","default":"Bekijk de collectie"},{"type":"url","id":"link","label":"Eigen link"},
{"type":"select","id":"alignment","label":"Uitlijning desktop","default":"left","options":[{"value":"left","label":"Links"},{"value":"center","label":"Midden"},{"value":"right","label":"Rechts"}]},{"type":"range","id":"overlay","label":"Overlaysterkte","min":20,"max":85,"step":5,"unit":"%","default":60},{"type":"color","id":"background","label":"Sectieachtergrond","default":"#F7F4EF"},{"type":"range","id":"radius","label":"Afronding","min":0,"max":40,"step":1,"unit":"px","default":24},
{"type":"range","id":"height","label":"Hoogte desktop","min":480,"max":800,"step":10,"unit":"px","default":640},{"type":"range","id":"height_mobile","label":"Hoogte mobiel","min":420,"max":700,"step":10,"unit":"px","default":540},{"type":"range","id":"padding_top","label":"Bovenruimte desktop","min":0,"max":160,"step":5,"unit":"px","default":45},{"type":"range","id":"padding_bottom","label":"Onderruimte desktop","min":0,"max":160,"step":5,"unit":"px","default":45},{"type":"range","id":"padding_top_mobile","label":"Bovenruimte mobiel","min":0,"max":100,"step":5,"unit":"px","default":30},{"type":"range","id":"padding_bottom_mobile","label":"Onderruimte mobiel","min":0,"max":100,"step":5,"unit":"px","default":30}
],"presets":[{"name":"VHL Collection Banner"}]}
{% endschema %}
