{% comment %}
  VHL Installatiepagina
  Losse Shopify section voor een aparte installatiepagina.
  Video is selecteerbaar in de Theme Editor.
{% endcomment %}

<section id="VhlInstall-{{ section.id }}" class="vhl-install">
  <div class="vhl-install__grid">
    <div class="vhl-install__media">
      {% if section.settings.video != blank %}
        {{
          section.settings.video
          | video_tag:
            autoplay: true,
            loop: true,
            muted: true,
            controls: false,
            playsinline: true,
            preload: 'metadata',
            class: 'vhl-install__video'
        }}
      {% else %}
        <div class="vhl-install__placeholder">
          Selecteer de installatievideo in de theme-editor
        </div>
      {% endif %}
    </div>

    <div class="vhl-install__content">
      <div class="vhl-install__content-inner">
        <h1>{{ section.settings.heading | escape }}</h1>

        <div class="vhl-install__text rte">
          {{ section.settings.intro }}

          <p>1) Kies het gewenste oppervlak voor jouw zuignaphaak</p>

          <p>2) Maak het oppervlak schoon met een doekje (+alcohol)</p>

          <p>3) Maak de 'schroef' los en bevestig de basis in een volle beweging op het oppervlak.</p>

          <p>4) Druk de basis stevig aan tegen het oppervlak en schroef vast</p>

          <p><strong><em>5) Eventuele stap:</em></strong> <em>Schroef geleidelijk aan voor de komende 24u zonder gewichtsdruk.</em></p>

          {% if section.settings.bottom_text != blank %}
            <div class="vhl-install__bottom">
              {{ section.settings.bottom_text }}
            </div>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  #VhlInstall-{{ section.id }} {
    width: 100%;
    margin: 0;
    padding: 0;
    background: #2d2d2d;
    color: #fff;
  }

  #VhlInstall-{{ section.id }} * {
    box-sizing: border-box;
  }

  #VhlInstall-{{ section.id }} .vhl-install__grid {
    display: grid;
    grid-template-columns: 50% 50%;
    width: 100%;
    min-height: 570px;
    border-bottom: 5px solid #fff;
  }

  #VhlInstall-{{ section.id }} .vhl-install__media {
    position: relative;
    min-width: 0;
    height: 570px;
    overflow: hidden;
    background: #ddd;
  }

  #VhlInstall-{{ section.id }} .vhl-install__video,
  #VhlInstall-{{ section.id }} .vhl-install__media video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  #VhlInstall-{{ section.id }} .vhl-install__placeholder {
    width: 100%;
    height: 100%;
    display: grid;
    place-items: center;
    padding: 30px;
    background: #e7e7e7;
    color: #333;
    text-align: center;
    font-size: 18px;
  }

  #VhlInstall-{{ section.id }} .vhl-install__content {
    min-width: 0;
    min-height: 570px;
    display: flex;
    align-items: center;
    background: #2d2d2d;
  }

  #VhlInstall-{{ section.id }} .vhl-install__content-inner {
    width: 100%;
    max-width: 650px;
    margin: 0 auto;
    padding: 60px 68px;
  }

  #VhlInstall-{{ section.id }} h1 {
    margin: 0 0 36px;
    color: #fff !important;
    font-family: Arial, Helvetica, sans-serif;
    font-size: 25px;
    line-height: 1.15;
    font-weight: 800;
    letter-spacing: -0.5px;
  }

  #VhlInstall-{{ section.id }} .vhl-install__text,
  #VhlInstall-{{ section.id }} .vhl-install__text p,
  #VhlInstall-{{ section.id }} .vhl-install__text strong,
  #VhlInstall-{{ section.id }} .vhl-install__text em,
  #VhlInstall-{{ section.id }} .vhl-install__text a {
    color: #fff !important;
  }

  #VhlInstall-{{ section.id }} .vhl-install__text {
    font-family: Arial, Helvetica, sans-serif;
    font-size: 15px;
    line-height: 1.45;
  }

  #VhlInstall-{{ section.id }} .vhl-install__text p {
    margin: 0 0 27px;
  }

  #VhlInstall-{{ section.id }} .vhl-install__text p:last-child {
    margin-bottom: 0;
  }

  #VhlInstall-{{ section.id }} .vhl-install__text strong {
    font-weight: 800;
  }

  #VhlInstall-{{ section.id }} .vhl-install__bottom {
    margin-top: 5px;
  }

  #VhlInstall-{{ section.id }} .vhl-install__bottom p {
    margin-bottom: 0;
  }

  #VhlInstall-{{ section.id }} .vhl-install__bottom a {
    font-weight: 800;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  @media screen and (min-width: 1500px) {
    #VhlInstall-{{ section.id }} .vhl-install__grid,
    #VhlInstall-{{ section.id }} .vhl-install__media,
    #VhlInstall-{{ section.id }} .vhl-install__content {
      min-height: 620px;
    }

    #VhlInstall-{{ section.id }} .vhl-install__media {
      height: 620px;
    }

    #VhlInstall-{{ section.id }} .vhl-install__content-inner {
      max-width: 720px;
    }
  }

  @media screen and (max-width: 989px) {
    #VhlInstall-{{ section.id }} .vhl-install__grid {
      grid-template-columns: 1fr;
      min-height: 0;
      border-bottom-width: 3px;
    }

    #VhlInstall-{{ section.id }} .vhl-install__media {
      height: auto;
      aspect-ratio: 1 / 1;
    }

    #VhlInstall-{{ section.id }} .vhl-install__content {
      min-height: 0;
    }

    #VhlInstall-{{ section.id }} .vhl-install__content-inner {
      max-width: none;
      padding: 50px 30px 58px;
    }

    #VhlInstall-{{ section.id }} h1 {
      margin-bottom: 30px;
      font-size: 25px;
    }

    #VhlInstall-{{ section.id }} .vhl-install__text {
      font-size: 15px;
    }

    #VhlInstall-{{ section.id }} .vhl-install__text p {
      margin-bottom: 24px;
    }
  }

  @media screen and (max-width: 549px) {
    #VhlInstall-{{ section.id }} .vhl-install__content-inner {
      padding: 42px 24px 48px;
    }

    #VhlInstall-{{ section.id }} h1 {
      font-size: 23px;
    }

    #VhlInstall-{{ section.id }} .vhl-install__text {
      font-size: 14px;
      line-height: 1.5;
    }
  }
</style>

{% schema %}
{
  "name": "VHL Installatie",
  "tag": "section",
  "class": "section-vhl-installation",
  "settings": [
    {
      "type": "video",
      "id": "video",
      "label": "Installatievideo"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titel",
      "default": "Hoe installeer ik mijn zuignaphaak?"
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Introductie",
      "default": "<p>Dankzij het innovatieve vacuümzuigsysteem is de installatie zo gebeurd. In tegenstelling tot andere muurbevestigde of zelfklevende haken, kunnen de VHL zuignaphaken gemakkelijk worden verwijderd zonder gaten, vlekken of kleverige resten achter te laten!</p>"
    },
    {
      "type": "richtext",
      "id": "bottom_text",
      "label": "Onderste tekst",
      "default": "<p>Heb je moeite met het installeren van je zuignaphaak? Controleer of je het op een geschikt oppervlak plaatst.</p>"
    }
  ],
  "presets": [
    {
      "name": "VHL Installatie"
    }
  ]
}
{% endschema %}
