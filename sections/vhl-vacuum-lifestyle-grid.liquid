{%- comment -%}
  VHL Vacuum Hook PDP — full-width lifestyle collage.
  Merchant voegt eigen VHL-afbeelding(en) toe via blocks.
  Desktop is bewust edge-to-edge zoals de referentie.
{%- endcomment -%}

{%- liquid
  assign visible_blocks = 0
  for block in section.blocks
    if block.settings.image != blank
      assign visible_blocks = visible_blocks | plus: 1
    endif
  endfor
-%}

{% if visible_blocks > 0 %}
  <section id="VHLLifestyle-{{ section.id }}" class="vhl-vacuum-lifestyle" {{ section.shopify_attributes }}>
    {% if section.settings.eyebrow != blank or section.settings.heading != blank %}
      <div class="vhl-vacuum-lifestyle__header">
        {% if section.settings.eyebrow != blank %}
          <p class="vhl-vacuum-lifestyle__eyebrow">{{ section.settings.eyebrow }}</p>
        {% endif %}
        {% if section.settings.heading != blank %}
          <h2 class="vhl-vacuum-lifestyle__heading">{{ section.settings.heading }}</h2>
        {% endif %}
      </div>
    {% endif %}

    <div class="vhl-vacuum-lifestyle__track">
      {% for block in section.blocks %}
        {% if block.settings.image != blank %}
          <figure class="vhl-vacuum-lifestyle__item" {{ block.shopify_attributes }}>
            {{
              block.settings.image
              | image_url: width: 2400
              | image_tag:
                loading: 'lazy',
                class: 'vhl-vacuum-lifestyle__image',
                widths: '750,1000,1400,1800,2200,2400',
                sizes: '100vw'
            }}
            {% if block.settings.caption != blank %}
              <figcaption class="vhl-vacuum-lifestyle__caption">{{ block.settings.caption }}</figcaption>
            {% endif %}
          </figure>
        {% endif %}
      {% endfor %}
    </div>
  </section>

  {% style %}
    #VHLLifestyle-{{ section.id }} {
      width: 100%;
      max-width: none;
      margin: 0;
      padding: 0;
      background: #fff;
      overflow: hidden;
    }

    #VHLLifestyle-{{ section.id }} .vhl-vacuum-lifestyle__header {
      width: min(1400px, calc(100% - 48px));
      margin: 0 auto 28px;
      padding-top: 56px;
    }

    #VHLLifestyle-{{ section.id }} .vhl-vacuum-lifestyle__eyebrow {
      margin: 0 0 10px;
      font-size: 11px;
      font-weight: 700;
      letter-spacing: .18em;
      text-transform: uppercase;
      color: #8a8a86;
    }

    #VHLLifestyle-{{ section.id }} .vhl-vacuum-lifestyle__heading {
      margin: 0;
      font-size: clamp(24px, 3vw, 34px);
      color: #1a1a1a;
    }

    #VHLLifestyle-{{ section.id }} .vhl-vacuum-lifestyle__track {
      width: 100%;
      max-width: none;
      margin: 0;
      padding: 0;
      display: grid;
      grid-template-columns: repeat({{ visible_blocks }}, minmax(0, 1fr));
      gap: 0;
      overflow: hidden;
    }

    #VHLLifestyle-{{ section.id }} .vhl-vacuum-lifestyle__item {
      position: relative;
      margin: 0;
      padding: 0;
      border-radius: 0;
      overflow: hidden;
      background: #f7f5f2;
    }

    #VHLLifestyle-{{ section.id }} .vhl-vacuum-lifestyle__image {
      display: block;
      width: 100%;
      height: auto;
      min-height: 0;
      object-fit: cover;
      border-radius: 0;
    }

    #VHLLifestyle-{{ section.id }} .vhl-vacuum-lifestyle__caption {
      position: absolute;
      left: 16px;
      bottom: 14px;
      margin: 0;
      padding: 0;
      font-size: 12px;
      color: #fff;
    }

    @media screen and (min-width: 990px) {
      #VHLLifestyle-{{ section.id }} {
        width: 100vw;
        max-width: 100vw;
        margin-left: calc(50% - 50vw);
        margin-right: calc(50% - 50vw);
      }

      #VHLLifestyle-{{ section.id }} .vhl-vacuum-lifestyle__header {
        width: min(1400px, calc(100% - 96px));
        padding-top: 72px;
      }

      #VHLLifestyle-{{ section.id }} .vhl-vacuum-lifestyle__track {
        width: 100vw;
        max-width: 100vw;
      }

      #VHLLifestyle-{{ section.id }} .vhl-vacuum-lifestyle__image {
        width: 100%;
        height: auto;
      }
    }

    @media screen and (max-width: 989px) {
      #VHLLifestyle-{{ section.id }} .vhl-vacuum-lifestyle__track {
        display: flex;
        overflow-x: auto;
        scroll-snap-type: x mandatory;
        -webkit-overflow-scrolling: touch;
        scrollbar-width: none;
      }

      #VHLLifestyle-{{ section.id }} .vhl-vacuum-lifestyle__track::-webkit-scrollbar {
        display: none;
      }

      #VHLLifestyle-{{ section.id }} .vhl-vacuum-lifestyle__item {
        flex: 0 0 88vw;
        scroll-snap-align: start;
      }
    }
  {% endstyle %}
{% endif %}

{% schema %}
{
  "name": "VHL Lifestyle grid",
  "tag": "section",
  "class": "vhl-vacuum-lifestyle-section",
  "max_blocks": 8,
  "settings": [
    {"type":"text","id":"eyebrow","label":"Boventitel (optioneel)"},
    {"type":"text","id":"heading","label":"Titel (optioneel)"}
  ],
  "blocks": [
    {
      "type":"image",
      "name":"Afbeelding",
      "settings":[
        {"type":"image_picker","id":"image","label":"Afbeelding"},
        {"type":"text","id":"caption","label":"Onderschrift (optioneel)"}
      ]
    }
  ],
  "presets":[{"name":"VHL Lifestyle grid"}]
}
{% endschema %}
