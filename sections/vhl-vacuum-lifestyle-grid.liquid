{%- comment -%}
  VHL Vacuum Hook PDP — editorial lifestyle image grid/collage.
  Geïsoleerd, merchant voegt eigen VHL-afbeeldingen toe via blocks.
  Een block zonder afbeelding rendert niets (geen broken placeholder).
{%- endcomment -%}

{%- liquid
  assign visible_blocks = 0
  for block in section.blocks
    if block.settings.image != blank
      assign visible_blocks = visible_blocks | plus: 1
    endif
  endfor
-%}

{% if visible_blocks > 0 %}
  <section id="VHLLifestyle-{{ section.id }}" class="vhl-vacuum-lifestyle" {{ section.shopify_attributes }}>
    {% if section.settings.eyebrow != blank or section.settings.heading != blank %}
      <div class="vhl-vacuum-lifestyle__header">
        {% if section.settings.eyebrow != blank %}
          <p class="vhl-vacuum-lifestyle__eyebrow">{{ section.settings.eyebrow }}</p>
        {% endif %}
        {% if section.settings.heading != blank %}
          <h2 class="vhl-vacuum-lifestyle__heading">{{ section.settings.heading }}</h2>
        {% endif %}
      </div>
    {% endif %}

    <div class="vhl-vacuum-lifestyle__track">
      {% for block in section.blocks %}
        {% if block.settings.image != blank %}
          <figure class="vhl-vacuum-lifestyle__item" {{ block.shopify_attributes }}>
            {{
              block.settings.image
              | image_url: width: 1000
              | image_tag: loading: 'lazy', class: 'vhl-vacuum-lifestyle__image', widths: '400,600,800,1000'
            }}
            {% if block.settings.caption != blank %}
              <figcaption class="vhl-vacuum-lifestyle__caption">{{ block.settings.caption }}</figcaption>
            {% endif %}
          </figure>
        {% endif %}
      {% endfor %}
    </div>
  </section>

  {% style %}
    #VHLLifestyle-{{ section.id }} {
      padding: 56px 16px;
      background: #ffffff;
    }

    @media screen and (min-width: 990px) {
      #VHLLifestyle-{{ section.id }} {
        padding: 72px 48px;
      }
    }

    #VHLLifestyle-{{ section.id }} .vhl-vacuum-lifestyle__header {
      max-width: 1400px;
      margin: 0 auto 28px;
    }

    #VHLLifestyle-{{ section.id }} .vhl-vacuum-lifestyle__eyebrow {
      margin: 0 0 10px;
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: #8a8a86;
    }

    #VHLLifestyle-{{ section.id }} .vhl-vacuum-lifestyle__heading {
      margin: 0;
      font-size: clamp(24px, 3vw, 34px);
      color: #1a1a1a;
    }

    #VHLLifestyle-{{ section.id }} .vhl-vacuum-lifestyle__track {
      max-width: 1600px;
      margin: 0 auto;
      display: grid;
      grid-auto-flow: column;
      grid-auto-columns: minmax(240px, 1fr);
      gap: 16px;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      padding-bottom: 4px;
    }

    #VHLLifestyle-{{ section.id }} .vhl-vacuum-lifestyle__track::-webkit-scrollbar {
      display: none;
    }

    @media screen and (min-width: 990px) {
      #VHLLifestyle-{{ section.id }} .vhl-vacuum-lifestyle__track {
        grid-auto-columns: minmax(0, 1fr);
        grid-auto-flow: row;
        grid-template-columns: repeat(4, 1fr);
        overflow-x: visible;
      }
    }

    #VHLLifestyle-{{ section.id }} .vhl-vacuum-lifestyle__item {
      margin: 0;
      scroll-snap-align: start;
      border-radius: 14px;
      overflow: hidden;
      background: #f7f5f2;
    }

    #VHLLifestyle-{{ section.id }} .vhl-vacuum-lifestyle__image {
      display: block;
      width: 100%;
      height: 320px;
      object-fit: cover;
    }

    #VHLLifestyle-{{ section.id }} .vhl-vacuum-lifestyle__caption {
      padding: 10px 4px 0;
      font-size: 12px;
      color: #8a8a86;
    }
  {% endstyle %}
{% endif %}

{% schema %}
{
  "name": "VHL Vacuumhaak — Lifestyle grid",
  "tag": "section",
  "class": "vhl-vacuum-lifestyle-section",
  "max_blocks": 8,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Boventitel (optioneel)"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titel (optioneel)"
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Afbeelding",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Afbeelding"
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Onderschrift (optioneel)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "VHL Vacuumhaak — Lifestyle grid"
    }
  ]
}
{% endschema %}
