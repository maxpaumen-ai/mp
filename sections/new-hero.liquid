{%- liquid
  comment
    Collectie-bewuste fallback-keten, zodat EEN gedeelde hero-instance
    (bv. de instance in templates/collection.json, hergebruikt door elke
    "gewone" subcollectie) automatisch de juiste titel/afbeelding toont
    zonder per-collectie configuratie. Expliciete section-settings winnen
    altijd -- dit raakt dus nooit de homepage-instance (die alle velden
    al expliciet vult) en nooit de 4 bestaande hoofdcategorie-templates
    (heading/subheading daar al expliciet gezet).

    Tekst:
      heading    -> section.settings.heading, anders de bestaande PDP-
                    storytelling-metafield custom.pdp_functional_headline,
                    anders collection.title.
      subheading -> section.settings.subheading, anders de metafield
                    custom.pdp_functional_body_1
                    (geen collection.description-fallback: dat is vaak te
                    lang voor een 1-regelige hero-subtitel; ontbreekt de
                    metafield, dan toont de hero gewoon geen subheading --
                    al bestaand, geaccepteerd gedrag, geen kapotte layout).

    Afbeelding (desktop):
      1. section.settings.image (expliciet)
      2. collection.image
      3. (geen van beide) -> bestaande donkere fallback-achtergrond

    Afbeelding (mobiel):
      1. section.settings.mobile_image (expliciet)
      2. section.settings.image (expliciete desktop-afbeelding hergebruikt
         op mobiel -- veiliger dan direct naar collection.image springen
         wanneer de merchant wél een eigen desktop-foto koos maar nog geen
         aparte mobiele crop)
      3. collection.image
      4. (geen van alle) -> bestaande donkere fallback-achtergrond

    Video's zijn hier bewust buiten gelaten: die behouden hun bestaande,
    hoogste prioriteit als ze expliciet ingesteld zijn (collecties hebben
    geen automatische video-bron).
  endcomment

  assign hero_heading = section.settings.heading | default: collection.metafields.custom.pdp_functional_headline.value | default: collection.title
  assign hero_subheading = section.settings.subheading | default: collection.metafields.custom.pdp_functional_body_1.value
  assign hero_desktop_image = section.settings.image | default: collection.image
  assign hero_mobile_image = section.settings.mobile_image | default: section.settings.image | default: collection.image
-%}
<section id="VHLVideoHero-{{ section.id }}" class="vhl-video-hero{% if section.settings.mobile_heading_style == 'large' %} vhl-video-hero--mobile-heading-large{% endif %}">

  <div class="vhl-video-hero__media">

    {% if section.settings.video != blank %}
      <div class="vhl-video-hero__desktop-media">
        {{
          section.settings.video
          | video_tag:
            autoplay: true,
            loop: true,
            muted: true,
            controls: false,
            playsinline: true,
            class: 'vhl-video-hero__video'
        }}
      </div>
    {% endif %}

    {% if section.settings.mobile_video != blank %}
      <div class="vhl-video-hero__mobile-media">
        {{
          section.settings.mobile_video
          | video_tag:
            autoplay: true,
            loop: true,
            muted: true,
            controls: false,
            playsinline: true,
            class: 'vhl-video-hero__video'
        }}
      </div>
    {% endif %}

    {% if section.settings.video == blank and hero_desktop_image != blank %}
      <div class="vhl-video-hero__desktop-media">
        {{
          hero_desktop_image
          | image_url: width: 2400
          | image_tag:
            loading: 'eager',
            class: 'vhl-video-hero__image'
        }}
      </div>
    {% endif %}

    {% if section.settings.mobile_video == blank and hero_mobile_image != blank %}
      <div class="vhl-video-hero__mobile-media">
        {{
          hero_mobile_image
          | image_url: width: 1200
          | image_tag:
            loading: 'eager',
            class: 'vhl-video-hero__image'
        }}
      </div>
    {% endif %}

  </div>

  <div class="vhl-video-hero__overlay"></div>

  <div class="vhl-video-hero__inner">
    <div class="vhl-video-hero__content">

      {% if section.settings.eyebrow != blank %}
        <p class="vhl-video-hero__eyebrow">
          {{ section.settings.eyebrow | escape }}
        </p>
      {% endif %}

      {% if hero_heading != blank %}
        <h1 class="vhl-video-hero__heading">
          {{ hero_heading | escape }}
        </h1>
      {% endif %}

      {% if hero_subheading != blank %}
        <p class="vhl-video-hero__subheading">
          {{ hero_subheading | escape }}
        </p>
      {% endif %}

      {% if section.settings.button_label != blank %}
        <a
          class="vhl-video-hero__button"
          href="{{ section.settings.button_link | default: routes.all_products_collection_url }}"
        >
          {{ section.settings.button_label | escape }}
        </a>
      {% endif %}

    </div>
  </div>

</section>

{% style %}

/* =========================================================
   HERO BASIS
========================================================= */

#VHLVideoHero-{{ section.id }} {
  position: relative;
  width: 100%;
  min-height: {{ section.settings.desktop_height }}px;
  overflow: hidden;
  isolation: isolate;
  background: #171614;
  color: #fff;
}


/* =========================================================
   VIDEO
========================================================= */

#VHLVideoHero-{{ section.id }} .vhl-video-hero__media {
  position: absolute;
  inset: 0;
  z-index: -2;
}

#VHLVideoHero-{{ section.id }} .vhl-video-hero__desktop-media,
#VHLVideoHero-{{ section.id }} .vhl-video-hero__mobile-media {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

#VHLVideoHero-{{ section.id }} .vhl-video-hero__mobile-media {
  display: none;
}

#VHLVideoHero-{{ section.id }} .vhl-video-hero__video,
#VHLVideoHero-{{ section.id }} .vhl-video-hero__image {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center center;
}


/* =========================================================
   OVERLAY
========================================================= */

#VHLVideoHero-{{ section.id }} .vhl-video-hero__overlay {
  position: absolute;
  inset: 0;
  z-index: -1;
  pointer-events: none;

  background:
    linear-gradient(
      90deg,
      rgba(7, 7, 7, 0.38) 0%,
      rgba(7, 7, 7, 0.18) 34%,
      rgba(7, 7, 7, 0.05) 62%,
      rgba(7, 7, 7, 0.00) 100%
    );
}


/* =========================================================
   DESKTOP CONTENT
========================================================= */

#VHLVideoHero-{{ section.id }} .vhl-video-hero__inner {
  width: min(100%, 1600px);
  min-height: {{ section.settings.desktop_height }}px;

  margin: 0 auto;

  padding:
    150px
    clamp(42px, 5.5vw, 105px)
    70px;

  display: flex;
  align-items: center;
}

#VHLVideoHero-{{ section.id }} .vhl-video-hero__content {
  width: auto;
  max-width: none;

  transform: translateY(35px);
}


/* =========================================================
   EYEBROW
========================================================= */

#VHLVideoHero-{{ section.id }} .vhl-video-hero__eyebrow {
  margin: 0 0 15px;

  color: #fff;

  font-size: 11px;
  line-height: 1;

  font-weight: 600;

  letter-spacing: .19em;
  text-transform: uppercase;
}


/* =========================================================
   HEADLINE — DESKTOP
========================================================= */

#VHLVideoHero-{{ section.id }} .vhl-video-hero__heading {
  margin: 0;

  width: max-content;
  max-width: none;

  white-space: nowrap;

  color: #fff !important;

  font-family: var(--font-heading-family, sans-serif);

  font-size: clamp(38px, 3.6vw, 58px);
  line-height: 1;

  font-weight: 600;

  letter-spacing: -.035em;
}


/* =========================================================
   SUBHEADING
   Bewust GEEN white-space:nowrap / width:max-content zoals de
   heading: dit is doorlopende zinstekst (bv. "Ontworpen voor
   rust. Gemaakt voor elke dag.") die normaal moet kunnen
   omwikkelen i.p.v. horizontaal af te snijden.
========================================================= */

#VHLVideoHero-{{ section.id }} .vhl-video-hero__subheading {
  margin: 14px 0 0;

  max-width: 480px;

  color: rgba(255, 255, 255, .88);

  font-size: 16px;
  line-height: 1.5;

  font-weight: 400;

  letter-spacing: -.005em;
}


/* =========================================================
   CTA
========================================================= */

#VHLVideoHero-{{ section.id }} .vhl-video-hero__button {
  display: inline-flex;

  min-width: 160px;
  min-height: 43px;

  margin-top: 26px;

  padding: 12px 22px;

  align-items: center;
  justify-content: center;

  border-radius: 999px;

  background: #fff;
  color: #2a2927;

  text-decoration: none;

  font-size: 10px;
  line-height: 1;

  font-weight: 700;

  letter-spacing: .095em;
  text-transform: uppercase;

  box-shadow: 0 2px 10px rgba(0,0,0,.05);
}


/* =========================================================
   HEADER OVER HERO — HOMEPAGE ONLY
========================================================= */

body.template-index .shopify-section-group-header-group {
  position: absolute !important;

  top: 0;
  left: 0;

  width: 100%;

  z-index: 50;

  background: transparent !important;
}


body.template-index .shopify-section-group-header-group .header-wrapper,
body.template-index .shopify-section-group-header-group .header,
body.template-index .shopify-section-group-header-group .vhl-header,
body.template-index .shopify-section-group-header-group .vhl-header__inner,
body.template-index .shopify-section-group-header-group .vhl-header__desktop,
body.template-index .shopify-section-group-header-group .vhl-header__mobile,
body.template-index .shopify-section-group-header-group .vhl-header__main,
body.template-index .shopify-section-group-header-group .vhl-header__nav,
body.template-index .shopify-section-group-header-group nav {
  background: transparent !important;
  background-color: transparent !important;

  box-shadow: none !important;
}


body.template-index .shopify-section-group-header-group .header-wrapper,
body.template-index .shopify-section-group-header-group .vhl-header,
body.template-index .shopify-section-group-header-group .vhl-header__nav {
  border-color: rgba(255,255,255,.16) !important;
}


body.template-index .shopify-section-group-header-group input[type="search"],
body.template-index .shopify-section-group-header-group .search__input,
body.template-index .shopify-section-group-header-group .vhl-header__search input,
body.template-index .shopify-section-group-header-group .vhl-search input {
  background: rgba(255,255,255,.82) !important;

  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);

  border-color: rgba(255,255,255,.28) !important;
}


/* =========================================================
   DESKTOP HEADER COLORS
========================================================= */

@media screen and (min-width: 750px) {

  body.template-index .shopify-section-group-header-group a,
  body.template-index .shopify-section-group-header-group button,
  body.template-index .shopify-section-group-header-group svg {
    color: #fff !important;
  }

  body.template-index .shopify-section-group-header-group svg {
    stroke: currentColor;
  }

}


/* =========================================================
   MOBIEL
========================================================= */

@media screen and (max-width: 749px) {

  #VHLVideoHero-{{ section.id }} {
    min-height: {{ section.settings.mobile_height }}px;
  }


  /* VIDEO */

  #VHLVideoHero-{{ section.id }} .vhl-video-hero__desktop-media {
    display: none;
  }

  #VHLVideoHero-{{ section.id }} .vhl-video-hero__mobile-media {
    display: block;
  }

  #VHLVideoHero-{{ section.id }} .vhl-video-hero__video,
  #VHLVideoHero-{{ section.id }} .vhl-video-hero__image {
    width: 100%;
    height: 100%;

    object-fit: cover;

    object-position: center center;
  }


  /* OVERLAY */

  #VHLVideoHero-{{ section.id }} .vhl-video-hero__overlay {
    background:
      linear-gradient(
        180deg,

        rgba(8,7,6,0.00) 0%,
        rgba(8,7,6,0.00) 48%,
        rgba(8,7,6,0.10) 62%,
        rgba(8,7,6,0.36) 78%,
        rgba(8,7,6,0.70) 100%
      );
  }


  /* CONTENT */

  #VHLVideoHero-{{ section.id }} .vhl-video-hero__inner {
    min-height: {{ section.settings.mobile_height }}px;

    padding:
      125px
      20px
      36px;

    align-items: flex-end;
  }

  #VHLVideoHero-{{ section.id }} .vhl-video-hero__content {
    width: 100%;
    max-width: none;

    transform: none;
  }


  /* EYEBROW */

  #VHLVideoHero-{{ section.id }} .vhl-video-hero__eyebrow {
    margin-bottom: 9px;

    font-size: 9px;
  }


  /* =====================================================
     MOBIELE HEADLINE
     ÉÉN REGEL + DUNNER
  ===================================================== */

  #VHLVideoHero-{{ section.id }} .vhl-video-hero__heading {
    display: block !important;

    width: auto !important;

    max-width: calc(100vw - 40px) !important;

    margin: 0 !important;

    white-space: nowrap !important;

    overflow: visible !important;
    text-overflow: clip !important;

    color: #fff !important;

    font-size: 16px !important;

    line-height: 1.1 !important;

    font-weight: 300 !important;

    letter-spacing: -0.01em !important;
  }


  /* =====================================================
     OPT-IN: GROTE MOBIELE HEADLINE
     Alleen actief met mobile_heading_style = "large" (nieuwe
     category-landingpagina's). Hogere specificiteit dan de
     compacte basisregel hierboven (extra modifier-klasse), dus
     wint ongeacht bronvolgorde -- de homepage-instance zet deze
     klasse niet en blijft dus op de compacte 1-regelige stijl.
  ===================================================== */

  #VHLVideoHero-{{ section.id }}.vhl-video-hero--mobile-heading-large .vhl-video-hero__heading {
    white-space: normal !important;

    font-size: clamp(32px, 11vw, 46px) !important;

    line-height: 1.05 !important;

    font-weight: 600 !important;

    letter-spacing: -.03em !important;
  }


  /* SUBHEADING */

  #VHLVideoHero-{{ section.id }} .vhl-video-hero__subheading {
    margin-top: 10px;

    max-width: calc(100vw - 40px);

    font-size: 13px;
    line-height: 1.5;
  }


  /* CTA */

  #VHLVideoHero-{{ section.id }} .vhl-video-hero__button {
    min-width: 150px;
    min-height: 42px;

    margin-top: 18px;

    padding: 11px 18px;

    font-size: 9px;
  }


  /* MOBIELE HEADER TRANSPARANT */

  body.template-index .shopify-section-group-header-group {
    position: absolute !important;

    top: 0;
    left: 0;

    width: 100%;

    z-index: 50;
  }

  body.template-index .shopify-section-group-header-group .header-wrapper,
  body.template-index .shopify-section-group-header-group .header,
  body.template-index .shopify-section-group-header-group .vhl-header,
  body.template-index .shopify-section-group-header-group .vhl-header__inner,
  body.template-index .shopify-section-group-header-group .vhl-header__mobile,
  body.template-index .shopify-section-group-header-group .vhl-header__main {
    background: transparent !important;
    background-color: transparent !important;

    box-shadow: none !important;
  }

}


/* =========================================================
   SMALL PHONE
========================================================= */

@media screen and (max-width: 390px) {

  #VHLVideoHero-{{ section.id }} .vhl-video-hero__heading {
    font-size: 15px !important;

    line-height: 1.1 !important;

    font-weight: 300 !important;

    letter-spacing: -0.008em !important;

    white-space: nowrap !important;
  }

  #VHLVideoHero-{{ section.id }}.vhl-video-hero--mobile-heading-large .vhl-video-hero__heading {
    font-size: clamp(26px, 10.5vw, 34px) !important;

    line-height: 1.05 !important;

    font-weight: 600 !important;

    letter-spacing: -.02em !important;

    white-space: normal !important;
  }

}


/* =========================================================
   VERY SMALL PHONE
========================================================= */

@media screen and (max-width: 350px) {

  #VHLVideoHero-{{ section.id }} .vhl-video-hero__heading {
    font-size: 14px !important;

    font-weight: 300 !important;
  }

  #VHLVideoHero-{{ section.id }}.vhl-video-hero--mobile-heading-large .vhl-video-hero__heading {
    font-size: 24px !important;

    font-weight: 600 !important;
  }

}

{% endstyle %}


<script>
(() => {

  const hero =
    document.getElementById(
      'VHLVideoHero-{{ section.id }}'
    );

  if (!hero) return;

  const videos =
    hero.querySelectorAll('video');

  videos.forEach((video) => {

    video.muted = true;

    video.setAttribute('muted', '');
    video.setAttribute('playsinline', '');
    video.setAttribute('webkit-playsinline', '');

    if (
      !window.matchMedia(
        '(prefers-reduced-motion: reduce)'
      ).matches
    ) {

      const playPromise = video.play();

      if (playPromise) {
        playPromise.catch(() => {});
      }

    }

  });

})();
</script>


{% schema %}
{
  "name": "VHL Video Hero",

  "settings": [

    {
      "type": "video",
      "id": "video",
      "label": "Hero video desktop"
    },

    {
      "type": "video",
      "id": "mobile_video",
      "label": "Hero video mobiel"
    },

    {
      "type": "image_picker",
      "id": "image",
      "label": "Fallback afbeelding"
    },

    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobiele fallback-afbeelding"
    },

    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlaysterkte desktop",
      "min": 20,
      "max": 90,
      "step": 5,
      "unit": "%",
      "default": 40
    },

    {
      "type": "range",
      "id": "desktop_height",
      "label": "Hoogte desktop",
      "min": 520,
      "max": 900,
      "step": 10,
      "unit": "px",
      "default": 700
    },

    {
      "type": "range",
      "id": "mobile_height",
      "label": "Hoogte mobiel",
      "min": 600,
      "max": 900,
      "step": 10,
      "unit": "px",
      "default": 760
    },

    {
      "type": "text",
      "id": "eyebrow",
      "label": "Boventitel",
      "default": "VANHOUTEN LIVING"
    },

    {
      "type": "text",
      "id": "heading",
      "label": "Titel",
      "default": "Rust begint in de badkamer."
    },

    {
      "type": "text",
      "id": "subheading",
      "label": "Subtitel",
      "info": "Optioneel. Leeg = niet getoond (geen wijziging op bestaande hero-instances)."
    },

    {
      "type": "select",
      "id": "mobile_heading_style",
      "label": "Titelstijl mobiel",
      "options": [
        { "value": "compact", "label": "Compact (huidig, dunne 1-regelige titel)" },
        { "value": "large", "label": "Groot (premium, voor korte titels)" }
      ],
      "default": "compact",
      "info": "\"Compact\" is het bestaande, ongewijzigde gedrag (o.a. de homepage-hero). \"Groot\" is bedoeld voor korte titels zoals categorienamen."
    },

    {
      "type": "text",
      "id": "button_label",
      "label": "Knoptekst",
      "default": "Ontdek de collectie"
    },

    {
      "type": "url",
      "id": "button_link",
      "label": "Knoplink"
    }

  ],

  "presets": [
    {
      "name": "VHL Video Hero"
    }
  ]
}
{% endschema %}