{%- liquid
  assign hero_heading = section.settings.heading
  assign hero_subheading = section.settings.subheading
  assign hero_desktop_image = section.settings.image
  assign hero_mobile_image = section.settings.mobile_image | default: section.settings.image
  assign hero_desktop_video = section.settings.video
  assign hero_mobile_video = section.settings.mobile_video

  if collection != blank
    assign collection_desktop_image = collection.metafields.custom.hero_desktop_image.value
    assign collection_mobile_image = collection.metafields.custom.hero_mobile_image.value

    if collection_desktop_image != blank
      assign hero_desktop_image = collection_desktop_image
      assign hero_desktop_video = blank
    endif

    if collection_mobile_image != blank
      assign hero_mobile_image = collection_mobile_image
      assign hero_mobile_video = blank
    elsif collection_desktop_image != blank
      assign hero_mobile_image = collection_desktop_image
      assign hero_mobile_video = blank
    endif
  endif

  if section.settings.use_collection_fallback and collection != blank
    if hero_heading == blank
      assign hero_heading = collection.metafields.custom.pdp_functional_headline.value | default: collection.title
    endif
    if hero_subheading == blank
      assign hero_subheading = collection.metafields.custom.pdp_functional_body_1.value
    endif
    if hero_desktop_image == blank
      assign hero_desktop_image = collection.image
    endif
    if hero_mobile_image == blank
      assign hero_mobile_image = collection.image
    endif
  endif
-%}

<section

  id="VHLVideoHero-{{ section.id }}"

  class="vhl-video-hero{% if section.settings.mobile_heading_style == 'large' %} vhl-video-hero--mobile-heading-large{% endif %}"

>

  <div class="vhl-video-hero__media">

    {% if hero_desktop_video != blank %}

    <div class="vhl-video-hero__desktop-media">

      {{ hero_desktop_video | video_tag: autoplay: true, loop: true, muted: true, controls: false, playsinline: true, class: 'vhl-video-hero__video' }}

    </div>

  {% elsif hero_desktop_image != blank %}

    <div class="vhl-video-hero__desktop-media">

      {{ hero_desktop_image | image_url: width: 2400 | image_tag: loading: 'eager', widths: '1000, 1400, 1800, 2200, 2400', sizes: '100vw', class: 'vhl-video-hero__image' }}

    </div>

  {% endif %}

  {% if hero_mobile_video != blank %}

    <div class="vhl-video-hero__mobile-media">

      {{ hero_mobile_video | video_tag: autoplay: true, loop: true, muted: true, controls: false, playsinline: true, class: 'vhl-video-hero__video' }}

    </div>

  {% elsif hero_mobile_image != blank %}

    <div class="vhl-video-hero__mobile-media">

      {{ hero_mobile_image | image_url: width: 1400 | image_tag: loading: 'eager', widths: '500, 750, 900, 1100, 1400', sizes: '100vw', class: 'vhl-video-hero__image' }}

    </div>

  {% elsif hero_desktop_video != blank %}

    <div class="vhl-video-hero__mobile-media">

      {{ hero_desktop_video | video_tag: autoplay: true, loop: true, muted: true, controls: false, playsinline: true, class: 'vhl-video-hero__video' }}

    </div>

  {% elsif hero_desktop_image != blank %}

    <div class="vhl-video-hero__mobile-media">

      {{ hero_desktop_image | image_url: width: 1400 | image_tag: loading: 'eager', widths: '500, 750, 900, 1100, 1400', sizes: '100vw', class: 'vhl-video-hero__image' }}

    </div>

  {% endif %}

  </div>

  <div class="vhl-video-hero__overlay"></div>

    {% if section.settings.eyebrow != blank

      or hero_heading != blank

      or hero_subheading != blank

      or section.settings.button_label != blank

    %}

      <div class="vhl-video-hero__inner">

        <div class="vhl-video-hero__content">

          {% if section.settings.eyebrow != blank %}

            <p class="vhl-video-hero__eyebrow">

              {{ section.settings.eyebrow | escape }}

            </p>

          {% endif %}

          {% if hero_heading != blank %}

            <h1 class="vhl-video-hero__heading">

              {{ hero_heading | escape }}

            </h1>

          {% endif %}

          {% if hero_subheading != blank %}

            <p class="vhl-video-hero__subheading">

              {{ hero_subheading | escape }}

            </p>

          {% endif %}

          {% if section.settings.button_label != blank %}

            <a

              class="vhl-video-hero__button"

              href="{{ section.settings.button_link | default: routes.all_products_collection_url }}"

            >

              {{ section.settings.button_label | escape }}

            </a>

          {% endif %}

        </div>

      </div>

    {% endif %}

</section>

{% style %}

#VHLVideoHero-{{ section.id }} {

  position: relative;

  width: 100%;

  min-height: {{ section.settings.desktop_height }}px;

  overflow: hidden;

  isolation: isolate;

  background: #171614;

  color: #ffffff;

}

/* =========================

   MEDIA

\========================= */

#VHLVideoHero-{{ section.id }} .vhl-video-hero__media {

  position: absolute;

  inset: 0;

  width: 100%;

  height: 100%;

  z-index: 0;

  overflow: hidden;

}

#VHLVideoHero-{{ section.id }} .vhl-video-hero__desktop-media,

#VHLVideoHero-{{ section.id }} .vhl-video-hero__mobile-media {

  position: absolute;

  inset: 0;

  width: 100%;

  height: 100%;

}

#VHLVideoHero-{{ section.id }} .vhl-video-hero__desktop-media {

  display: block;

}

#VHLVideoHero-{{ section.id }} .vhl-video-hero__mobile-media {

  display: none;

}

#VHLVideoHero-{{ section.id }} .vhl-video-hero__video,

#VHLVideoHero-{{ section.id }} .vhl-video-hero__image {

  display: block;

  width: 100%;

  height: 100%;

  object-fit: cover;

  object-position: center center;

}

/* =========================

   OVERLAY

\========================= */

#VHLVideoHero-{{ section.id }} .vhl-video-hero__overlay {

  position: absolute;

  inset: 0;

  z-index: 1;

  pointer-events: none;

  background:

    linear-gradient(

      90deg,

      rgba(7, 7, 7, {{ section.settings.overlay_opacity | divided_by: 100.0 }}) 0%,

      rgba(7, 7, 7, 0.18) 34%,

      rgba(7, 7, 7, 0.05) 62%,

      rgba(7, 7, 7, 0) 100%

    );

}

/* =========================

   CONTENT

\========================= */

#VHLVideoHero-{{ section.id }} .vhl-video-hero__inner {

  position: relative;

  z-index: 2;

  width: min(100%, 1600px);

  min-height: {{ section.settings.desktop_height }}px;

  margin: 0 auto;

  padding:

    150px

    clamp(42px, 5.5vw, 105px)

    70px;

  display: flex;

  align-items: center;

}

#VHLVideoHero-{{ section.id }} .vhl-video-hero__content {

  width: auto;

  max-width: none;

  transform: translateY(35px);

}

/* =========================

   EYEBROW

\========================= */

#VHLVideoHero-{{ section.id }} .vhl-video-hero__eyebrow {

  margin: 0 0 15px;

  color: #ffffff;

  font-size: 11px;

  line-height: 1;

  font-weight: 600;

  letter-spacing: .19em;

  text-transform: uppercase;

}

/* =========================

   HEADING

\========================= */

#VHLVideoHero-{{ section.id }} .vhl-video-hero__heading {

  margin: 0;

  width: max-content;

  max-width: none;

  white-space: nowrap;

  color: #ffffff !important;

  font-family: var(--font-heading-family, sans-serif);

  font-size: clamp(38px, 3.6vw, 58px);

  line-height: 1;

  font-weight: 600;

  letter-spacing: -.035em;

}

/* =========================

   SUBHEADING

\========================= */

#VHLVideoHero-{{ section.id }} .vhl-video-hero__subheading {

  margin: 14px 0 0;

  max-width: 480px;

  color: rgba(255,255,255,.88);

  font-size: 16px;

  line-height: 1.5;

  font-weight: 400;

}

/* =========================

   BUTTON

\========================= */

#VHLVideoHero-{{ section.id }} .vhl-video-hero__button {

  display: inline-flex;

  min-width: 160px;

  min-height: 43px;

  margin-top: 26px;

  padding: 12px 22px;

  align-items: center;

  justify-content: center;

  border-radius: 999px;

  background: #ffffff;

  color: #2a2927;

  text-decoration: none;

  font-size: 10px;

  line-height: 1;

  font-weight: 700;

  letter-spacing: .095em;

  text-transform: uppercase;

}

/* =========================

   MOBILE

\========================= */

@media screen and (max-width: 749px) {

  #VHLVideoHero-{{ section.id }} {

    min-height: {{ section.settings.mobile_height }}px;

  }

  #VHLVideoHero-{{ section.id }} .vhl-video-hero__desktop-media {

    display: none;

  }

  #VHLVideoHero-{{ section.id }} .vhl-video-hero__mobile-media {

    display: block;

  }

  #VHLVideoHero-{{ section.id }} .vhl-video-hero__video,

  #VHLVideoHero-{{ section.id }} .vhl-video-hero__image {

    width: 100%;

    height: 100%;

    object-fit: cover;

    object-position: center center;

  }

  #VHLVideoHero-{{ section.id }} .vhl-video-hero__inner {

    min-height: {{ section.settings.mobile_height }}px;

    padding:

      125px

      20px

      36px;

    align-items: flex-end;

  }

  #VHLVideoHero-{{ section.id }} .vhl-video-hero__content {

    width: 100%;

    max-width: none;

    transform: none;

  }

  #VHLVideoHero-{{ section.id }} .vhl-video-hero__heading {

    display: block !important;

    width: auto !important;

    max-width: calc(100vw - 40px) !important;

    margin: 0 !important;

    color: #ffffff !important;

    font-size: 16px !important;

    line-height: 1.1 !important;

    font-weight: 300 !important;

  }

  #VHLVideoHero-{{ section.id }}.vhl-video-hero--mobile-heading-large .vhl-video-hero__heading {

    white-space: normal !important;

    font-size: clamp(32px, 11vw, 46px) !important;

    line-height: 1.05 !important;

    font-weight: 600 !important;

  }

  #VHLVideoHero-{{ section.id }} .vhl-video-hero__subheading {

    margin-top: 10px;

    max-width: calc(100vw - 40px);

    font-size: 13px;

    line-height: 1.5;

  }

}

/* =========================

   SMALL PHONE

\========================= */

@media screen and (max-width: 390px) {

  #VHLVideoHero-{{ section.id }} .vhl-video-hero__heading {

    font-size: 15px !important;

  }

  #VHLVideoHero-{{ section.id }}.vhl-video-hero--mobile-heading-large .vhl-video-hero__heading {

    font-size: clamp(26px, 10.5vw, 34px) !important;

  }

}

{% endstyle %}

<script>

(() => {

  const hero =

    document.getElementById(

      'VHLVideoHero-{{ section.id }}'

    );

  if (!hero) return;

  const videos =

    hero.querySelectorAll('video');

  videos.forEach((video) => {

    video.muted = true;

    video.setAttribute('muted', '');

    video.setAttribute('playsinline', '');

    video.setAttribute('webkit-playsinline', '');

    if (

      !window.matchMedia(

        '(prefers-reduced-motion: reduce)'

      ).matches

    ) {

      const playPromise = video.play();

      if (playPromise) {

        playPromise.catch(() => {});

      }

    }

  });

})();

</script>

{% schema %}

{

  "name": "VHL Video Hero",

  "settings": [

    {

      "type": "video",

      "id": "video",

      "label": "Hero video desktop"

    },

    {

      "type": "video",

      "id": "mobile_video",

      "label": "Hero video mobiel"

    },

    {

      "type": "image_picker",

      "id": "image",

      "label": "Hero afbeelding desktop"

    },

    {

      "type": "image_picker",

      "id": "mobile_image",

      "label": "Hero afbeelding mobiel"

    },

    {

      "type": "checkbox",

      "id": "use_collection_fallback",

      "label": "Gebruik collectiegegevens als fallback",

      "default": false

    },

    {

      "type": "range",

      "id": "overlay_opacity",

      "label": "Overlaysterkte desktop",

      "min": 20,

      "max": 90,

      "step": 5,

      "unit": "%",

      "default": 40

    },

    {

      "type": "range",

      "id": "desktop_height",

      "label": "Hoogte desktop",

      "min": 520,

      "max": 900,

      "step": 10,

      "unit": "px",

      "default": 580

    },

    {

      "type": "range",

      "id": "mobile_height",

      "label": "Hoogte mobiel",

      "min": 600,

      "max": 900,

      "step": 10,

      "unit": "px",

      "default": 600

    },

    {

      "type": "text",

      "id": "eyebrow",

      "label": "Boventitel"

    },

    {

      "type": "text",

      "id": "heading",

      "label": "Titel"

    },

    {

      "type": "text",

      "id": "subheading",

      "label": "Subtitel"

    },

    {

      "type": "select",

      "id": "mobile_heading_style",

      "label": "Titelstijl mobiel",

      "options": [

        {

          "value": "compact",

          "label": "Compact"

        },

        {

          "value": "large",

          "label": "Groot"

        }

      ],

      "default": "compact"

    },

    {

      "type": "text",

      "id": "button_label",

      "label": "Knoptekst"

    },

    {

      "type": "url",

      "id": "button_link",

      "label": "Knoplink"

    }

  ],

  "presets": [

    {

      "name": "VHL Video Hero"

    }

  ]

}

{% endschema %}
