{%- comment -%}
  VHL Vacuum Hook PDP — reviews section.

  GEEN fake reviews: de reviewsamenvatting (score/aantal) toont uitsluitend
  echte data via product.metafields.reviews (dezelfde namespace die elders
  in deze theme al gebruikt wordt, o.a. snippets/card-product.liquid).
  De reviewkaarten zijn volledig merchant-ingevulde blocks (geen ingebouwde
  voorbeeldtekst, geen standaard preset-blocks) — leeg blijft leeg.
  Rendert helemaal niets als er geen echte ratingdata en geen ingevulde
  reviewblocks zijn.
{%- endcomment -%}

{%- liquid
  assign has_rating = false
  if product.metafields.reviews.rating.value != blank
    assign has_rating = true
  endif

  assign visible_blocks = 0
  for block in section.blocks
    if block.settings.quote != blank and block.settings.author != blank
      assign visible_blocks = visible_blocks | plus: 1
    endif
  endfor

  assign has_content = false
  if has_rating or visible_blocks > 0
    assign has_content = true
  endif
-%}

{% if has_content %}
  <section id="VHLVacuumReviews-{{ section.id }}" class="vhl-vacuum-reviews" {{ section.shopify_attributes }}>
    <div class="vhl-vacuum-reviews__inner">
      <div class="vhl-vacuum-reviews__header">
        <div>
          {% if section.settings.eyebrow != blank %}
            <p class="vhl-vacuum-reviews__eyebrow">{{ section.settings.eyebrow }}</p>
          {% endif %}
          {% if section.settings.heading != blank %}
            <h2 class="vhl-vacuum-reviews__heading">{{ section.settings.heading }}</h2>
          {% endif %}
        </div>

        {% if has_rating %}
          <div
            class="rating vhl-vacuum-reviews__score"
            role="img"
            aria-label="{{ 'accessibility.star_reviews_info' | t: rating_value: product.metafields.reviews.rating.value, rating_max: product.metafields.reviews.rating.value.scale_max }}"
          >
            <span
              aria-hidden="true"
              class="rating-star"
              style="--rating: {{ product.metafields.reviews.rating.value.rating | floor }}; --rating-max: {{ product.metafields.reviews.rating.value.scale_max }};"
            ></span>
            <span class="vhl-vacuum-reviews__score-text">
              {{- product.metafields.reviews.rating.value }} / {{ product.metafields.reviews.rating.value.scale_max -}}
              {% if product.metafields.reviews.rating_count %}
                &middot; {{ product.metafields.reviews.rating_count }} beoordelingen
              {% endif %}
            </span>
          </div>
        {% endif %}
      </div>

      {% if visible_blocks > 0 %}
        <div class="vhl-vacuum-reviews__grid">
          {% for block in section.blocks %}
            {% if block.settings.quote != blank and block.settings.author != blank %}
              <article class="vhl-vacuum-reviews__card" {{ block.shopify_attributes }}>
                {% if block.settings.image != blank %}
                  <div class="vhl-vacuum-reviews__card-image">
                    {{ block.settings.image | image_url: width: 300 | image_tag: loading: 'lazy', widths: '150,300' }}
                  </div>
                {% endif %}
                <div class="vhl-vacuum-reviews__card-body">
                  {% if block.settings.rating != blank %}
                    <div class="vhl-vacuum-reviews__card-stars" aria-hidden="true">
                      {% for i in (1..5) %}
                        <span class="{% if i <= block.settings.rating %}is-filled{% endif %}">&#9733;</span>
                      {% endfor %}
                    </div>
                  {% endif %}
                  <p class="vhl-vacuum-reviews__card-quote">{{ block.settings.quote }}</p>
                  <p class="vhl-vacuum-reviews__card-author">
                    {{ block.settings.author }}
                    {% if block.settings.verified %}
                      <span class="vhl-vacuum-reviews__verified">Geverifieerd</span>
                    {% endif %}
                  </p>
                </div>
              </article>
            {% endif %}
          {% endfor %}
        </div>
      {% endif %}
    </div>
  </section>

  {% style %}
    #VHLVacuumReviews-{{ section.id }} {
      padding: 56px 16px;
      background: #faf8f5;
    }

    @media screen and (min-width: 990px) {
      #VHLVacuumReviews-{{ section.id }} {
        padding: 80px 48px;
      }
    }

    #VHLVacuumReviews-{{ section.id }} .vhl-vacuum-reviews__inner {
      max-width: 1400px;
      margin: 0 auto;
    }

    #VHLVacuumReviews-{{ section.id }} .vhl-vacuum-reviews__header {
      display: flex;
      flex-wrap: wrap;
      align-items: flex-end;
      justify-content: space-between;
      gap: 20px;
      margin-bottom: 32px;
    }

    #VHLVacuumReviews-{{ section.id }} .vhl-vacuum-reviews__eyebrow {
      margin: 0 0 10px;
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: #8a8a86;
    }

    #VHLVacuumReviews-{{ section.id }} .vhl-vacuum-reviews__heading {
      margin: 0;
      font-size: clamp(26px, 3vw, 36px);
      color: #1a1a1a;
    }

    #VHLVacuumReviews-{{ section.id }} .vhl-vacuum-reviews__score {
      display: flex;
      align-items: center;
      gap: 8px;
    }

    #VHLVacuumReviews-{{ section.id }} .vhl-vacuum-reviews__score-text {
      font-size: 14px;
      color: #4a4a47;
    }

    #VHLVacuumReviews-{{ section.id }} .vhl-vacuum-reviews__grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 16px;
    }

    @media screen and (min-width: 640px) {
      #VHLVacuumReviews-{{ section.id }} .vhl-vacuum-reviews__grid {
        grid-template-columns: repeat(2, 1fr);
      }
    }

    @media screen and (min-width: 990px) {
      #VHLVacuumReviews-{{ section.id }} .vhl-vacuum-reviews__grid {
        grid-template-columns: repeat(4, 1fr);
        gap: 20px;
      }
    }

    #VHLVacuumReviews-{{ section.id }} .vhl-vacuum-reviews__card {
      background: #ffffff;
      border: 1px solid #e5e0d8;
      border-radius: 14px;
      padding: 20px;
      display: flex;
      flex-direction: column;
      gap: 12px;
    }

    #VHLVacuumReviews-{{ section.id }} .vhl-vacuum-reviews__card-image {
      width: 44px;
      height: 44px;
      border-radius: 50%;
      overflow: hidden;
    }

    #VHLVacuumReviews-{{ section.id }} .vhl-vacuum-reviews__card-image img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    #VHLVacuumReviews-{{ section.id }} .vhl-vacuum-reviews__card-stars {
      font-size: 13px;
      letter-spacing: 2px;
      color: #dcd6cb;
    }

    #VHLVacuumReviews-{{ section.id }} .vhl-vacuum-reviews__card-stars .is-filled {
      color: #262625;
    }

    #VHLVacuumReviews-{{ section.id }} .vhl-vacuum-reviews__card-quote {
      margin: 0;
      font-size: 14px;
      line-height: 1.6;
      color: #1a1a1a;
      flex-grow: 1;
    }

    #VHLVacuumReviews-{{ section.id }} .vhl-vacuum-reviews__card-author {
      margin: 0;
      font-size: 12px;
      color: #8a8a86;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    #VHLVacuumReviews-{{ section.id }} .vhl-vacuum-reviews__verified {
      display: inline-flex;
      align-items: center;
      padding: 2px 8px;
      border-radius: 999px;
      background: #f0f0ee;
      color: #4a4a47;
      font-size: 10px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.04em;
    }
  {% endstyle %}
{% endif %}

{% schema %}
{
  "name": "VHL Vacuumhaak — Reviews",
  "tag": "section",
  "class": "vhl-vacuum-reviews-section",
  "max_blocks": 8,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Boventitel (optioneel)"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titel (optioneel)"
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review (echte klant)",
      "settings": [
        {
          "type": "paragraph",
          "content": "Vul alleen echte, geverifieerde klantreviews in. Laat quote en naam leeg om deze kaart niet te tonen."
        },
        {
          "type": "textarea",
          "id": "quote",
          "label": "Reviewtekst (echte klant, leeg = verborgen)"
        },
        {
          "type": "text",
          "id": "author",
          "label": "Naam klant (echt, leeg = verborgen)"
        },
        {
          "type": "range",
          "id": "rating",
          "label": "Sterren (optioneel)",
          "min": 0,
          "max": 5,
          "step": 1,
          "default": 5
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Foto klant (optioneel, alleen echt)"
        },
        {
          "type": "checkbox",
          "id": "verified",
          "label": "Geverifieerde aankoop",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "VHL Vacuumhaak — Reviews"
    }
  ]
}
{% endschema %}
