{% comment %}
  VHL - Badkamer Essentials + automatische Wandplanken

  Gedrag:
  - BADKAMER ESSENTIALS blijft altijd zichtbaar zoals voorheen.
  - Als het huidige product in collectie "wandplanken" zit,
    verschijnt daaronder automatisch een tweede rij: WANDPLANKEN.
  - "Ontdek meer" van die rij linkt naar de collectie Wandplanken.
  - Het huidige product wordt in beide rijen overgeslagen.
  - Geen handmatige collectie-selectie nodig.
{% endcomment %}

{% assign essentials_collection = collections['badkamer-essentials'] %}
{% assign wandplanken_collection = collections['wandplanken'] %}

{% assign is_wandplank = false %}
{% for product_collection in product.collections %}
  {% if product_collection.handle == 'wandplanken' %}
    {% assign is_wandplank = true %}
    {% break %}
  {% endif %}
{% endfor %}


{% comment %}
  =========================================================
  BADKAMER ESSENTIALS
  =========================================================
{% endcomment %}

{% if essentials_collection != blank and essentials_collection.products_count > 0 %}

<section class="vhl-essentials" data-vhl-essentials>

  <div class="vhl-essentials__inner">

    <div class="vhl-essentials__header">

      <h2 class="vhl-essentials__heading">
        BADKAMER ESSENTIALS
      </h2>

      <a
        href="{{ essentials_collection.url }}"
        class="vhl-essentials__more"
      >
        <span>Ontdek meer</span>
        <span class="vhl-essentials__arrow" aria-hidden="true">›</span>
      </a>

    </div>

    <div class="vhl-essentials__viewport">

      <div class="vhl-essentials__track">

        {% for item in essentials_collection.products %}

          {% if item.id != product.id %}

            <article class="vhl-essentials__card">

              <a
                href="{{ item.url }}"
                class="vhl-essentials__image-link"
                aria-label="{{ item.title | escape }}"
              >

                {% if item.featured_image %}

                  {{
                    item.featured_image
                    | image_url: width: 1000
                    | image_tag:
                      loading: 'lazy',
                      widths: '300, 450, 600, 750, 900, 1000',
                      sizes: '(max-width: 749px) 72vw, 20vw',
                      class: 'vhl-essentials__image',
                      alt: item.title
                  }}

                {% endif %}

              </a>

              <div class="vhl-essentials__info">

                <a
                  href="{{ item.url }}"
                  class="vhl-essentials__title"
                >
                  {{ item.title }}
                </a>

                <div class="vhl-essentials__prices">

                  <span class="vhl-essentials__price">
                    {{ item.price | money }}
                  </span>

                  {% if item.compare_at_price_max > item.price %}

                    <span class="vhl-essentials__compare">
                      {{ item.compare_at_price_max | money }}
                    </span>

                  {% endif %}

                </div>

              </div>

            </article>

          {% endif %}

        {% endfor %}

      </div>

    </div>

  </div>

</section>

{% endif %}


{% comment %}
  =========================================================
  WANDPLANKEN
  Alleen zichtbaar als huidig product in collectie Wandplanken zit.
  =========================================================
{% endcomment %}

{% if is_wandplank and wandplanken_collection != blank and wandplanken_collection.products_count > 0 %}

<section class="vhl-essentials vhl-essentials--wandplanken" data-vhl-wandplanken>

  <div class="vhl-essentials__inner">

    <div class="vhl-essentials__header">

      <h2 class="vhl-essentials__heading">
        WANDPLANKEN
      </h2>

      <a
        href="{{ wandplanken_collection.url }}"
        class="vhl-essentials__more"
      >
        <span>Ontdek meer</span>
        <span class="vhl-essentials__arrow" aria-hidden="true">›</span>
      </a>

    </div>

    <div class="vhl-essentials__viewport">

      <div class="vhl-essentials__track">

        {% for item in wandplanken_collection.products %}

          {% if item.id != product.id %}

            <article class="vhl-essentials__card">

              <a
                href="{{ item.url }}"
                class="vhl-essentials__image-link"
                aria-label="{{ item.title | escape }}"
              >

                {% if item.featured_image %}

                  {{
                    item.featured_image
                    | image_url: width: 1000
                    | image_tag:
                      loading: 'lazy',
                      widths: '300, 450, 600, 750, 900, 1000',
                      sizes: '(max-width: 749px) 72vw, 20vw',
                      class: 'vhl-essentials__image',
                      alt: item.title
                  }}

                {% endif %}

              </a>

              <div class="vhl-essentials__info">

                <a
                  href="{{ item.url }}"
                  class="vhl-essentials__title"
                >
                  {{ item.title }}
                </a>

                <div class="vhl-essentials__prices">

                  <span class="vhl-essentials__price">
                    {{ item.price | money }}
                  </span>

                  {% if item.compare_at_price_max > item.price %}

                    <span class="vhl-essentials__compare">
                      {{ item.compare_at_price_max | money }}
                    </span>

                  {% endif %}

                </div>

              </div>

            </article>

          {% endif %}

        {% endfor %}

      </div>

    </div>

  </div>

</section>

{% endif %}


<style>

/* =========================================================
   VHL BADKAMER ESSENTIALS + WANDPLANKEN
   ========================================================= */

.vhl-essentials,
.vhl-essentials *,
.vhl-essentials *::before,
.vhl-essentials *::after {
  box-sizing: border-box;
}


/* =========================================================
   SECTION
   ========================================================= */

.vhl-essentials {
  display: block !important;

  width: 100% !important;
  max-width: none !important;

  margin: 0 !important;

  padding: 64px 0 76px !important;

  background: #f7f7f7 !important;

  overflow: hidden !important;
}

/* Wanneer Wandplanken direct na Badkamer Essentials verschijnt,
   voorkomen we een onnodige dubbele tussenruimte. */
.vhl-essentials + .vhl-essentials--wandplanken {
  padding-top: 0 !important;
}


/* =========================================================
   INNER CONTAINER
   ========================================================= */

.vhl-essentials__inner {
  display: block !important;

  width: calc(100% - 80px) !important;
  max-width: 1800px !important;

  margin: 0 auto !important;

  padding: 0 !important;
}


/* =========================================================
   HEADER
   ========================================================= */

.vhl-essentials__header {
  display: flex !important;

  flex-direction: row !important;
  flex-wrap: nowrap !important;

  align-items: center !important;
  justify-content: space-between !important;

  width: 100% !important;

  margin: 0 0 34px !important;
  padding: 0 !important;

  gap: 30px !important;
}


.vhl-essentials__heading {
  display: block !important;

  margin: 0 !important;
  padding: 0 !important;

  color: #111 !important;

  font-size: 16px !important;
  line-height: 1.2 !important;

  font-weight: 700 !important;

  letter-spacing: 0 !important;

  text-transform: uppercase !important;
}


.vhl-essentials__more {
  display: inline-flex !important;

  align-items: center !important;

  gap: 14px !important;

  margin: 0 !important;
  padding: 0 !important;

  color: #111 !important;

  text-decoration: none !important;

  font-size: 16px !important;
  line-height: 1 !important;

  font-weight: 400 !important;

  white-space: nowrap !important;
}


.vhl-essentials__arrow {
  display: inline-block !important;

  font-size: 24px !important;
  line-height: 1 !important;

  transform: translateY(-1px);
}


/* =========================================================
   VIEWPORT
   ========================================================= */

.vhl-essentials__viewport {
  display: block !important;

  position: relative !important;

  width: 100% !important;
  max-width: 100% !important;

  margin: 0 !important;
  padding: 0 !important;

  overflow-x: auto !important;
  overflow-y: hidden !important;

  scrollbar-width: none !important;

  -ms-overflow-style: none !important;

  -webkit-overflow-scrolling: touch;
}


.vhl-essentials__viewport::-webkit-scrollbar {
  display: none !important;

  width: 0 !important;
  height: 0 !important;
}


/* =========================================================
   TRACK
   ========================================================= */

.vhl-essentials__track {
  display: flex !important;

  flex-direction: row !important;
  flex-wrap: nowrap !important;

  align-items: stretch !important;
  justify-content: flex-start !important;

  grid-template-columns: none !important;
  grid-template-rows: none !important;

  width: max-content !important;
  min-width: 100% !important;
  max-width: none !important;

  margin: 0 !important;
  padding: 0 !important;

  gap: 20px !important;

  overflow: visible !important;

  list-style: none !important;
}


/* =========================================================
   PRODUCT CARD
   ========================================================= */

.vhl-essentials__card {
  position: relative !important;

  display: flex !important;

  flex-direction: column !important;

  flex-grow: 0 !important;
  flex-shrink: 0 !important;

  flex-basis: calc((100vw - 160px) / 5) !important;

  width: calc((100vw - 160px) / 5) !important;
  min-width: calc((100vw - 160px) / 5) !important;
  max-width: calc((100vw - 160px) / 5) !important;

  margin: 0 !important;
  padding: 0 !important;

  background: #fff !important;

  border: 1px solid #e8d7c1 !important;
  border-radius: 6px !important;

  overflow: hidden !important;

  scroll-snap-align: start;
}


/* =========================================================
   PRODUCT IMAGE AREA
   ========================================================= */

.vhl-essentials__image-link {
  position: relative !important;

  display: block !important;

  flex: none !important;

  width: 100% !important;

  aspect-ratio: 1 / 1 !important;

  margin: 0 !important;
  padding: 0 !important;

  background: #f3f3f3 !important;

  overflow: hidden !important;

  text-decoration: none !important;
}


.vhl-essentials__image {
  display: block !important;

  width: 100% !important;
  height: 100% !important;

  max-width: none !important;

  margin: 0 !important;

  object-fit: contain !important;

  object-position: center center !important;

  transition: transform .3s ease !important;
}


.vhl-essentials__card:hover .vhl-essentials__image {
  transform: scale(1.02);
}


/* =========================================================
   PRODUCT INFORMATION
   ========================================================= */

.vhl-essentials__info {
  display: flex !important;

  flex-direction: column !important;

  align-items: center !important;
  justify-content: center !important;

  flex: 1 0 auto !important;

  width: 100% !important;

  min-height: 105px !important;

  margin: 0 !important;

  padding: 20px 14px 22px !important;

  background: #fff !important;

  text-align: center !important;
}


/* =========================================================
   PRODUCT TITLE
   ========================================================= */

.vhl-essentials__title {
  display: block !important;

  width: 100% !important;

  margin: 0 0 9px !important;
  padding: 0 !important;

  color: #111 !important;

  text-decoration: none !important;

  text-transform: uppercase !important;

  text-align: center !important;

  font-size: 14px !important;
  line-height: 1.25 !important;

  font-weight: 700 !important;

  letter-spacing: 0 !important;
}


/* =========================================================
   PRICES
   ========================================================= */

.vhl-essentials__prices {
  display: flex !important;

  flex-direction: row !important;
  flex-wrap: wrap !important;

  align-items: center !important;
  justify-content: center !important;

  gap: 8px !important;

  width: 100% !important;

  margin: 0 !important;
  padding: 0 !important;
}


.vhl-essentials__price {
  display: inline-block !important;

  color: #111 !important;

  font-size: 14px !important;
  line-height: 1.2 !important;

  font-weight: 700 !important;

  white-space: nowrap !important;
}


.vhl-essentials__compare {
  display: inline-block !important;

  color: #555 !important;

  font-size: 12px !important;
  line-height: 1.2 !important;

  font-weight: 400 !important;

  opacity: .65 !important;

  text-decoration: line-through !important;

  white-space: nowrap !important;
}


/* =========================================================
   GROTE DESKTOPS
   ========================================================= */

@media screen and (min-width: 1880px) {

  .vhl-essentials__card {
    flex-basis: 328px !important;

    width: 328px !important;
    min-width: 328px !important;
    max-width: 328px !important;
  }

}


/* =========================================================
   TABLET
   ========================================================= */

@media screen and (max-width: 989px) {

  .vhl-essentials {
    padding: 52px 0 62px !important;
  }

  .vhl-essentials + .vhl-essentials--wandplanken {
    padding-top: 0 !important;
  }


  .vhl-essentials__inner {
    width: calc(100% - 40px) !important;
  }


  .vhl-essentials__track {
    gap: 16px !important;
  }


  .vhl-essentials__card {
    flex-basis: 310px !important;

    width: 310px !important;
    min-width: 310px !important;
    max-width: 310px !important;
  }

}


/* =========================================================
   MOBILE
   ========================================================= */

@media screen and (max-width: 749px) {

  .vhl-essentials {
    padding: 42px 0 50px !important;
  }

  .vhl-essentials + .vhl-essentials--wandplanken {
    padding-top: 0 !important;
  }


  .vhl-essentials__inner {
    width: 100% !important;
    max-width: none !important;
  }


  .vhl-essentials__header {
    width: 100% !important;

    margin-bottom: 22px !important;

    padding-left: 18px !important;
    padding-right: 18px !important;

    gap: 15px !important;
  }


  .vhl-essentials__heading {
    font-size: 13px !important;
  }


  .vhl-essentials__more {
    gap: 8px !important;

    font-size: 13px !important;
  }


  .vhl-essentials__arrow {
    font-size: 20px !important;
  }


  .vhl-essentials__viewport {
    padding-left: 18px !important;

    scroll-snap-type: x proximity;
  }


  .vhl-essentials__track {
    gap: 12px !important;

    padding-right: 36px !important;
  }


  .vhl-essentials__card {
    flex-basis: 76vw !important;

    width: 76vw !important;
    min-width: 76vw !important;
    max-width: 76vw !important;
  }


  .vhl-essentials__info {
    min-height: 90px !important;

    padding: 17px 12px 19px !important;
  }


  .vhl-essentials__title {
    margin-bottom: 8px !important;

    font-size: 13px !important;
  }


  .vhl-essentials__price {
    font-size: 14px !important;
  }


  .vhl-essentials__compare {
    font-size: 12px !important;
  }

}

</style>


{% schema %}
{
  "name": "VHL Badkamer Essentials",
  "settings": [],
  "presets": [
    {
      "name": "VHL Badkamer Essentials"
    }
  ]
}
{% endschema %}
