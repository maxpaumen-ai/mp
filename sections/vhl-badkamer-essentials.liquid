{% comment %}
  VHL - Badkamer Essentials
  ROHA-style product strip
  - Geen hero/header
  - Geen "SHOP BADKAMER ESSENTIALS"
  - Alle producten op 1 horizontale rij
  - Huidige product wordt overgeslagen
{% endcomment %}

{% assign essentials_collection = collections['badkamer-essentials'] %}

{% if essentials_collection != blank and essentials_collection.products_count > 0 %}

<section class="vhl-essentials">

  <div class="vhl-essentials__inner">

    <div class="vhl-essentials__header">
      <h2>BADKAMER ESSENTIALS</h2>

      <a
        href="{{ essentials_collection.url }}"
        class="vhl-essentials__more"
      >
        Ontdek meer
        <span aria-hidden="true">›</span>
      </a>
    </div>


    <div class="vhl-essentials__scroll">

      <div class="vhl-essentials__products">

        {% for item in essentials_collection.products %}

          {% if item.id != product.id %}

            <article class="vhl-essentials__card">

              <a
                href="{{ item.url }}"
                class="vhl-essentials__image-wrap"
                aria-label="{{ item.title | escape }}"
              >

                {% if item.featured_image %}

                  {{
                    item.featured_image
                    | image_url: width: 900
                    | image_tag:
                      loading: 'lazy',
                      widths: '300, 450, 600, 750, 900',
                      sizes: '(max-width: 749px) 72vw, 20vw',
                      class: 'vhl-essentials__image',
                      alt: item.title
                  }}

                {% endif %}

                <div class="vhl-essentials__new">
                  <span>NEW · NEW · NEW</span>
                </div>

              </a>


              <div class="vhl-essentials__info">

                <a
                  href="{{ item.url }}"
                  class="vhl-essentials__title"
                >
                  {{ item.title }}
                </a>


                <div class="vhl-essentials__prices">

                  <span class="vhl-essentials__price">
                    {{ item.price | money }}
                  </span>

                  {% if item.compare_at_price_max > item.price %}

                    <span class="vhl-essentials__compare">
                      {{ item.compare_at_price_max | money }}
                    </span>

                  {% endif %}

                </div>

              </div>

            </article>

          {% endif %}

        {% endfor %}

      </div>

    </div>

  </div>

</section>


<style>

/* =========================================
   SECTION
========================================= */

.vhl-essentials {
  width: 100%;
  background: #f7f7f7;
  padding: 64px 0 76px;
  overflow: hidden;
}

.vhl-essentials__inner {
  width: calc(100% - 80px);
  max-width: 1800px;
  margin: 0 auto;
}


/* =========================================
   HEADER
========================================= */

.vhl-essentials__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 30px;

  margin-bottom: 34px;
}

.vhl-essentials__header h2 {
  margin: 0;

  color: #111;

  font-size: 16px;
  line-height: 1.2;

  font-weight: 700;
  letter-spacing: 0;

  text-transform: uppercase;
}

.vhl-essentials__more {
  display: inline-flex;
  align-items: center;

  gap: 15px;

  color: #111;

  text-decoration: none;

  font-size: 16px;
  line-height: 1;

  white-space: nowrap;
}

.vhl-essentials__more span {
  font-size: 25px;
  line-height: 1;

  transform: translateY(-1px);
}


/* =========================================
   HORIZONTAL PRODUCT ROW
========================================= */

.vhl-essentials__scroll {
  width: 100%;

  overflow-x: auto;
  overflow-y: hidden;

  scrollbar-width: none;

  -webkit-overflow-scrolling: touch;
}

.vhl-essentials__scroll::-webkit-scrollbar {
  display: none;
}

.vhl-essentials__products {
  display: flex;

  flex-wrap: nowrap;

  gap: 22px;

  width: max-content;
}


/* =========================================
   PRODUCT CARD
========================================= */

.vhl-essentials__card {
  position: relative;

  flex: 0 0 calc((100vw - 80px - 88px) / 5);

  max-width: 340px;
  min-width: 240px;

  background: #fff;

  border: 1px solid #e6d4bd;
  border-radius: 6px;

  overflow: hidden;
}


/* =========================================
   PRODUCT IMAGE
========================================= */

.vhl-essentials__image-wrap {
  position: relative;

  display: block;

  width: 100%;

  aspect-ratio: 1 / 1;

  background: #f4f4f4;

  overflow: hidden;
}

.vhl-essentials__image {
  display: block;

  width: 100%;
  height: 100%;

  object-fit: contain;

  transition: transform .35s ease;
}

.vhl-essentials__card:hover .vhl-essentials__image {
  transform: scale(1.025);
}


/* =========================================
   NEW BADGE
========================================= */

.vhl-essentials__new {
  position: absolute;

  top: 16px;
  right: 16px;

  width: 48px;
  height: 48px;

  border-radius: 50%;

  display: flex;
  align-items: center;
  justify-content: center;

  color: #111;

  font-size: 5px;
  font-weight: 700;

  letter-spacing: .7px;

  border: 1px solid rgba(0,0,0,.08);

  background: rgba(255,255,255,.25);
}

.vhl-essentials__new span {
  display: block;

  text-align: center;

  line-height: 1.3;

  max-width: 36px;
}


/* =========================================
   PRODUCT INFORMATION
========================================= */

.vhl-essentials__info {
  min-height: 108px;

  padding: 23px 20px 24px;

  background: #fff;

  text-align: center;
}

.vhl-essentials__title {
  display: block;

  margin: 0 0 11px;

  color: #111;

  text-decoration: none;

  text-transform: uppercase;

  font-size: 14px;
  line-height: 1.25;

  font-weight: 700;
}


/* =========================================
   PRICE
========================================= */

.vhl-essentials__prices {
  display: flex;

  align-items: center;
  justify-content: center;

  flex-wrap: wrap;

  gap: 9px;
}

.vhl-essentials__price {
  color: #111;

  font-size: 15px;
  line-height: 1.2;

  font-weight: 700;
}

.vhl-essentials__compare {
  color: #555;

  font-size: 13px;
  line-height: 1.2;

  text-decoration: line-through;

  opacity: .65;
}


/* =========================================
   TABLET
========================================= */

@media screen and (max-width: 1100px) {

  .vhl-essentials__inner {
    width: calc(100% - 40px);
  }

  .vhl-essentials__card {
    flex: 0 0 29vw;

    min-width: 260px;
  }

}


/* =========================================
   MOBILE
========================================= */

@media screen and (max-width: 749px) {

  .vhl-essentials {
    padding: 42px 0 50px;
  }

  .vhl-essentials__inner {
    width: 100%;
  }

  .vhl-essentials__header {
    padding: 0 18px;

    margin-bottom: 22px;
  }

  .vhl-essentials__header h2 {
    font-size: 13px;
  }

  .vhl-essentials__more {
    gap: 8px;

    font-size: 13px;
  }

  .vhl-essentials__more span {
    font-size: 20px;
  }

  .vhl-essentials__scroll {
    padding-left: 18px;
  }

  .vhl-essentials__products {
    gap: 12px;

    padding-right: 36px;
  }

  .vhl-essentials__card {
    flex: 0 0 76vw;

    min-width: 0;
    max-width: none;
  }

  .vhl-essentials__info {
    min-height: 92px;

    padding: 18px 14px 20px;
  }

  .vhl-essentials__title {
    font-size: 13px;

    margin-bottom: 8px;
  }

  .vhl-essentials__price {
    font-size: 14px;
  }

  .vhl-essentials__compare {
    font-size: 12px;
  }

  .vhl-essentials__new {
    width: 42px;
    height: 42px;

    top: 12px;
    right: 12px;
  }

}

</style>


{% schema %}
{
  "name": "VHL Badkamer Essentials",
  "settings": [],
  "presets": [
    {
      "name": "VHL Badkamer Essentials"
    }
  ]
}
{% endschema %}
