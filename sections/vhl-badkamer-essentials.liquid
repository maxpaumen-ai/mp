{% comment %}
  VHL - Badkamer Essentials
  ROHA-style banner + horizontale productrij

  - Banner bovenaan via Shopify theme editor
  - Geen tekst op/in de banner
  - Geen BADKAMER ESSENTIALS titel
  - Geen Ontdek meer
  - Automatisch collectie: badkamer-essentials
  - Huidige product wordt overgeslagen
  - ALTIJD 1 productrij
  - NOOIT wrapping / tweede rij
  - Desktop: ongeveer 5 producten zichtbaar
  - Rest horizontaal scrollbaar
  - Mobiel: horizontaal swipen
{% endcomment %}

{% assign essentials_collection = collections['badkamer-essentials'] %}

{% if essentials_collection != blank and essentials_collection.products_count > 0 %}

<section
  class="vhl-essentials"
  data-vhl-essentials
  id="vhl-essentials-{{ section.id }}"
>

  {% comment %}
    ============================
    BANNER
    ============================
  {% endcomment %}

  {% if section.settings.banner_image != blank %}
    <div class="vhl-essentials__banner">

      <picture>

        {% if section.settings.banner_image_mobile != blank %}
          <source
            media="(max-width: 749px)"
            srcset="
              {{ section.settings.banner_image_mobile | image_url: width: 750 }} 750w,
              {{ section.settings.banner_image_mobile | image_url: width: 1000 }} 1000w
            "
          >
        {% endif %}

        {{
          section.settings.banner_image
          | image_url: width: 2400
          | image_tag:
            loading: 'lazy',
            widths: '1000, 1400, 1800, 2200, 2400',
            sizes: '100vw',
            class: 'vhl-essentials__banner-image',
            alt: ''
        }}

      </picture>

    </div>
  {% endif %}


  {% comment %}
    ============================
    PRODUCTEN
    ============================
  {% endcomment %}

  <div class="vhl-essentials__products-area">

    <div class="vhl-essentials__viewport">

      <div class="vhl-essentials__track">

        {% for item in essentials_collection.products %}

          {% if item.id != product.id %}

            <article class="vhl-essentials__card">

              <a
                href="{{ item.url }}"
                class="vhl-essentials__image-link"
                aria-label="{{ item.title | escape }}"
              >

                {% if item.featured_image %}

                  {{
                    item.featured_image
                    | image_url: width: 1000
                    | image_tag:
                      loading: 'lazy',
                      widths: '300, 450, 600, 750, 900, 1000',
                      sizes: '(max-width: 749px) 72vw, 20vw',
                      class: 'vhl-essentials__image',
                      alt: item.title
                  }}

                {% endif %}

              </a>


              <div class="vhl-essentials__info">

                <a
                  href="{{ item.url }}"
                  class="vhl-essentials__title"
                >
                  {{ item.title }}
                </a>


                <div class="vhl-essentials__prices">

                  <span class="vhl-essentials__price">
                    {{ item.price | money }}
                  </span>

                  {% if item.compare_at_price_max > item.price %}

                    <span class="vhl-essentials__compare">
                      {{ item.compare_at_price_max | money }}
                    </span>

                  {% endif %}

                </div>

              </div>

            </article>

          {% endif %}

        {% endfor %}

      </div>

    </div>

  </div>

</section>


<style>

/* ==========================================================
   RESET
   ========================================================== */

#vhl-essentials-{{ section.id }},
#vhl-essentials-{{ section.id }} *,
#vhl-essentials-{{ section.id }} *::before,
#vhl-essentials-{{ section.id }} *::after {
  box-sizing: border-box;
}


/* ==========================================================
   COMPLETE SECTION
   ========================================================== */

#vhl-essentials-{{ section.id }} {
  display: block !important;

  width: 100% !important;
  max-width: none !important;

  margin: 0 !important;
  padding: 0 !important;

  background: #f5f5f5 !important;

  overflow: hidden !important;
}


/* ==========================================================
   BANNER
   ========================================================== */

#vhl-essentials-{{ section.id }} .vhl-essentials__banner {
  position: relative !important;

  display: block !important;

  width: 100% !important;
  max-width: none !important;

  margin: 0 !important;
  padding: 0 !important;

  overflow: hidden !important;

  background: #111 !important;
}


/* picture moet volledig vullen */

#vhl-essentials-{{ section.id }} .vhl-essentials__banner picture {
  display: block !important;

  width: 100% !important;
  height: 100% !important;

  margin: 0 !important;
  padding: 0 !important;
}


/* BANNER IMAGE */

#vhl-essentials-{{ section.id }} .vhl-essentials__banner-image {
  display: block !important;

  width: 100% !important;

  height: {{ section.settings.banner_height }}px !important;

  max-width: none !important;

  margin: 0 !important;
  padding: 0 !important;

  object-fit: cover !important;

  object-position:
    {{ section.settings.banner_position }}
    !important;
}


/* ==========================================================
   PRODUCT AREA
   ========================================================== */

#vhl-essentials-{{ section.id }} .vhl-essentials__products-area {
  display: block !important;

  width: 100% !important;
  max-width: none !important;

  margin: 0 !important;

  padding: 64px 0 74px !important;

  background: #f5f5f5 !important;
}


/* ==========================================================
   VIEWPORT
   Dit is het zichtbare gedeelte van de productrij
   ========================================================== */

#vhl-essentials-{{ section.id }} .vhl-essentials__viewport {
  display: block !important;

  position: relative !important;

  width: calc(100% - 80px) !important;
  max-width: 1800px !important;

  margin: 0 auto !important;
  padding: 0 !important;

  overflow-x: auto !important;
  overflow-y: hidden !important;

  scrollbar-width: none !important;
  -ms-overflow-style: none !important;

  -webkit-overflow-scrolling: touch !important;

  scroll-behavior: smooth;
}


#vhl-essentials-{{ section.id }}
.vhl-essentials__viewport::-webkit-scrollbar {
  display: none !important;

  width: 0 !important;
  height: 0 !important;
}


/* ==========================================================
   TRACK

   BELANGRIJK:
   FLEX + NOWRAP + MAX-CONTENT
   Hierdoor KAN geen tweede rij ontstaan.
   ========================================================== */

#vhl-essentials-{{ section.id }} .vhl-essentials__track {
  display: flex !important;

  flex-direction: row !important;
  flex-wrap: nowrap !important;

  align-items: stretch !important;
  justify-content: flex-start !important;

  width: max-content !important;
  min-width: max-content !important;
  max-width: none !important;

  margin: 0 !important;
  padding: 0 !important;

  gap: 20px !important;

  overflow: visible !important;

  white-space: nowrap !important;

  grid-template-columns: none !important;
  grid-template-rows: none !important;
}


/* ==========================================================
   PRODUCT CARD
   ========================================================== */

#vhl-essentials-{{ section.id }} .vhl-essentials__card {
  position: relative !important;

  display: flex !important;

  flex-direction: column !important;

  flex-wrap: nowrap !important;

  flex-grow: 0 !important;
  flex-shrink: 0 !important;

  /*
    5 producten zichtbaar.
    Container = scherm - 80px.
    4 gaps van 20px.
  */

  flex-basis: calc((100vw - 160px) / 5) !important;

  width: calc((100vw - 160px) / 5) !important;
  min-width: calc((100vw - 160px) / 5) !important;
  max-width: calc((100vw - 160px) / 5) !important;

  margin: 0 !important;
  padding: 0 !important;

  white-space: normal !important;

  background: #fff !important;

  border: 1px solid #e7d6bf !important;
  border-radius: 6px !important;

  overflow: hidden !important;

  scroll-snap-align: start;
}


/* ==========================================================
   PRODUCT IMAGE
   ========================================================== */

#vhl-essentials-{{ section.id }} .vhl-essentials__image-link {
  position: relative !important;

  display: block !important;

  flex: none !important;

  width: 100% !important;

  aspect-ratio: 1 / 1 !important;

  margin: 0 !important;
  padding: 0 !important;

  background: #f3f3f3 !important;

  overflow: hidden !important;

  text-decoration: none !important;
}


#vhl-essentials-{{ section.id }} .vhl-essentials__image {
  display: block !important;

  width: 100% !important;
  height: 100% !important;

  max-width: none !important;

  margin: 0 !important;
  padding: 0 !important;

  object-fit: contain !important;

  object-position: center center !important;

  transition: transform .3s ease !important;
}


#vhl-essentials-{{ section.id }}
.vhl-essentials__card:hover
.vhl-essentials__image {
  transform: scale(1.02) !important;
}


/* ==========================================================
   PRODUCT INFO
   ========================================================== */

#vhl-essentials-{{ section.id }} .vhl-essentials__info {
  display: flex !important;

  flex-direction: column !important;

  align-items: center !important;
  justify-content: center !important;

  flex: 1 0 auto !important;

  width: 100% !important;

  min-height: 105px !important;

  margin: 0 !important;

  padding: 20px 14px 22px !important;

  background: #fff !important;

  text-align: center !important;

  white-space: normal !important;
}


/* ==========================================================
   PRODUCT TITLE
   ========================================================== */

#vhl-essentials-{{ section.id }} .vhl-essentials__title {
  display: block !important;

  width: 100% !important;

  margin: 0 0 9px !important;
  padding: 0 !important;

  color: #111 !important;

  text-decoration: none !important;

  text-transform: uppercase !important;

  text-align: center !important;

  font-size: 14px !important;
  line-height: 1.25 !important;

  font-weight: 700 !important;

  letter-spacing: 0 !important;

  white-space: normal !important;
}


/* ==========================================================
   PRICES
   ========================================================== */

#vhl-essentials-{{ section.id }} .vhl-essentials__prices {
  display: flex !important;

  flex-direction: row !important;
  flex-wrap: wrap !important;

  align-items: center !important;
  justify-content: center !important;

  gap: 8px !important;

  width: 100% !important;

  margin: 0 !important;
  padding: 0 !important;

  white-space: normal !important;
}


#vhl-essentials-{{ section.id }} .vhl-essentials__price {
  display: inline-block !important;

  color: #111 !important;

  font-size: 14px !important;
  line-height: 1.2 !important;

  font-weight: 700 !important;

  white-space: nowrap !important;
}


#vhl-essentials-{{ section.id }} .vhl-essentials__compare {
  display: inline-block !important;

  color: #555 !important;

  font-size: 12px !important;
  line-height: 1.2 !important;

  font-weight: 400 !important;

  opacity: .65 !important;

  text-decoration: line-through !important;

  white-space: nowrap !important;
}


/* ==========================================================
   GROTE DESKTOP
   ========================================================== */

@media screen and (min-width: 1880px) {

  #vhl-essentials-{{ section.id }}
  .vhl-essentials__viewport {
    max-width: 1800px !important;
  }


  #vhl-essentials-{{ section.id }}
  .vhl-essentials__card {

    flex-basis: 344px !important;

    width: 344px !important;
    min-width: 344px !important;
    max-width: 344px !important;
  }

}


/* ==========================================================
   TABLET
   ========================================================== */

@media screen and (max-width: 989px) {

  #vhl-essentials-{{ section.id }}
  .vhl-essentials__banner-image {

    height:
      {{ section.settings.banner_height_tablet }}
      px !important;
  }


  #vhl-essentials-{{ section.id }}
  .vhl-essentials__products-area {

    padding: 44px 0 54px !important;
  }


  #vhl-essentials-{{ section.id }}
  .vhl-essentials__viewport {

    width: 100% !important;

    max-width: none !important;

    padding-left: 20px !important;
  }


  #vhl-essentials-{{ section.id }}
  .vhl-essentials__track {

    gap: 16px !important;

    padding-right: 40px !important;
  }


  #vhl-essentials-{{ section.id }}
  .vhl-essentials__card {

    flex-basis: 310px !important;

    width: 310px !important;
    min-width: 310px !important;
    max-width: 310px !important;
  }

}


/* ==========================================================
   MOBILE
   ========================================================== */

@media screen and (max-width: 749px) {

  #vhl-essentials-{{ section.id }}
  .vhl-essentials__banner-image {

    height:
      {{ section.settings.banner_height_mobile }}
      px !important;
  }


  #vhl-essentials-{{ section.id }}
  .vhl-essentials__products-area {

    padding: 32px 0 42px !important;
  }


  #vhl-essentials-{{ section.id }}
  .vhl-essentials__viewport {

    width: 100% !important;

    max-width: none !important;

    margin: 0 !important;

    padding-left: 16px !important;

    scroll-snap-type: x proximity !important;
  }


  #vhl-essentials-{{ section.id }}
  .vhl-essentials__track {

    display: flex !important;

    flex-direction: row !important;
    flex-wrap: nowrap !important;

    width: max-content !important;
    min-width: max-content !important;

    gap: 12px !important;

    padding-right: 32px !important;
  }


  #vhl-essentials-{{ section.id }}
  .vhl-essentials__card {

    flex-grow: 0 !important;
    flex-shrink: 0 !important;

    flex-basis: 76vw !important;

    width: 76vw !important;
    min-width: 76vw !important;
    max-width: 76vw !important;
  }


  #vhl-essentials-{{ section.id }}
  .vhl-essentials__info {

    min-height: 90px !important;

    padding: 17px 12px 19px !important;
  }


  #vhl-essentials-{{ section.id }}
  .vhl-essentials__title {

    margin-bottom: 8px !important;

    font-size: 13px !important;
  }


  #vhl-essentials-{{ section.id }}
  .vhl-essentials__price {

    font-size: 14px !important;
  }


  #vhl-essentials-{{ section.id }}
  .vhl-essentials__compare {

    font-size: 12px !important;
  }

}

</style>


{% schema %}
{
  "name": "VHL Badkamer Essentials",
  "settings": [
    {
      "type": "image_picker",
      "id": "banner_image",
      "label": "Banner afbeelding desktop"
    },
    {
      "type": "image_picker",
      "id": "banner_image_mobile",
      "label": "Banner afbeelding mobiel"
    },
    {
      "type": "range",
      "id": "banner_height",
      "min": 250,
      "max": 900,
      "step": 10,
      "unit": "px",
      "label": "Banner hoogte desktop",
      "default": 560
    },
    {
      "type": "range",
      "id": "banner_height_tablet",
      "min": 200,
      "max": 700,
      "step": 10,
      "unit": "px",
      "label": "Banner hoogte tablet",
      "default": 430
    },
    {
      "type": "range",
      "id": "banner_height_mobile",
      "min": 180,
      "max": 600,
      "step": 10,
      "unit": "px",
      "label": "Banner hoogte mobiel",
      "default": 320
    },
    {
      "type": "select",
      "id": "banner_position",
      "label": "Positie banner afbeelding",
      "default": "center center",
      "options": [
        {
          "value": "left center",
          "label": "Links"
        },
        {
          "value": "center center",
          "label": "Midden"
        },
        {
          "value": "right center",
          "label": "Rechts"
        },
        {
          "value": "center top",
          "label": "Boven"
        },
        {
          "value": "center bottom",
          "label": "Onder"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "VHL Badkamer Essentials"
    }
  ]
}
{% endschema %}
