{% comment %}
  VHL - Badkamer Essentials
  ROHA-style horizontale productrij

  - Collectie: badkamer-essentials
  - Huidige product wordt overgeslagen
  - Altijd 1 rij
  - Desktop: 5 producten zichtbaar
  - Meer producten: horizontaal scrollen
  - Mobiel: horizontaal swipen
{% endcomment %}

{% assign essentials_collection = collections['badkamer-essentials'] %}

{% if essentials_collection != blank and essentials_collection.products_count > 0 %}

<section class="vhl-essentials">
  <div class="vhl-essentials__inner">

    <div class="vhl-essentials__header">
      <h2>BADKAMER ESSENTIALS</h2>

      <a
        href="{{ essentials_collection.url }}"
        class="vhl-essentials__more"
      >
        Ontdek meer
        <span aria-hidden="true">›</span>
      </a>
    </div>

    <div class="vhl-essentials__viewport">
      <div class="vhl-essentials__products">

        {% for item in essentials_collection.products %}

          {% unless item.id == product.id %}

            <article class="vhl-essentials__card">

              <a
                href="{{ item.url }}"
                class="vhl-essentials__image-wrap"
                aria-label="{{ item.title | escape }}"
              >

                {% if item.featured_image %}
                  {{
                    item.featured_image
                    | image_url: width: 1000
                    | image_tag:
                      loading: 'lazy',
                      widths: '300, 450, 600, 750, 900, 1000',
                      sizes: '(max-width: 749px) 72vw, 20vw',
                      class: 'vhl-essentials__image',
                      alt: item.title
                  }}
                {% endif %}

              </a>

              <div class="vhl-essentials__info">

                <a
                  href="{{ item.url }}"
                  class="vhl-essentials__title"
                >
                  {{ item.title }}
                </a>

                <div class="vhl-essentials__prices">

                  <span class="vhl-essentials__price">
                    {{ item.price | money }}
                  </span>

                  {% if item.compare_at_price_max > item.price %}
                    <span class="vhl-essentials__compare">
                      {{ item.compare_at_price_max | money }}
                    </span>
                  {% endif %}

                </div>

              </div>

            </article>

          {% endunless %}

        {% endfor %}

      </div>
    </div>

  </div>
</section>


<style>

/* =========================================================
   VHL BADKAMER ESSENTIALS
   ALTIJD ÉÉN HORIZONTALE RIJ
   ========================================================= */

.vhl-essentials {
  width: 100%;
  max-width: 100%;
  background: #ffffff;
  padding: 72px 0 95px;
  overflow: hidden;
}

.vhl-essentials__inner {
  width: calc(100% - 80px);
  max-width: 1600px;
  margin: 0 auto;
}


/* HEADER */

.vhl-essentials__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;

  margin-bottom: 38px;
}

.vhl-essentials__header h2 {
  margin: 0;

  color: #111111;

  font-size: 16px;
  line-height: 1.2;
  font-weight: 700;

  letter-spacing: 0;
}

.vhl-essentials__more {
  display: inline-flex;
  align-items: center;
  gap: 14px;

  color: #111111;

  text-decoration: none;

  font-size: 16px;
  line-height: 1;

  white-space: nowrap;
}

.vhl-essentials__more span {
  font-size: 23px;
  line-height: 1;
}


/* =========================================================
   VIEWPORT
   ========================================================= */

.vhl-essentials__viewport {
  width: 100%;
  max-width: 100%;

  overflow-x: auto;
  overflow-y: hidden;

  scrollbar-width: none;
  -ms-overflow-style: none;

  -webkit-overflow-scrolling: touch;
}

.vhl-essentials__viewport::-webkit-scrollbar {
  display: none;
}


/* =========================================================
   PRODUCTRIJ
   BELANGRIJK: FLEX + NOWRAP
   ========================================================= */

.vhl-essentials__products {
  display: flex !important;

  flex-direction: row !important;
  flex-wrap: nowrap !important;

  align-items: stretch;

  gap: 22px;

  width: max-content;
  min-width: 100%;

  padding: 0;
  margin: 0;
}


/* =========================================================
   PRODUCT CARD
   5 PRODUCTEN ZICHTBAAR OP DESKTOP
   ========================================================= */

.vhl-essentials__card {
  position: relative;

  flex: 0 0 calc((100vw - 80px - 88px) / 5);

  width: calc((100vw - 80px - 88px) / 5);

  max-width: 286px;
  min-width: 220px;

  margin: 0 !important;

  background: #ffffff;

  border: 1px solid #e8dccd;
  border-radius: 6px;

  overflow: hidden;

  box-sizing: border-box;

  transition:
    transform .25s ease,
    box-shadow .25s ease;
}

.vhl-essentials__card:hover {
  transform: translateY(-2px);

  box-shadow:
    0 8px 24px rgba(0, 0, 0, .04);
}


/* =========================================================
   IMAGE
   ========================================================= */

.vhl-essentials__image-wrap {
  position: relative;

  display: block;

  width: 100%;

  aspect-ratio: 1 / 1;

  background: #f7f7f7;

  overflow: hidden;
}

.vhl-essentials__image {
  display: block;

  width: 100%;
  height: 100%;

  object-fit: contain;

  transition: transform .35s ease;
}

.vhl-essentials__card:hover .vhl-essentials__image {
  transform: scale(1.018);
}


/* =========================================================
   PRODUCT INFO
   ========================================================= */

.vhl-essentials__info {
  display: flex;

  flex-direction: column;

  align-items: center;
  justify-content: center;

  min-height: 96px;

  padding: 20px 14px 22px;

  background: #ffffff;

  text-align: center;

  box-sizing: border-box;
}

.vhl-essentials__title {
  display: block;

  width: 100%;

  margin: 0 0 8px;

  color: #111111;

  text-decoration: none;
  text-transform: uppercase;

  font-size: 14px;
  line-height: 1.25;
  font-weight: 700;

  text-align: center;
}

.vhl-essentials__prices {
  display: flex;

  justify-content: center;
  align-items: baseline;

  flex-wrap: wrap;

  gap: 8px;
}

.vhl-essentials__price {
  color: #111111;

  font-size: 15px;
  line-height: 1.2;

  font-weight: 700;
}

.vhl-essentials__compare {
  color: #555555;

  font-size: 13px;
  line-height: 1.2;

  font-weight: 400;

  text-decoration: line-through;
}


/* =========================================================
   TABLET
   ========================================================= */

@media screen and (max-width: 1199px) {

  .vhl-essentials__card {
    flex-basis: calc((100vw - 62px) / 3.5);
    width: calc((100vw - 62px) / 3.5);

    max-width: none;
  }

}


@media screen and (max-width: 989px) {

  .vhl-essentials {
    padding: 55px 0 70px;
  }

  .vhl-essentials__inner {
    width: calc(100% - 40px);
  }

  .vhl-essentials__products {
    gap: 16px;
  }

  .vhl-essentials__card {
    flex: 0 0 calc((100vw - 72px) / 2.6);

    width: calc((100vw - 72px) / 2.6);

    min-width: 0;
    max-width: none;
  }

}


/* =========================================================
   MOBILE
   ========================================================= */

@media screen and (max-width: 749px) {

  .vhl-essentials {
    padding: 45px 0 55px;
  }

  .vhl-essentials__inner {
    width: 100%;
  }

  .vhl-essentials__header {
    padding: 0 16px;

    margin-bottom: 24px;
  }

  .vhl-essentials__header h2 {
    font-size: 14px;
  }

  .vhl-essentials__more {
    gap: 8px;

    font-size: 14px;
  }

  .vhl-essentials__more span {
    font-size: 20px;
  }

  .vhl-essentials__viewport {
    padding: 0;
  }

  .vhl-essentials__products {
    gap: 10px;

    padding: 0 16px 8px;

    min-width: max-content;

    scroll-snap-type: x proximity;
  }

  .vhl-essentials__card {
    flex: 0 0 72vw !important;

    width: 72vw !important;

    min-width: 72vw !important;
    max-width: 72vw !important;

    scroll-snap-align: start;
  }

  .vhl-essentials__info {
    min-height: 88px;

    padding: 14px 8px 16px;
  }

  .vhl-essentials__title {
    margin-bottom: 7px;

    font-size: 12px;
    line-height: 1.25;
  }

  .vhl-essentials__prices {
    gap: 5px;
  }

  .vhl-essentials__price {
    font-size: 13px;
  }

  .vhl-essentials__compare {
    font-size: 11px;
  }

}

</style>

{% endif %}


{% schema %}
{
  "name": "VHL Badkamer Essentials",
  "settings": [],
  "presets": [
    {
      "name": "VHL Badkamer Essentials"
    }
  ]
}
{% endschema %}