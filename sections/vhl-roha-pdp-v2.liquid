{%- comment -%}
  VHL ROHA PDP — V2 (Fase 1: visuele prototype)
  ================================================
  Losse, opnieuw vanaf nul opgebouwde reconstructie van het bovenste
  productgedeelte van de ROHA HOME-referentiescreenshot. Deelt GEEN code,
  markup of CSS met sections/vhl-roha-pdp.liquid (V1) — V1 blijft
  ongewijzigd en herstelbaar door in templates/product.vacuum-hook.json
  de sectie "vhl_vacuum_main" terug te zetten naar "type": "vhl-roha-pdp".

  FASE 1 = ALLEEN VISUELE DESKTOP-RECONSTRUCTIE. Nadrukkelijk NIET in
  deze versie:
  - geen echte variant-/optielogica of -parser;
  - geen product-form / cart-functionaliteit (ATC is een inerte
    <button type="button">, geen <form>, geen submit);
  - geen quantity-logica, geen sticky ATC, geen JS überhaupt;
  - geen reviews-/shipping-policy-integratie.
  De ATC is bewust géén button[type="submit"], dus de site-brede
  !important-styling uit snippets/global-button-fix.liquid (die op
  button[type="submit"] targeted) raakt dit element sowieso niet; er is
  hier dus geen !important-tegenmaatregel nodig zoals in V1.

  PLACEHOLDER-CONTENT — duidelijk gemarkeerd met
  "VISUAL PROTOTYPE ONLY — REPLACE IN PHASE 2" bij elk blok hieronder:
  rating, USP's, Kleur-label + 6 swatches, betaalregel, trust-card,
  beide accordion-teksten, en (uitsluitend als de echte
  compare_at_price ontbreekt) de doorgestreepte prijs. Dit is generieke,
  neutrale prototype-tekst — geen ROHA-merknaam, geen ROHA-claims, geen
  ROHA-reviewcijfers.

  ECHTE Shopify-data die WEL wordt gebruikt (loutere weergave, geen
  logica): product.title, product.featured_media + product.media
  (thumbnails/hoofdafbeelding), en de prijs van de eerste beschikbare
  variant.
{%- endcomment -%}

{%- liquid
  assign v2_variant = product.selected_or_first_available_variant
  assign v2_image = v2_variant.featured_image | default: product.featured_media
  assign v2_active_media_id = v2_image.id
  assign v2_media_count = 0
  for media in product.media
    if media.media_type == 'image'
      assign v2_media_count = v2_media_count | plus: 1
    endif
  endfor
  assign v2_has_real_compare = false
  if v2_variant.compare_at_price > v2_variant.price
    assign v2_has_real_compare = true
  endif
  assign root_id = 'vhl-roha-v2-' | append: section.id
-%}

<section id="{{ root_id }}" class="vhl-roha-v2" {{ section.shopify_attributes }}>
  <div class="vhl-roha-v2__container">
    <div class="vhl-roha-v2__row">

      {%- if v2_media_count > 1 -%}
        <div class="vhl-roha-v2__thumbs">
          {%- for media in product.media -%}
            {%- if media.media_type == 'image' -%}
              {%- assign v2_is_active = false -%}
              {%- if v2_active_media_id != blank and media.id == v2_active_media_id -%}
                {%- assign v2_is_active = true -%}
              {%- elsif v2_active_media_id == blank and forloop.first -%}
                {%- assign v2_is_active = true -%}
              {%- endif -%}
              <span class="vhl-roha-v2__thumb{% if v2_is_active %} is-active{% endif %}">
                <img src="{{ media | image_url: width: 160 }}" alt="" loading="lazy" width="64" height="64">
              </span>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}

      <div class="vhl-roha-v2__gallery">
        <img
          src="{{ v2_image | image_url: width: 1600 }}"
          alt="{{ v2_image.alt | default: product.title | escape }}"
          width="1200"
          height="1200"
          loading="eager"
        >
        {%- comment -%} VISUAL PROTOTYPE ONLY — REPLACE IN PHASE 2: inerte, niet-functionele galerij-navigatieknop, puur voor pixel-gelijkenis met TARGET. {%- endcomment -%}
        <span class="vhl-roha-v2__gallery-nav" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none"><path d="M9 5l7 7-7 7" stroke="#1a1a1a" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg>
        </span>
      </div>

      <div class="vhl-roha-v2__panel">

        {%- comment -%} VISUAL PROTOTYPE ONLY — REPLACE IN PHASE 2: generieke placeholder-ratingregel, geen echte reviewdata. {%- endcomment -%}
        <div class="vhl-roha-v2__rating">
          <span class="vhl-roha-v2__rating-stars" aria-hidden="true">
            <svg viewBox="0 0 20 20"><path d="M10 1.5l2.6 5.3 5.8.8-4.2 4.1 1 5.8L10 14.6l-5.2 2.9 1-5.8L1.6 7.6l5.8-.8L10 1.5z"></path></svg>
            <svg viewBox="0 0 20 20"><path d="M10 1.5l2.6 5.3 5.8.8-4.2 4.1 1 5.8L10 14.6l-5.2 2.9 1-5.8L1.6 7.6l5.8-.8L10 1.5z"></path></svg>
            <svg viewBox="0 0 20 20"><path d="M10 1.5l2.6 5.3 5.8.8-4.2 4.1 1 5.8L10 14.6l-5.2 2.9 1-5.8L1.6 7.6l5.8-.8L10 1.5z"></path></svg>
            <svg viewBox="0 0 20 20"><path d="M10 1.5l2.6 5.3 5.8.8-4.2 4.1 1 5.8L10 14.6l-5.2 2.9 1-5.8L1.6 7.6l5.8-.8L10 1.5z"></path></svg>
            <svg viewBox="0 0 20 20"><path d="M10 1.5l2.6 5.3 5.8.8-4.2 4.1 1 5.8L10 14.6l-5.2 2.9 1-5.8L1.6 7.6l5.8-.8L10 1.5z"></path></svg>
          </span>
          <span class="vhl-roha-v2__rating-text">Placeholder / 5 <strong>Placeholder beoordelingen</strong></span>
        </div>

        <h1 class="vhl-roha-v2__title">{{ product.title }}</h1>

        <div class="vhl-roha-v2__price">
          {%- if v2_has_real_compare -%}
            <span class="vhl-roha-v2__price-compare">{{ v2_variant.compare_at_price | money }}</span>
          {%- else -%}
            {%- comment -%} VISUAL PROTOTYPE ONLY — REPLACE IN PHASE 2: echte compare_at_price ontbreekt op deze variant; onderstaand bedrag is een placeholder, geen echte vanaf-prijs. {%- endcomment -%}
            <span class="vhl-roha-v2__price-compare" data-prototype-only>{{ v2_variant.price | times: 1.4 | money }}</span>
          {%- endif -%}
          <span class="vhl-roha-v2__price-current">{{ v2_variant.price | money }}</span>
        </div>

        {%- comment -%} VISUAL PROTOTYPE ONLY — REPLACE IN PHASE 2: generieke placeholder-USP's, geen echte producteigenschappen. {%- endcomment -%}
        <ul class="vhl-roha-v2__usps">
          <li>
            <svg class="vhl-roha-v2__usp-icon" viewBox="0 0 20 20" aria-hidden="true"><circle cx="10" cy="10" r="10" fill="#1a1a1a"></circle><path d="M6 10.3l2.6 2.6L14 7.3" fill="none" stroke="#ffffff" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path></svg>
            <span>Placeholder USP-regel 1</span>
          </li>
          <li>
            <svg class="vhl-roha-v2__usp-icon" viewBox="0 0 20 20" aria-hidden="true"><circle cx="10" cy="10" r="10" fill="#1a1a1a"></circle><path d="M6 10.3l2.6 2.6L14 7.3" fill="none" stroke="#ffffff" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path></svg>
            <span>Placeholder USP-regel 2</span>
          </li>
          <li>
            <svg class="vhl-roha-v2__usp-icon" viewBox="0 0 20 20" aria-hidden="true"><circle cx="10" cy="10" r="10" fill="#1a1a1a"></circle><path d="M6 10.3l2.6 2.6L14 7.3" fill="none" stroke="#ffffff" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path></svg>
            <span>Placeholder USP-regel 3</span>
          </li>
        </ul>

        {%- comment -%} VISUAL PROTOTYPE ONLY — REPLACE IN PHASE 2: placeholder-optielabel en 6 statische swatch-cirkels, geen echte Shopify-variantopties/-logica. {%- endcomment -%}
        <div class="vhl-roha-v2__variant">
          <div class="vhl-roha-v2__variant-heading">
            <span class="vhl-roha-v2__variant-name">Optie:</span>
            <span class="vhl-roha-v2__variant-selected">Placeholder waarde</span>
          </div>
          <div class="vhl-roha-v2__swatches">
            <span class="vhl-roha-v2__swatch is-selected" style="background-color:#1a1a1a;"></span>
            <span class="vhl-roha-v2__swatch" style="background-color:#c7c7c7;"></span>
            <span class="vhl-roha-v2__swatch" style="background-color:#c9a227;"></span>
            <span class="vhl-roha-v2__swatch" style="background-color:#ffffff;"></span>
            <span class="vhl-roha-v2__swatch" style="background-color:#5a5a5a;"></span>
            <span class="vhl-roha-v2__swatch" style="background-color:#b08d3e;"></span>
          </div>
        </div>

        {%- comment -%} Fase 1: inerte knop, geen <form>, geen submit, geen product-form JS. {%- endcomment -%}
        <button type="button" class="vhl-roha-v2__atc" disabled aria-disabled="true">
          <svg class="vhl-roha-v2__atc-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M3 4h2l1.6 9.6a2 2 0 0 0 2 1.7h7.6a2 2 0 0 0 2-1.6L19.5 8H6.2" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
            <circle cx="9.5" cy="19.5" r="1.4" fill="currentColor"></circle>
            <circle cx="17" cy="19.5" r="1.4" fill="currentColor"></circle>
          </svg>
          <span>In winkelwagen <span class="vhl-roha-v2__atc-sep">&bull;</span> {{ v2_variant.price | money }}</span>
        </button>

        {%- comment -%} VISUAL PROTOTYPE ONLY — REPLACE IN PHASE 2: statische betaalregel, geen echte shop.enabled_payment_types-koppeling. {%- endcomment -%}
        <div class="vhl-roha-v2__payments">
          <svg class="vhl-roha-v2__payments-lock" viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <rect x="4" y="9" width="12" height="8" rx="1.5" stroke="currentColor" stroke-width="1.4"></rect>
            <path d="M6.5 9V6.5a3.5 3.5 0 0 1 7 0V9" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"></path>
          </svg>
          <span>Betaal veilig met <span class="vhl-roha-v2__payments-link">deze betaalmogelijkheden</span>.</span>
        </div>

        {%- comment -%} VISUAL PROTOTYPE ONLY — REPLACE IN PHASE 2: generieke placeholder trust-kaart, geen ROHA-tekst/-claims. {%- endcomment -%}
        <div class="vhl-roha-v2__trust">
          <span class="vhl-roha-v2__trust-badge">Placeholder badge</span>
          <p class="vhl-roha-v2__trust-heading">Placeholder headline</p>
          <p class="vhl-roha-v2__trust-body">Placeholder bodytekst ter grootte en positie van de originele trust-kaart, later te vervangen door echte merchant-content.</p>
          <p class="vhl-roha-v2__trust-warning">Placeholder tweede tekstregel / waarschuwing.</p>
        </div>

        {%- comment -%} VISUAL PROTOTYPE ONLY — REPLACE IN PHASE 2: placeholder accordion-inhoud, labels zelf zijn generieke UI-tekst. {%- endcomment -%}
        <div class="vhl-roha-v2__accordions">
          <details class="vhl-roha-v2__accordion" open>
            <summary>Product details</summary>
            <div class="vhl-roha-v2__accordion-body">Placeholder producttekst.</div>
          </details>
          <details class="vhl-roha-v2__accordion">
            <summary>Verzending &amp; retour</summary>
            <div class="vhl-roha-v2__accordion-body">Placeholder verzend- en retourtekst.</div>
          </details>
        </div>

      </div>
    </div>
  </div>
</section>

{% style %}
  #{{ root_id }} {
    background: #ffffff;
    display: block;
  }

  #{{ root_id }} .vhl-roha-v2__container {
    max-width: 1800px;
    width: 90%;
    margin: 0 auto;
    padding: 14px 0 48px;
  }

  #{{ root_id }} .vhl-roha-v2__row {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  @media screen and (max-width: 767px) {
    #{{ root_id }} .vhl-roha-v2__container {
      width: calc(100% - 36px);
      padding: 12px 0 36px;
    }
  }

  #{{ root_id }} .vhl-roha-v2__thumbs {
    display: flex;
    flex-direction: row;
    gap: 10px;
    overflow-x: auto;
    padding-bottom: 2px;
  }

  #{{ root_id }} .vhl-roha-v2__thumb {
    flex: 0 0 auto;
    display: block;
    width: 60px;
    height: 60px;
    border-radius: 8px;
    overflow: hidden;
    border: 1px solid #e5e0d8;
    background: #f7f5f2;
  }

  #{{ root_id }} .vhl-roha-v2__thumb.is-active {
    border-color: #1a1a1a;
    box-shadow: 0 0 0 1px #1a1a1a;
  }

  #{{ root_id }} .vhl-roha-v2__thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  #{{ root_id }} .vhl-roha-v2__gallery {
    position: relative;
    background: #ffffff;
    overflow: hidden;
    aspect-ratio: 1 / 1;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  #{{ root_id }} .vhl-roha-v2__gallery img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }

  #{{ root_id }} .vhl-roha-v2__gallery-nav {
    position: absolute;
    top: 6%;
    right: 6%;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: #ffffff;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.12);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  #{{ root_id }} .vhl-roha-v2__gallery-nav svg {
    width: 18px;
    height: 18px;
  }

  #{{ root_id }} .vhl-roha-v2__panel {
    min-width: 0;
  }

  @media screen and (min-width: 990px) {
    #{{ root_id }} .vhl-roha-v2__row {
      flex-direction: row;
      align-items: stretch;
    }
    #{{ root_id }} .vhl-roha-v2__thumbs {
      flex: 0 0 4.5%;
      margin-right: 3%;
      flex-direction: column;
      overflow-y: auto;
      overflow-x: hidden;
      gap: 12px;
    }
    #{{ root_id }} .vhl-roha-v2__thumb {
      width: 100%;
      height: auto;
      aspect-ratio: 1 / 1;
    }
    #{{ root_id }} .vhl-roha-v2__gallery {
      flex: 1 1 49%;
      margin-right: 6%;
      min-width: 0;
    }
    #{{ root_id }} .vhl-roha-v2__panel {
      flex: 0 0 37.5%;
    }
  }

  #{{ root_id }} .vhl-roha-v2__rating {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0 0 14px;
  }

  #{{ root_id }} .vhl-roha-v2__rating-stars {
    display: inline-flex;
    gap: 2px;
  }

  #{{ root_id }} .vhl-roha-v2__rating-stars svg {
    width: 15px;
    height: 15px;
    fill: #1a1a1a;
  }

  #{{ root_id }} .vhl-roha-v2__rating-text {
    font-size: 13px;
    color: #6b6b68;
  }

  #{{ root_id }} .vhl-roha-v2__rating-text strong {
    color: #1a1a1a;
  }

  #{{ root_id }} .vhl-roha-v2__title {
    font-size: 24px;
    line-height: 1.2;
    margin: 0 0 8px;
    color: #1a1a1a;
    font-weight: 700;
    letter-spacing: -0.01em;
    text-transform: uppercase;
  }

  @media screen and (min-width: 990px) {
    #{{ root_id }} .vhl-roha-v2__title {
      font-size: 27px;
    }
  }

  #{{ root_id }} .vhl-roha-v2__price {
    display: flex;
    align-items: baseline;
    gap: 10px;
    margin: 0 0 16px;
  }

  #{{ root_id }} .vhl-roha-v2__price-current {
    font-size: 24px;
    font-weight: 700;
    color: #1a1a1a;
  }

  @media screen and (min-width: 990px) {
    #{{ root_id }} .vhl-roha-v2__price-current {
      font-size: 27px;
    }
  }

  #{{ root_id }} .vhl-roha-v2__price-compare {
    font-size: 17px;
    color: #9c9c9c;
    text-decoration: line-through;
  }

  #{{ root_id }} .vhl-roha-v2__usps {
    list-style: none;
    margin: 0 0 16px;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  #{{ root_id }} .vhl-roha-v2__usps li {
    font-size: 14px;
    color: #1a1a1a;
    display: flex;
    align-items: center;
    gap: 9px;
  }

  #{{ root_id }} .vhl-roha-v2__usp-icon {
    width: 18px;
    height: 18px;
    flex: 0 0 auto;
  }

  #{{ root_id }} .vhl-roha-v2__variant {
    margin-bottom: 14px;
  }

  #{{ root_id }} .vhl-roha-v2__variant-heading {
    display: flex;
    align-items: baseline;
    gap: 6px;
    margin-bottom: 8px;
    font-size: 14px;
  }

  #{{ root_id }} .vhl-roha-v2__variant-name {
    font-weight: 600;
    color: #1a1a1a;
  }

  #{{ root_id }} .vhl-roha-v2__variant-selected {
    color: #6b6b68;
  }

  #{{ root_id }} .vhl-roha-v2__swatches {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
  }

  #{{ root_id }} .vhl-roha-v2__swatch {
    display: block;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    border: 1px solid #e5e0d8;
  }

  #{{ root_id }} .vhl-roha-v2__swatch.is-selected {
    box-shadow: 0 0 0 2px #ffffff, 0 0 0 3.5px #262625;
  }

  #{{ root_id }} .vhl-roha-v2__atc {
    width: 100%;
    min-height: 56px;
    border: 0;
    border-radius: 999px;
    background: #1a1a1a;
    color: #ffffff;
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.4px;
    text-transform: uppercase;
    cursor: default;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    margin-top: 18px;
    font-family: inherit;
  }

  #{{ root_id }} .vhl-roha-v2__atc-icon {
    width: 19px;
    height: 19px;
    flex: 0 0 auto;
    color: #ffffff;
  }

  #{{ root_id }} .vhl-roha-v2__atc-sep {
    opacity: 0.6;
    font-weight: 400;
  }

  #{{ root_id }} .vhl-roha-v2__payments {
    margin-top: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 7px;
    font-size: 13px;
    color: #6b6b68;
    text-align: center;
  }

  #{{ root_id }} .vhl-roha-v2__payments-lock {
    width: 15px;
    height: 15px;
    flex: 0 0 auto;
    color: #6b6b68;
  }

  #{{ root_id }} .vhl-roha-v2__payments-link {
    color: #1a1a1a;
    font-weight: 600;
    text-decoration: underline;
  }

  #{{ root_id }} .vhl-roha-v2__trust {
    margin-top: 18px;
    padding: 24px 20px;
    border: 1px dashed #d8d2c6;
    border-radius: 12px;
    background: #faf8f5;
    text-align: center;
  }

  #{{ root_id }} .vhl-roha-v2__trust-badge {
    display: inline-flex;
    align-items: center;
    padding: 5px 12px;
    border-radius: 999px;
    background: #ffffff;
    border: 1px solid #e5e0d8;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #6b6b68;
    margin-bottom: 12px;
  }

  #{{ root_id }} .vhl-roha-v2__trust-heading {
    margin: 0 0 8px;
    font-size: 22px;
    font-weight: 700;
    color: #1a1a1a;
  }

  #{{ root_id }} .vhl-roha-v2__trust-body {
    margin: 0 0 10px;
    font-size: 13px;
    line-height: 1.6;
    color: #4a4a47;
  }

  #{{ root_id }} .vhl-roha-v2__trust-warning {
    margin: 0;
    font-size: 12px;
    font-weight: 600;
    line-height: 1.6;
    color: #6b6b68;
  }

  #{{ root_id }} .vhl-roha-v2__accordions {
    margin-top: 16px;
  }

  #{{ root_id }} .vhl-roha-v2__accordion {
    border-top: 1px solid #eceae5;
  }

  #{{ root_id }} .vhl-roha-v2__accordion:last-child {
    border-bottom: 1px solid #eceae5;
  }

  #{{ root_id }} .vhl-roha-v2__accordion summary {
    cursor: pointer;
    list-style: none;
    padding: 14px 2px;
    font-size: 12.5px;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: #1a1a1a;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  #{{ root_id }} .vhl-roha-v2__accordion summary::-webkit-details-marker {
    display: none;
  }

  #{{ root_id }} .vhl-roha-v2__accordion summary::after {
    content: '';
    flex: 0 0 auto;
    width: 9px;
    height: 9px;
    margin-left: 12px;
    border-right: 1.5px solid #1a1a1a;
    border-bottom: 1.5px solid #1a1a1a;
    transform: rotate(45deg);
    transition: transform 0.15s ease;
  }

  #{{ root_id }} .vhl-roha-v2__accordion[open] summary::after {
    transform: rotate(225deg);
  }

  #{{ root_id }} .vhl-roha-v2__accordion-body {
    padding: 0 2px 14px;
    font-size: 13px;
    line-height: 1.7;
    color: #4a4a47;
  }
{% endstyle %}

