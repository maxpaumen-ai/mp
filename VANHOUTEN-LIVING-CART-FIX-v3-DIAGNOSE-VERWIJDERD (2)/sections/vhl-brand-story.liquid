{% assign brand_image_alt = section.settings.image.alt | default: section.settings.heading %}
<section id="VHLBrandStory-{{ section.id }}" class="vhl-brand-story">
  <div class="vhl-brand-story__inner vhl-brand-story__inner--{{ section.settings.image_side }}">
    <div class="vhl-brand-story__media">
      {% if section.settings.image != blank %}
        {{ section.settings.image | image_url: width: 1800 | image_tag: class: 'vhl-brand-story__image', loading: 'lazy', widths: '480, 750, 1000, 1400, 1800', sizes: '(min-width: 750px) 55vw, 100vw', alt: brand_image_alt }}
      {% else %}
        {{ 'lifestyle-1' | placeholder_svg_tag: 'vhl-brand-story__image vhl-brand-story__placeholder' }}
      {% endif %}
    </div>
    <div class="vhl-brand-story__content">
      {% if section.settings.eyebrow != blank %}<p class="vhl-brand-story__eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}
      {% if section.settings.heading != blank %}<h2 class="vhl-brand-story__heading">{{ section.settings.heading | escape }}</h2>{% endif %}
      {% if section.settings.text != blank %}<div class="vhl-brand-story__text rte">{{ section.settings.text }}</div>{% endif %}
      {% if section.settings.button_text != blank %}<a class="vhl-brand-story__link" href="{{ section.settings.button_link | default: routes.root_url }}">{{ section.settings.button_text | escape }} <span aria-hidden="true">→</span></a>{% endif %}
    </div>
  </div>
</section>
{% style %}
  #VHLBrandStory-{{ section.id }}{overflow:hidden;padding:{{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;background:{{ section.settings.background }};color:{{ section.settings.text_color }}}#VHLBrandStory-{{ section.id }} *{box-sizing:border-box}#VHLBrandStory-{{ section.id }} .vhl-brand-story__inner{display:grid;grid-template-columns:minmax(0,1.08fr) minmax(320px,.72fr);align-items:center;gap:clamp(42px,8vw,120px);width:min(100%,1500px);margin:auto;padding:0 clamp(18px,4vw,58px)}#VHLBrandStory-{{ section.id }} .vhl-brand-story__inner--right .vhl-brand-story__media{order:2}#VHLBrandStory-{{ section.id }} .vhl-brand-story__media{overflow:hidden;aspect-ratio:5/6;border-radius:{{ section.settings.radius }}px;background:#e8e0d5}#VHLBrandStory-{{ section.id }} .vhl-brand-story__image{display:block;width:100%;height:100%;object-fit:cover;object-position:{{ section.settings.image_position }}}#VHLBrandStory-{{ section.id }} .vhl-brand-story__placeholder{background:#d8d1c7}#VHLBrandStory-{{ section.id }} .vhl-brand-story__content{max-width:560px}#VHLBrandStory-{{ section.id }} .vhl-brand-story__eyebrow{margin:0 0 15px;font-size:11px;font-weight:700;letter-spacing:.22em;text-transform:uppercase;opacity:.62}#VHLBrandStory-{{ section.id }} .vhl-brand-story__heading{margin:0;color:{{ section.settings.text_color }}!important;font-family:var(--font-heading-family);font-size:clamp(38px,4.6vw,66px);font-weight:var(--font-heading-weight);line-height:1;letter-spacing:-.045em}#VHLBrandStory-{{ section.id }} .vhl-brand-story__text{margin-top:24px;font-size:16px;line-height:1.75;opacity:.78}#VHLBrandStory-{{ section.id }} .vhl-brand-story__link{display:inline-flex;gap:12px;margin-top:28px;padding-bottom:6px;border-bottom:1px solid currentColor;color:inherit;text-decoration:none;font-size:12px;font-weight:700;letter-spacing:.12em;text-transform:uppercase}#VHLBrandStory-{{ section.id }} .vhl-brand-story__link span{transition:transform 220ms ease}@media(hover:hover){#VHLBrandStory-{{ section.id }} .vhl-brand-story__link:hover span{transform:translateX(4px)}}@media(max-width:749px){#VHLBrandStory-{{ section.id }}{padding:{{ section.settings.padding_top_mobile }}px 0 {{ section.settings.padding_bottom_mobile }}px}#VHLBrandStory-{{ section.id }} .vhl-brand-story__inner{grid-template-columns:minmax(0,1fr);gap:32px;padding-inline:16px}#VHLBrandStory-{{ section.id }} .vhl-brand-story__inner--right .vhl-brand-story__media{order:0}#VHLBrandStory-{{ section.id }} .vhl-brand-story__media{aspect-ratio:4/5;border-radius:min({{ section.settings.radius }}px,22px)}#VHLBrandStory-{{ section.id }} .vhl-brand-story__heading{font-size:clamp(34px,10vw,48px)}#VHLBrandStory-{{ section.id }} .vhl-brand-story__text{font-size:15px}}@media(prefers-reduced-motion:reduce){#VHLBrandStory-{{ section.id }} .vhl-brand-story__link span{transition:none}}
{% endstyle %}
{% schema %}
{"name":"VHL Brand Story","tag":"section","class":"section-vhl-brand-story","settings":[{"type":"image_picker","id":"image","label":"Afbeelding"},{"type":"select","id":"image_position","label":"Afbeeldingspositie","default":"center center","options":[{"value":"left center","label":"Links"},{"value":"center center","label":"Midden"},{"value":"right center","label":"Rechts"}]},{"type":"select","id":"image_side","label":"Beeldzijde desktop","default":"left","options":[{"value":"left","label":"Links"},{"value":"right","label":"Rechts"}]},{"type":"text","id":"eyebrow","label":"Boventitel","default":"VANHOUTEN LIVING"},{"type":"text","id":"heading","label":"Titel","default":"Rust begint bij aandacht voor detail"},{"type":"richtext","id":"text","label":"Tekst","default":"<p>Wij selecteren badkamerinterieur en accessoires op uitstraling, kwaliteit en tijdloos gebruik. Zo ontstaat een rustige ruimte waarin natuurlijke materialen en verfijnde details samenkomen.</p>"},{"type":"text","id":"button_text","label":"Linktekst","default":"Ontdek ons verhaal"},{"type":"url","id":"button_link","label":"Link"},{"type":"color","id":"background","label":"Achtergrond","default":"#E8E0D5"},{"type":"color","id":"text_color","label":"Tekstkleur","default":"#24211E"},{"type":"range","id":"radius","label":"Afronding afbeelding","min":0,"max":40,"step":1,"unit":"px","default":24},{"type":"range","id":"padding_top","label":"Bovenruimte desktop","min":30,"max":160,"step":5,"unit":"px","default":110},{"type":"range","id":"padding_bottom","label":"Onderruimte desktop","min":30,"max":160,"step":5,"unit":"px","default":110},{"type":"range","id":"padding_top_mobile","label":"Bovenruimte mobiel","min":20,"max":100,"step":5,"unit":"px","default":60},{"type":"range","id":"padding_bottom_mobile","label":"Onderruimte mobiel","min":20,"max":100,"step":5,"unit":"px","default":60}],"presets":[{"name":"VHL Brand Story"}]}
{% endschema %}
