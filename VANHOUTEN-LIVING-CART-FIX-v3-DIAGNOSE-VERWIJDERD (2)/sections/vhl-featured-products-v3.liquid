{% style %}
/* ==========================================================
   VANHOUTEN LIVING
   Featured Products V3
========================================================== */

.vhl-featured-products{
  --vhl-bg:#F8F5F1;
  --vhl-card:#FFFFFF;
  --vhl-text:#2C2C2C;
  --vhl-text-light:#6B6B6B;
  --vhl-border:#ECE8E3;
  --vhl-accent-dark:#B89F7D;
  --vhl-radius:22px;
  --vhl-shadow:0 18px 50px rgba(32,25,20,.08);

  position:relative;
  width:100%;
  padding:96px 0;
  background:var(--vhl-bg);
}

.vhl-featured-products *,
.vhl-featured-products *::before,
.vhl-featured-products *::after{
  box-sizing:border-box;
}

.vhl-featured-products .page-width{
  max-width:1440px;
  margin:0 auto;
  padding:0 40px;
}

/* ==========================================================
   Header
========================================================== */

.vhl-header{
  max-width:820px;
  margin:0 auto 56px;
  text-align:center;
}

.vhl-subtitle{
  display:inline-block;
  margin-bottom:13px;
  font-size:11px;
  font-weight:600;
  line-height:1.2;
  letter-spacing:.22em;
  text-transform:uppercase;
  color:var(--vhl-text-light);
}

.vhl-title{
  margin:0;
  font-size:clamp(34px,4vw,50px);
  font-weight:300;
  line-height:1.08;
  letter-spacing:-.035em;
  color:var(--vhl-text);
}

.vhl-description{
  max-width:700px;
  margin:20px auto 0;
  font-size:16px;
  line-height:1.75;
  color:var(--vhl-text-light);
}

.vhl-description p{
  margin:0;
}

/* ==========================================================
   Grid
========================================================== */

.vhl-grid{
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(min(100%,340px),1fr));
  gap:30px;
  align-items:stretch;
}

/* ==========================================================
   Product Card
========================================================== */

.vhl-card{
  position:relative;
  min-width:0;
  height:100%;
}

.vhl-card__inner{
  position:relative;
  display:flex;
  flex-direction:column;
  height:100%;
  overflow:hidden;
  background:var(--vhl-card);
  border:1px solid rgba(44,44,44,.06);
  border-radius:var(--vhl-radius);
  box-shadow:0 8px 28px rgba(32,25,20,.045);
  transition:
    transform .4s cubic-bezier(.22,1,.36,1),
    box-shadow .4s ease,
    border-color .4s ease;
}

@media (hover:hover){
  .vhl-card:hover .vhl-card__inner{
    transform:translateY(-6px);
    border-color:rgba(184,159,125,.28);
    box-shadow:var(--vhl-shadow);
  }
}

/* ==========================================================
   Product Media
========================================================== */

.vhl-card__media{
  position:relative;
  width:100%;
  overflow:hidden;
  aspect-ratio:1 / 1;
  padding:32px;
  background:#F1EEEA;
}

.vhl-card__media-link{
  display:block;
  width:100%;
  height:100%;
  color:inherit;
  text-decoration:none;
}

.vhl-card__image{
  position:absolute;
  inset:0;
  width:100%;
  height:100%;
  object-fit:contain;
  object-position:center;
  transform:scale(1);
  transition:
    opacity .5s ease,
    transform .75s cubic-bezier(.22,1,.36,1);
}

.vhl-card__image--primary{
  z-index:1;
  opacity:1;
}

.vhl-card__image--secondary{
  z-index:2;
  opacity:0;
}

@media (hover:hover){
  .vhl-card:hover .vhl-card__image--primary{
    transform:scale(1.035);
  }

  .vhl-card:hover .vhl-card__image--secondary{
    opacity:1;
    transform:scale(1.035);
  }
}

.vhl-card__placeholder{
  position:absolute;
  inset:0;
  display:flex;
  align-items:center;
  justify-content:center;
  background:linear-gradient(145deg,#F6F3EF 0%,#ECE6DF 100%);
}

.vhl-card__placeholder svg{
  width:44%;
  height:auto;
  opacity:.3;
}

/* ==========================================================
   Badges
========================================================== */

.vhl-card__badges{
  position:absolute;
  top:14px;
  left:14px;
  z-index:5;
  display:flex;
  flex-wrap:wrap;
  gap:7px;
}

.vhl-card__badge{
  display:inline-flex;
  align-items:center;
  justify-content:center;
  min-height:28px;
  padding:0 11px;
  border-radius:999px;
  font-size:10px;
  font-weight:600;
  letter-spacing:.09em;
  text-transform:uppercase;
  backdrop-filter:blur(10px);
}

.vhl-card__badge--sale{
  background:#242424;
  color:#fff;
}

.vhl-card__badge--new{
  border:1px solid rgba(0,0,0,.07);
  background:rgba(255,255,255,.92);
  color:var(--vhl-text);
}

/* ==========================================================
   Card Content
========================================================== */

.vhl-card__content{
  position:relative;
  z-index:2;
  display:flex;
  flex:1;
  flex-direction:column;
  padding:24px 20px 20px;
  background:var(--vhl-card);
}

.vhl-card__vendor{
  display:block;
  margin:0 0 7px;
  font-size:10px;
  font-weight:600;
  line-height:1.3;
  letter-spacing:.15em;
  text-transform:uppercase;
  color:var(--vhl-text-light);
}

.vhl-card__title{
  display:-webkit-box;
  min-height:2.8em;
  margin:0;
  overflow:hidden;
  -webkit-box-orient:vertical;
  -webkit-line-clamp:2;
  font-size:18px;
  font-weight:400;
  line-height:1.4;
  letter-spacing:-.015em;
  color:var(--vhl-text);
}

.vhl-card__title-link{
  color:inherit;
  text-decoration:none;
  transition:opacity .25s ease;
}

.vhl-card__title-link:hover{
  opacity:.66;
}

/* ==========================================================
   Price
========================================================== */

.vhl-card__price{
  display:flex;
  align-items:center;
  flex-wrap:wrap;
  gap:9px;
  margin-top:14px;
}

.vhl-card__price-current{
  font-size:20px;
  font-weight:600;
  line-height:1.3;
  color:var(--vhl-text);
}

.vhl-card__price-compare{
  font-size:14px;
  line-height:1.3;
  color:var(--vhl-text-light);
  text-decoration:line-through;
}

/* ==========================================================
   Actions
========================================================== */

.vhl-card__actions{
  position:relative;
  z-index:3;
  margin-top:auto;
  padding-top:12px;
}

.vhl-product-form{
  margin:0;
}

.vhl-btn{
  display:flex;
  align-items:center;
  justify-content:center;
  width:100%;
  min-height:39px;
  padding:8px 18px;
  border:0;
  border-radius:999px;
  cursor:pointer;
  font:inherit;
  font-size:11px;
  font-weight:600;
  line-height:1.2;
  letter-spacing:.11em;
  text-align:center;
  text-decoration:none;
  text-transform:uppercase;
  transition:
    background .25s ease,
    color .25s ease,
    transform .25s ease,
    opacity .25s ease;
}

.vhl-btn--primary{
  background:var(--vhl-text);
  color:#fff;
}

.vhl-btn--primary:hover{
  background:var(--vhl-accent-dark);
  color:#fff;
  transform:translateY(-1px);
}

.vhl-btn--secondary{
  background:#F0ECE7;
  color:var(--vhl-text);
}

.vhl-btn:disabled,
.vhl-btn[aria-busy="true"]{
  cursor:wait;
  opacity:.68;
  transform:none;
}

/* ==========================================================
   Sold Out
========================================================== */

.vhl-card--sold-out{
  opacity:.82;
}

.vhl-card--sold-out .vhl-card__image{
  filter:grayscale(.15);
}

/* ==========================================================
   Empty State
========================================================== */

.vhl-empty{
  padding:90px 30px;
  text-align:center;
  border:1px dashed var(--vhl-border);
  border-radius:var(--vhl-radius);
  background:#fff;
}

.vhl-empty h3{
  margin:0 0 12px;
  font-size:25px;
  font-weight:400;
}

.vhl-empty p{
  margin:0;
  line-height:1.7;
  color:var(--vhl-text-light);
}

/* ==========================================================
   Reveal Animation
========================================================== */

.vhl-reveal{
  opacity:0;
  transform:translateY(24px);
  transition:
    opacity .65s ease,
    transform .65s cubic-bezier(.22,1,.36,1);
}

.vhl-reveal.is-visible{
  opacity:1;
  transform:none;
}

/* ==========================================================
   Accessibility
========================================================== */

.vhl-card__media-link:focus-visible,
.vhl-card__title-link:focus-visible,
.vhl-btn:focus-visible{
  outline:2px solid var(--vhl-text);
  outline-offset:3px;
}

@media (prefers-reduced-motion:reduce){
  .vhl-card__inner,
  .vhl-card__image,
  .vhl-btn,
  .vhl-reveal{
    transition:none !important;
    animation:none !important;
  }

  .vhl-reveal{
    opacity:1;
    transform:none;
  }
}

/* ==========================================================
   Tablet
========================================================== */

@media screen and (max-width:1199px){
  .vhl-featured-products{
    padding:78px 0;
  }

  .vhl-featured-products .page-width{
    padding:0 28px;
  }

  .vhl-grid{
    grid-template-columns:repeat(2,minmax(0,1fr));
    gap:24px;
  }
}

/* ==========================================================
   Mobile
========================================================== */

@media screen and (max-width:749px){
  .vhl-featured-products{
    padding:58px 0;
  }

  .vhl-featured-products .page-width{
    padding:0 18px;
  }

  .vhl-header{
    margin-bottom:36px;
  }

  .vhl-description{
    margin-top:16px;
    font-size:15px;
    line-height:1.65;
  }

  .vhl-grid{
    grid-template-columns:1fr;
    gap:20px;
  }

  .vhl-card__media{
    aspect-ratio:1 / 1;
  }

  .vhl-card__content{
    padding:16px 17px 17px;
  }

  .vhl-card__title{
    min-height:auto;
    font-size:17px;
  }

  .vhl-card__price-current{
    font-size:18px;
  }

  .vhl-btn{
    min-height:44px;
    font-size:11px;
  }
}

@media screen and (min-width:1600px){
  .vhl-featured-products .page-width{
    max-width:1560px;
  }
}
{% endstyle %}

<section class="vhl-featured-products" id="vhl-featured-products-{{ section.id }}">
  {% assign featured_collection = section.settings.collection %}

  <div class="page-width">
    <div class="vhl-header vhl-reveal">
      {% if section.settings.subtitle != blank %}
        <span class="vhl-subtitle">{{ section.settings.subtitle }}</span>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h2 class="vhl-title">{{ section.settings.heading }}</h2>
      {% endif %}

      {% if section.settings.description != blank %}
        <div class="vhl-description">{{ section.settings.description }}</div>
      {% endif %}
    </div>

    {% if featured_collection != blank and featured_collection.products_count > 0 %}
      <div class="vhl-grid">
        {% for product in featured_collection.products limit: section.settings.products_to_show %}
          <article class="vhl-card vhl-reveal{% unless product.available %} vhl-card--sold-out{% endunless %}">
            <div class="vhl-card__inner">
              <div class="vhl-card__media">
                <div class="vhl-card__badges">
                  {% if product.compare_at_price_max > product.price %}
                    <span class="vhl-card__badge vhl-card__badge--sale">
                      {{ section.settings.sale_badge_text | default: 'Sale' }}
                    </span>
                  {% endif %}

                  {% if product.tags contains 'Nieuw' or product.tags contains 'New' %}
                    <span class="vhl-card__badge vhl-card__badge--new">
                      {{ section.settings.new_badge_text | default: 'Nieuw' }}
                    </span>
                  {% endif %}
                </div>

                <a
                  href="{{ product.url }}"
                  class="vhl-card__media-link"
                  aria-label="{{ product.title | escape }}"
                >
                  {% if product.featured_image != blank %}
                    {{
                      product.featured_image
                      | image_url: width: 1200
                      | image_tag:
                        class: 'vhl-card__image vhl-card__image--primary',
                        loading: 'lazy',
                        widths: '360, 540, 720, 900, 1200',
                        sizes: '(min-width: 1200px) 50vw, (min-width: 750px) 50vw, 100vw',
                        alt: product.featured_image.alt
                    }}

                    {% if product.images.size > 1 %}
                      {% assign secondary_image = product.images[1] %}
                      {{
                        secondary_image
                        | image_url: width: 1200
                        | image_tag:
                          class: 'vhl-card__image vhl-card__image--secondary',
                          loading: 'lazy',
                          widths: '360, 540, 720, 900, 1200',
                          sizes: '(min-width: 1200px) 50vw, (min-width: 750px) 50vw, 100vw',
                          alt: secondary_image.alt
                      }}
                    {% endif %}
                  {% else %}
                    <div class="vhl-card__placeholder">
                      {{ 'product-1' | placeholder_svg_tag }}
                    </div>
                  {% endif %}
                </a>
              </div>

              <div class="vhl-card__content">
                {% if section.settings.show_vendor and product.vendor != blank %}
                  <span class="vhl-card__vendor">{{ product.vendor }}</span>
                {% endif %}

                <h3 class="vhl-card__title">
                  <a href="{{ product.url }}" class="vhl-card__title-link">
                    {{ product.title }}
                  </a>
                </h3>

                <div class="vhl-card__price">
                  {% if product.compare_at_price_max > product.price %}
                    <span class="vhl-card__price-current">{{ product.price | money }}</span>
                    <span class="vhl-card__price-compare">{{ product.compare_at_price_max | money }}</span>
                  {% else %}
                    <span class="vhl-card__price-current">{{ product.price | money }}</span>
                  {% endif %}
                </div>

                <div class="vhl-card__actions">
                  {% if product.available %}
                    {% if product.has_only_default_variant %}
                      {% form 'product',
                        product,
                        class: 'vhl-product-form',
                        data-product-form: '',
                        novalidate: 'novalidate'
                      %}
                        <input
                          type="hidden"
                          name="id"
                          value="{{ product.selected_or_first_available_variant.id }}"
                        >
                        <input type="hidden" name="quantity" value="1">

                        <button
                          type="submit"
                          name="add"
                          class="vhl-btn vhl-btn--primary"
                          data-add-to-cart
                        >
                          <span data-button-text>
                            {{ section.settings.quick_add_text | default: 'Toevoegen aan winkelwagen' }}
                          </span>
                        </button>
                      {% endform %}
                    {% else %}
                      <a href="{{ product.url }}" class="vhl-btn vhl-btn--primary">
                        {{ section.settings.choose_options_text | default: 'Kies opties' }}
                      </a>
                    {% endif %}
                  {% else %}
                    <button type="button" class="vhl-btn vhl-btn--secondary" disabled>
                      {{ section.settings.sold_out_text | default: 'Uitverkocht' }}
                    </button>
                  {% endif %}
                </div>
              </div>
            </div>
          </article>
        {% endfor %}
      </div>
    {% else %}
      <div class="vhl-empty vhl-reveal">
        <h3>{{ section.settings.empty_heading | default: 'Selecteer een collectie' }}</h3>
        <p>
          {{ section.settings.empty_text | default: 'Kies in de thema-editor welke producten je in deze sectie wilt tonen.' }}
        </p>
      </div>
    {% endif %}
  </div>
</section>

<script>
  (() => {
    const section = document.getElementById('vhl-featured-products-{{ section.id }}');

    if (!section || section.dataset.vhlInitialized === 'true') return;
    section.dataset.vhlInitialized = 'true';

    const revealElements = section.querySelectorAll('.vhl-reveal');

    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver(
        (entries, currentObserver) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;

            entry.target.classList.add('is-visible');
            currentObserver.unobserve(entry.target);
          });
        },
        {
          threshold: 0.12,
          rootMargin: '0px 0px -30px 0px'
        }
      );

      revealElements.forEach((element, index) => {
        element.style.transitionDelay = `${Math.min(index * 65, 260)}ms`;
        observer.observe(element);
      });
    } else {
      revealElements.forEach((element) => element.classList.add('is-visible'));
    }

    section.querySelectorAll('.vhl-product-form').forEach((form) => {
      form.addEventListener('submit', async (event) => {
        event.preventDefault();

        const button = form.querySelector('[data-add-to-cart]');
        const buttonText = form.querySelector('[data-button-text]');

        if (!button || button.disabled) return;

        const originalText = buttonText ? buttonText.textContent.trim() : '';

        button.disabled = true;
        button.setAttribute('aria-busy', 'true');

        if (buttonText) {
          buttonText.textContent = 'Toevoegen...';
        }

        try {
          const cartAddUrl = window.Shopify?.routes?.root
            ? `${window.Shopify.routes.root}cart/add.js`
            : '/cart/add.js';

          const response = await fetch(cartAddUrl, {
            method: 'POST',
            headers: {
              Accept: 'application/json'
            },
            body: new FormData(form)
          });

          const result = await response.json();

          if (!response.ok) {
            throw new Error(
              result.description ||
              result.message ||
              'Het product kon niet worden toegevoegd.'
            );
          }

          if (buttonText) {
            buttonText.textContent = 'Toegevoegd ✓';
          }

          document.dispatchEvent(
            new CustomEvent('vhl:cart-updated', {
              detail: {
                product: result,
                sectionId: '{{ section.id }}'
              }
            })
          );

          setTimeout(() => {
            if (buttonText) {
              buttonText.textContent = originalText;
            }

            button.disabled = false;
            button.removeAttribute('aria-busy');
          }, 1600);
        } catch (error) {
          console.error('VANHOUTEN LIVING Quick Add:', error);

          if (buttonText) {
            buttonText.textContent = 'Probeer opnieuw';
          }

          button.disabled = false;
          button.removeAttribute('aria-busy');

          setTimeout(() => {
            if (buttonText) {
              buttonText.textContent = originalText;
            }
          }, 2000);
        }
      });
    });
  })();
</script>

{% schema %}
