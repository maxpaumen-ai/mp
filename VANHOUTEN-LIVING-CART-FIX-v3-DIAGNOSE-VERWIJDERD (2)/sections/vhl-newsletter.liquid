<section id="VHLNewsletter-{{ section.id }}" class="vhl-newsletter">
  <div class="vhl-newsletter__inner">
    <div class="vhl-newsletter__content">
      {% if section.settings.eyebrow != blank %}<p class="vhl-newsletter__eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}
      {% if section.settings.heading != blank %}<h2 class="vhl-newsletter__heading">{{ section.settings.heading | escape }}</h2>{% endif %}
      {% if section.settings.text != blank %}<div class="vhl-newsletter__text rte">{{ section.settings.text }}</div>{% endif %}
    </div>
    {% form 'customer', class: 'vhl-newsletter__form' %}
      <input type="hidden" name="contact[tags]" value="newsletter">
      <div class="vhl-newsletter__field">
        <label class="visually-hidden" for="VHLNewsletterEmail-{{ section.id }}">E-mailadres</label>
        <input id="VHLNewsletterEmail-{{ section.id }}" type="email" name="contact[email]" value="{{ form.email }}" autocorrect="off" autocapitalize="off" autocomplete="email" placeholder="E-mailadres" required {% if form.errors %}aria-invalid="true" aria-describedby="VHLNewsletterError-{{ section.id }}"{% endif %}>
        <button type="submit" class="disable-global-button-styling">{{ section.settings.button_text | escape }} <span aria-hidden="true">→</span></button>
      </div>
      {% if form.errors %}<p id="VHLNewsletterError-{{ section.id }}" class="vhl-newsletter__message" role="alert">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>{% endif %}
      {% if form.posted_successfully? %}<p class="vhl-newsletter__message" role="status">{{ section.settings.success_text | escape }}</p>{% endif %}
    {% endform %}
  </div>
</section>
{% style %}
  #VHLNewsletter-{{ section.id }}{padding:{{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;background:{{ section.settings.background }};color:{{ section.settings.text_color }}}#VHLNewsletter-{{ section.id }} *{box-sizing:border-box}#VHLNewsletter-{{ section.id }} .vhl-newsletter__inner{display:grid;grid-template-columns:minmax(0,1fr) minmax(360px,.75fr);align-items:end;gap:clamp(40px,8vw,120px);width:min(100%,1384px);margin:auto;padding:0 clamp(18px,4vw,58px)}#VHLNewsletter-{{ section.id }} .vhl-newsletter__eyebrow{margin:0 0 12px;font-size:11px;font-weight:700;letter-spacing:.22em;text-transform:uppercase;opacity:.6}#VHLNewsletter-{{ section.id }} .vhl-newsletter__heading{max-width:720px;margin:0;color:{{ section.settings.text_color }}!important;font-family:var(--font-heading-family);font-size:clamp(38px,4.8vw,68px);font-weight:var(--font-heading-weight);line-height:1;letter-spacing:-.045em}#VHLNewsletter-{{ section.id }} .vhl-newsletter__text{max-width:580px;margin-top:20px;font-size:15px;line-height:1.7;opacity:.72}#VHLNewsletter-{{ section.id }} .vhl-newsletter__field{display:flex;border-bottom:1px solid currentColor}#VHLNewsletter-{{ section.id }} input{min-width:0;flex:1;padding:17px 2px;border:0;background:transparent;color:inherit;font:inherit;font-size:15px;outline-offset:4px}#VHLNewsletter-{{ section.id }} input::placeholder{color:inherit;opacity:.55}#VHLNewsletter-{{ section.id }} button{display:flex!important;align-items:center;gap:10px;padding:17px 2px 17px 20px!important;border:0!important;border-radius:0!important;background:#0000!important;color:inherit!important;box-shadow:none!important;font:inherit;font-size:12px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;cursor:pointer}#VHLNewsletter-{{ section.id }} button span{transition:transform 220ms ease}#VHLNewsletter-{{ section.id }} button:hover span{transform:translateX(4px)}#VHLNewsletter-{{ section.id }} .vhl-newsletter__message{margin:12px 0 0;font-size:13px}@media(max-width:749px){#VHLNewsletter-{{ section.id }}{padding:{{ section.settings.padding_top_mobile }}px 0 {{ section.settings.padding_bottom_mobile }}px}#VHLNewsletter-{{ section.id }} .vhl-newsletter__inner{grid-template-columns:minmax(0,1fr);gap:34px;padding-inline:16px}#VHLNewsletter-{{ section.id }} .vhl-newsletter__heading{font-size:clamp(34px,10vw,48px)}#VHLNewsletter-{{ section.id }} .vhl-newsletter__field{display:block;border:0}#VHLNewsletter-{{ section.id }} input{width:100%;border-bottom:1px solid currentColor}#VHLNewsletter-{{ section.id }} button{width:100%;justify-content:center;margin-top:12px;border:1px solid currentColor!important;border-radius:8px!important}}@media(prefers-reduced-motion:reduce){#VHLNewsletter-{{ section.id }} button span{transition:none}}
{% endstyle %}
{% schema %}
{"name":"VHL Newsletter","tag":"section","class":"section-vhl-newsletter","settings":[{"type":"text","id":"eyebrow","label":"Boventitel","default":"Blijf geïnspireerd"},{"type":"text","id":"heading","label":"Titel","default":"Rust, materiaal en nieuwe collecties in je inbox"},{"type":"richtext","id":"text","label":"Tekst","default":"<p>Ontvang inspiratie voor een verfijnde badkamer en blijf op de hoogte van nieuwe collecties.</p>"},{"type":"text","id":"button_text","label":"Knoptekst","default":"Aanmelden"},{"type":"text","id":"success_text","label":"Succesmelding","default":"Bedankt voor je inschrijving."},{"type":"color","id":"background","label":"Achtergrond","default":"#E8E0D5"},{"type":"color","id":"text_color","label":"Tekstkleur","default":"#24211E"},{"type":"range","id":"padding_top","label":"Bovenruimte desktop","min":30,"max":160,"step":5,"unit":"px","default":100},{"type":"range","id":"padding_bottom","label":"Onderruimte desktop","min":30,"max":160,"step":5,"unit":"px","default":100},{"type":"range","id":"padding_top_mobile","label":"Bovenruimte mobiel","min":20,"max":100,"step":5,"unit":"px","default":60},{"type":"range","id":"padding_bottom_mobile","label":"Onderruimte mobiel","min":20,"max":100,"step":5,"unit":"px","default":60}],"presets":[{"name":"VHL Newsletter"}]}
{% endschema %}
