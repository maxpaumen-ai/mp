<section id="VHLReviews-{{ section.id }}" class="vhl-reviews">
  <div class="vhl-reviews__inner">
    <header class="vhl-reviews__header">
      <div>{% if section.settings.eyebrow != blank %}<p>{{ section.settings.eyebrow | escape }}</p>{% endif %}{% if section.settings.heading != blank %}<h2>{{ section.settings.heading | escape }}</h2>{% endif %}</div>
      {% if section.settings.placeholder_notice != blank %}<p class="vhl-reviews__notice">{{ section.settings.placeholder_notice | escape }}</p>{% endif %}
    </header>
    <div class="vhl-reviews__track" tabindex="0" aria-label="Voorbeeldreviews">
      {% for block in section.blocks %}
        <article class="vhl-review" {{ block.shopify_attributes }}>
          <span class="vhl-review__marker">Voorbeeld — niet publiceren</span>
          <blockquote>{{ block.settings.quote | escape }}</blockquote>
          <p class="vhl-review__author">{{ block.settings.author | escape }}</p>
        </article>
      {% endfor %}
    </div>
  </div>
</section>
{% style %}
  #VHLReviews-{{ section.id }}{overflow:hidden;padding:{{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;background:#171614;color:#fff}#VHLReviews-{{ section.id }} *{box-sizing:border-box}#VHLReviews-{{ section.id }} .vhl-reviews__inner{width:min(100%,1500px);margin:auto;padding:0 clamp(18px,4vw,58px)}#VHLReviews-{{ section.id }} .vhl-reviews__header{display:flex;align-items:end;justify-content:space-between;gap:30px;margin-bottom:42px}#VHLReviews-{{ section.id }} .vhl-reviews__header>div>p{margin:0 0 12px;font-size:11px;font-weight:700;letter-spacing:.22em;text-transform:uppercase;opacity:.6}#VHLReviews-{{ section.id }} .vhl-reviews__header h2{margin:0;color:#fff!important;font-family:var(--font-heading-family);font-size:clamp(36px,4.6vw,64px);font-weight:var(--font-heading-weight);line-height:1;letter-spacing:-.04em}#VHLReviews-{{ section.id }} .vhl-reviews__notice{max-width:380px;margin:0;padding:12px 15px;border:1px solid rgba(255,255,255,.25);border-radius:10px;color:#fff;font-size:12px;line-height:1.5;opacity:.75}#VHLReviews-{{ section.id }} .vhl-reviews__track{display:grid;grid-auto-flow:column;grid-auto-columns:minmax(300px,1fr);gap:18px;overflow-x:auto;scroll-snap-type:x mandatory;scrollbar-width:none}#VHLReviews-{{ section.id }} .vhl-reviews__track::-webkit-scrollbar{display:none}#VHLReviews-{{ section.id }} .vhl-review{min-height:310px;padding:34px;border:1px solid rgba(255,255,255,.14);border-radius:22px;background:rgba(255,255,255,.055);scroll-snap-align:start}#VHLReviews-{{ section.id }} .vhl-review__marker{display:inline-block;margin-bottom:36px;color:#e8e0d5;font-size:9px;font-weight:700;letter-spacing:.13em;text-transform:uppercase}#VHLReviews-{{ section.id }} blockquote{margin:0;color:#fff;font-family:var(--font-heading-family);font-size:clamp(22px,2vw,29px);font-style:normal;line-height:1.35;letter-spacing:-.02em}#VHLReviews-{{ section.id }} .vhl-review__author{margin:26px 0 0;font-size:13px;opacity:.62}@media(max-width:749px){#VHLReviews-{{ section.id }}{padding:{{ section.settings.padding_top_mobile }}px 0 {{ section.settings.padding_bottom_mobile }}px}#VHLReviews-{{ section.id }} .vhl-reviews__inner{padding-inline:16px}#VHLReviews-{{ section.id }} .vhl-reviews__header{display:block;margin-bottom:28px}#VHLReviews-{{ section.id }} .vhl-reviews__notice{margin-top:18px}#VHLReviews-{{ section.id }} .vhl-reviews__track{grid-auto-columns:86vw;gap:14px}#VHLReviews-{{ section.id }} .vhl-review{min-height:280px;padding:28px}}
{% endstyle %}
{% schema %}
{"name":"VHL Reviews","tag":"section","class":"section-vhl-reviews","max_blocks":8,"settings":[{"type":"text","id":"eyebrow","label":"Boventitel","default":"Ervaringen"},{"type":"text","id":"heading","label":"Titel","default":"Wat klanten straks vertellen"},{"type":"text","id":"placeholder_notice","label":"Interne placeholdermelding","default":"LET OP: vervang alle voorbeeldreviews door geverifieerde echte klantreviews vóór publicatie."},{"type":"range","id":"padding_top","label":"Bovenruimte desktop","min":30,"max":160,"step":5,"unit":"px","default":100},{"type":"range","id":"padding_bottom","label":"Onderruimte desktop","min":30,"max":160,"step":5,"unit":"px","default":100},{"type":"range","id":"padding_top_mobile","label":"Bovenruimte mobiel","min":20,"max":100,"step":5,"unit":"px","default":60},{"type":"range","id":"padding_bottom_mobile","label":"Onderruimte mobiel","min":20,"max":100,"step":5,"unit":"px","default":60}],"blocks":[{"type":"review","name":"Voorbeeldreview","settings":[{"type":"textarea","id":"quote","label":"Voorbeeldtekst","default":"Voorbeeldreview. Vervang deze tekst vóór publicatie door een geverifieerde ervaring van een echte klant."},{"type":"text","id":"author","label":"Voorbeeldauteur","default":"Voorbeeldklant"}]}],"presets":[{"name":"VHL Reviews — placeholders","blocks":[{"type":"review"},{"type":"review"},{"type":"review"}]}]}
{% endschema %}
