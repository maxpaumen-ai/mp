{
  "sections": {
    "breadcrumb_vacuum_hook": {
      "type": "breadcrumb",
      "name": "Breadcrumb",
      "settings": {
        "use_theme_colors": true,
        "padding_top": 12,
        "padding_bottom": 12,
        "home_text": "Home",
        "show_collection_in_breadcrumb": true,
        "separator": "/",
        "font_size": 13
      }
    },
    "vhl_vacuum_main": {
      "type": "vhl-vacuum-product-main",
      "name": "VHL Vacuumhaak PDP",
      "blocks": {
        "title_main": {
          "type": "title",
          "settings": {
            "font_size": 28,
            "margin_top": 0,
            "margin_bottom": 8,
            "title_color": "#1a1a1a",
            "line_height": 1.2
          }
        },
        "price_main": {
          "type": "price",
          "settings": {
            "multiply_price_by_quantity": true,
            "apply_selected_subscription_discount": true,
            "price_color": "#1a1a1a",
            "compare_price_color": "#9c9c9c",
            "sale_badge_bg_color": "#262625",
            "sale_badge_text_color": "#ffffff",
            "show_save_badge": true,
            "price_font_size": 26,
            "compare_price_font_size": 16,
            "save_badge_font_size": 12,
            "price_font_weight": "600",
            "show_save_icon": false,
            "save_icon_size_ratio": 0.9,
            "save_icon_position_y": 0,
            "save_badge_padding_v": 4,
            "save_badge_padding_h": 8,
            "save_badge_display_type": "percentage",
            "price_margin_top": 6,
            "price_margin_bottom": 0
          }
        },
        "usps_main": {
          "type": "bullet_list",
          "settings": {
            "use_theme_colors": false,
            "bullet_1": "",
            "bullet_2": "",
            "bullet_3": "",
            "layout_style": "vertical",
            "icon_color": "#262625",
            "text_color": "#1a1a1a",
            "icon_size": 16,
            "text_size": 14,
            "spacing": 10,
            "icon_text_gap": 10,
            "margin_top": 15,
            "margin_bottom": 0
          }
        },
        "variant_picker_main": {
          "type": "simple_variant_picker",
          "settings": {
            "first_variant_auto_selected": true,
            "use_dropdown": false,
            "enable_color_swatches": true,
            "enable_size_preset": true,
            "show_labels": true,
            "label_color": "#1a1a1a",
            "label_size": 13,
            "option_bg_color": "#ffffff",
            "option_border_color": "#e5e0d8",
            "option_text_color": "#1a1a1a",
            "option_size": 14,
            "option_border_radius": 8,
            "option_padding_vertical": 10,
            "option_padding_horizontal": 18,
            "option_font_size": 14,
            "selected_bg_color": "#262625",
            "selected_text_color": "#ffffff",
            "selected_border_color": "#262625",
            "swatch_size": 30,
            "swatch_bg_color": "#f5f3ef",
            "outline_color": "#e5e0d8",
            "grid_gap": 10,
            "container_margin_left": 0,
            "container_margin_right": 0
          }
        },
        "quantity_main": {
          "type": "quantity_selector",
          "settings": {
            "background_color": "#f5f3ef",
            "button_color": "#ffffff",
            "text_color": "#1a1a1a",
            "margin_top": 0,
            "margin_bottom": 16
          }
        },
        "add_to_cart_main": {
          "type": "add_to_cart",
          "settings": {
            "use_theme_colors": false,
            "use_global_button_styling": false,
            "show_fast_payment": false,
            "button_behavior": "add_to_cart",
            "button_text_override": "",
            "show_price_in_button": false,
            "multiply_values_by_quantity": true,
            "apply_selected_subscription_discount": true,
            "button_icon": "none",
            "icon_size": 20,
            "button_border_color": "#262625",
            "buy_box_button_bg_color": "#262625",
            "button_text_color": "#ffffff",
            "buy_box_button_hover_color": "#1a1a1a",
            "price_color": "#ffffff",
            "custom_button_padding_y": 16,
            "custom_button_font_size": 15,
            "button_border_radius": 8
          }
        }
      },
      "block_order": [
        "title_main",
        "price_main",
        "usps_main",
        "variant_picker_main",
        "quantity_main",
        "add_to_cart_main"
      ]
    }
  },
  "order": [
    "breadcrumb_vacuum_hook",
    "vhl_vacuum_main"
  ]
}
