    "vl_faq": {
      "type": "vhl-landing-faq",
      "blocks": {
        "f1": {
          "type": "faq",
          "settings": {
            "question": "Hoe werkt de zuignap werking?",
            "answer": "<p>De haak kan worden bevestigd zonder te boren of lijmen. Dankzij de zuignaptechniek wordt de lucht vacuüm gezogen, waardoor de haak stevig op zijn plaats blijft zitten. De haak heeft een draagkracht tot <strong>5 kg</strong>.</p>"
          }
        },
        "f2": {
          "type": "faq",
          "settings": {
            "question": "Op welke oppervlakken kan ik het gebruiken?",
            "answer": "<p>De haak is geschikt voor gladde, niet-poreuze oppervlakken zoals tegels, glas, spiegels, metaal en glad kunststof. Voor het beste resultaat moet het oppervlak schoon, droog en vetvrij zijn.</p><p>Niet geschikt voor ruwe, poreuze of oneffen oppervlakken zoals stucwerk, hout, beton of behang.</p>"
          }
        },
        "f3": {
          "type": "faq",
          "settings": {
            "question": "Hoe bevestig ik de ophanghaak?",
            "answer": "<p>Maak het oppervlak eerst schoon, droog en vetvrij. Plaats de haak op het gewenste oppervlak en druk deze stevig aan. Draai vervolgens de schroef vast, zodat de lucht onder de haak vacuüm wordt gezogen.</p><p>Controleer tot slot of de haak goed vastzit voordat je er iets aan ophangt.</p>"
          }
        },
        "f4": {
          "type": "faq",
          "settings": {
            "question": "Hoe lang heb ik garantie op mijn aankoop?",
            "answer": "<p>Wij bieden 1 jaar fabrieksgarantie.</p>"
          }
        }
      },
